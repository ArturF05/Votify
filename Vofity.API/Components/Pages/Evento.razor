@page "/Evento"
<h3>Eventos</h3>

<PageTitle>Evento</PageTitle>
<h1 class="titulo">Hola</h1>
<div>
    <input type="text" placeholder="Buscar eventos..." />
    <select>
        <option>Hackaton</option>
        <option>Futbolín</option>
    </select>
    <button @onclick='() => BuscarEventos()'>Buscar</button>
</div>

<!-- ESTO CAMBIA. QUE SEA VARIABLE PARA LOS EVENTOS QUE HAYA -->
<div>
    <table>
        <thead>
            <tr>
                <th>Evento</th>
                <th>Categoría</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Editar</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Pequeños Informáticos</td>
                <td>Hackaton</td>
                <td>13/12/2006</td>
                <td>14/12/2006</td>
                <td><button class="editarBtn" @onclick='() => EditarEvento()'>Editar</button></td>
            </tr>
            <tr>
                <td>Torneo de futbolín</td>
                <td>Futbolín</td>
                <td>13/02/2006</td>
                <td>14/02/2006</td>
                <td><button class="editarBtn" @onclick='() => EditarEvento()'>Editar</button></td>
            </tr>
        </tbody>
    </table>
</div>

<!-- AL EDITAR SE AUTOCOMPLETA -->
<div class="card">
    <h3>Crear o editar evento</h3>
    <hr>
    <div class="form-row">
        <label>Título:</label>
        <input type="text" placeholder="Título del evento..." />
    </div>
    <br>
    <div class="form-row">
        <div>
            <label>Categoría:</label>
            <select>
                <option>Hackaton</option>
                <option>Futbolín</option>
            </select>
        </div>
        <div>
            <label>Fecha de inicio:</label>
            <input type="date" @bind="fechaAct" />
        </div>
    </div>
    <br>
    <div>
        <div>
            <label>Descripción:</label>
            <textarea placeholder="Descripción..." />
        </div>
        <div>
            <label>Fecha de cierre:</label>
            <input type="date" @bind="fechaMañana" />
        </div>
    </div>
    <br>
    <div>
        <div>
            <button @onclick='() => EliminarEvento()'>Eliminar</button>
        </div>
        <div>
            <button @onclick='() => ArchivarEvento()'>Archivar</button>
            <button @onclick='() => CrearEvento()'>Crear Evento</button>
        </div>
    </div>
</div>

