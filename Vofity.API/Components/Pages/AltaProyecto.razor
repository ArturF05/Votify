@page "/AltaProyecto"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.EntityFrameworkCore
@using Votify.Core.DTOs
@using System.Net.Http.Json
@using Votify.Infrastructure.Data
@inject HttpClient Http
@inject AppDbContext contexto;
@inject NavigationManager nav;
@inject ProtectedSessionStorage sessionStorage;


<PageTitle>Crear Proyecto - Votify </PageTitle>
<div class="crear-proyecto-container">
    <div class="crear-proyecto-card">
        <div class="icono-proyecto">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
        </div>

        <h2 class="crear-proyecto-titulo">Crear Proyecto</h2>
        <p class="crear-proyecto-subtitulo">Completa los datos para iniciar tu nuevo proyecto</p>

        <EditForm Model="modelo" OnValidSubmit="CrearProyecto">
            <DataAnnotationsValidator />

            <div class="campo-grupo">
                <label for="evento" class="campo-label">Evento asociado</label>
                <div class="campo-wrapper">
                    <select id="evento"
                            value="@modelo.IdEvento"
                            @onchange="EventoSeleccionado"
                            class="campo-input">
                        <option value="">-- Selecciona un evento --</option>
                        @foreach (var evento in eventos)
                        {
                            <option value="@evento.Id">@evento.Nombre</option>
                        }
                    </select>
                    <span class="campo-linea"></span>
                </div>
                <ValidationMessage For="@(() => modelo.IdEvento)" />
            </div>

            <div class="campo-grupo">
                <label for="categoriaEvento" class="campo-label">Categoría de participación</label>
                <div class="campo-wrapper">
                    <InputSelect id="categoriaEvento"
                                 @bind-Value="modelo.IdCategoriaEvento"
                                 class="campo-input"
                                 disabled="@(modelo.IdEvento == null || !categoriasEvento.Any())">
                        <option value="">-- Selecciona una categoría --</option>
                        @foreach (var categoria in categoriasEvento)
                        {
                            <option value="@categoria.Id">@categoria.Nombre</option>
                        }
                    </InputSelect>
                    <span class="campo-linea"></span>
                </div>
            </div>

            <div class="campo-grupo">
                <label for="titulo" class="campo-label">Título del Proyecto</label>
                <div class="campo-wrapper">
                    <input id="titulo"
                           maxlength="50"
                           value="@modelo.Titulo"
                           @oninput='e => modelo.Titulo = e.Value?.ToString()?.Length > 50 ? e.Value.ToString()[..50] : e.Value?.ToString() ?? ""'
                           class="campo-input"
                           placeholder="Ej: Mi nuevo proyecto" />
                    <span class="campo-linea"></span>
                </div>
                <span class="contador">@(modelo.Titulo?.Length ?? 0) / 50</span>
                <ValidationMessage For="@(() => modelo.Titulo)" />
            </div>

            <div class="campo-grupo">
                <label for="descripcion" class="campo-label">Descripción</label>
                <div class="campo-wrapper">
                    <textarea id="descripcion"
                              maxlength="500"
                              rows="4"
                              class="campo-textarea"
                              placeholder="Describe brevemente tu proyecto..."
                              @oninput='e => modelo.Descripcion = e.Value?.ToString()?.Length > 500 ? e.Value.ToString()[..500] : e.Value?.ToString() ?? ""'>@modelo.Descripcion</textarea>
                    <span class="campo-linea"></span>
                </div>
                <span class="contador">@(modelo.Descripcion?.Length ?? 0) / 500</span>
                <ValidationMessage For="@(() => modelo.Descripcion)" />
            </div>

            <button type="submit" class="btn-crear" disabled="@cargando">
                @if (cargando)
                {
                    <span>Creando...</span>
                }
                else
                {
                    <span>Crear Proyecto</span>
                }
            </button>
        </EditForm>
        
        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="alerta @(creado ? "alerta-exito" : "alerta-error")">
                <svg class="alerta-icono" fill="currentColor" viewBox="0 0 20 20">
                    @if (creado)
                    {
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    }
                    else
                    {
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                    }
                </svg>
                <span>@mensaje</span>
            </div>
        }
        

        <p>Eventos en los que participas cargados: @eventos.Count</p>
    </div>
</div>

@code {
    List<Votify.Core.Entities.Evento> eventos = new();
    List<Votify.Core.Entities.CategoriaEvento> categoriasEvento = new();
    List<Votify.Core.Entities.Proyecto> proyectos = new();
    private CrearProyectoDto modelo = new();
    private string mensaje = "";
    private bool creado = false;
    private bool cargando = false;
    private Guid idUsuario;


    protected override async Task OnInitializedAsync()
    {
        await CargarEventosAsync();
    }

    private async Task CargarEventosAsync()
    {
        ProtectedBrowserStorageResult<Guid> resultado;
        try
        {
            resultado = await sessionStorage.GetAsync<Guid>("IdUsuario");
            if (!resultado.Success || resultado.Value == Guid.Empty)
            {
                nav.NavigateTo("/Login");
                return;
            }
        }
        catch (Exception e)
        {
            nav.NavigateTo("/Login");
            return;
        }


        idUsuario = resultado.Value;

        eventos = await contexto.Evento
            .AsNoTracking()
            .Include(e => e.Categoria)
            .Where(e => contexto.EventoUsuarioRol
                .Include(eur => eur.Rol)
                .Any(eur => eur.EventoId == e.Id
                         && eur.UsuarioId == idUsuario
                         && eur.Rol.Nombre != "Organizador"))
            .ToListAsync();
        proyectos = await contexto.Proyecto.AsNoTracking().ToListAsync();

    }

    private async Task CrearProyecto()
    {
        cargando = true;
        mensaje = "";

        try
        {
            if (modelo.IdCategoriaEvento == null || modelo.IdCategoriaEvento == Guid.Empty)
            {
                mensaje = "Debes seleccionar una categoría para el proyecto";
                creado = false;
                return;
            }
            if (proyectos.Where(p => p.Id_evento == modelo.IdEvento && p.Id_creador == idUsuario && p.Id_categoria_evento == modelo.IdCategoriaEvento).Any())
            {
                mensaje = "Ya has creado un proyecto para este evento en la categoría seleccionada";
                creado = false;
                return;
            }

            var response = await Http.PostAsJsonAsync("api/v1/proyecto", new
            {
                titulo = modelo.Titulo,
                descripcion = modelo.Descripcion ?? "",
                idEvento = modelo.IdEvento,
                idCategoriaEvento = modelo.IdCategoriaEvento,
                Id_Creador = idUsuario
            });

            if (response.IsSuccessStatusCode)
            {
                mensaje = "Proyecto creado exitosamente";
                creado = true;
                modelo = new CrearProyectoDto();
                categoriasEvento.Clear();
                nav.NavigateTo("/MisProyectos");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensaje = $"Error al crear proyecto: {error}";
                creado = false;
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error de conexión: " + ex.Message;
            creado = false;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task EventoSeleccionado(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var idEvento))
        {
            modelo.IdEvento = idEvento;
            modelo.IdCategoriaEvento = null;
            categoriasEvento = await contexto.CategoriaEvento
                .AsNoTracking()
                .Where(c => c.Id_evento == idEvento)
                .OrderBy(c => c.Nombre)
                .ToListAsync();
        }
        else
        {
            modelo.IdEvento = null;
            modelo.IdCategoriaEvento = null;
            categoriasEvento.Clear();
        }
    }

    public class EventoDto
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }
}
