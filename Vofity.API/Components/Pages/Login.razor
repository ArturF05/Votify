@page "/"
@page "/Login"
@rendermode InteractiveServer
@using Vofity.API.Components.Layout
@using Votify.Core.Interfaces
@inject ILogin LoginWindow
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations;
@layout NoLayout


<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="logo-container">
                <img src="/Images/Logo.png" alt="Votify Logo" class="logo-img" />
            </div>
            
            <p class="login-subtitle">Tu voz, tu voto, tu decisión</p>
        </div>

        <EditForm Model="@modelo" OnValidSubmit="LoginUsuario" FormName="loginForm" class="login-form">
            <DataAnnotationsValidator />
            <ValidationSummary />


            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert @(loginExitoso ? "alert-success" : "alert-error")">
                    <img src="/Images/Alerta-Icono.png" alt="Alerta" class="Alerta-img" />
                    <span>@mensaje</span>
                </div>
            }

            <div class="form-group">
                <label for="usuario">Usuario</label>
                <InputText id="usuario" @bind-Value="modelo.Usuario" placeholder="Ingresa tu usuario" class="form-input" />
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <InputText id="password" type="password" @bind-Value="modelo.Password" placeholder="Ingresa tu contraseña" class="form-input" />
            </div>

            <button type="submit" class="btn-primary" disabled="@isLoading">
                @if (isLoading)
                {
                    
                    <span class="spinner"></span>
                    <span>Verificando...</span>
                }
                else
                {
                    <span>Entrar</span>
                }
            </button>

            <p class="register-link">
                ¿No tienes cuenta? <a href="/Register">Regístrate aquí</a>
            </p>
        </EditForm>
    </div>
</div>

@code {
    private LoginModel modelo = new();
    private string mensaje = "";
    private bool loginExitoso = false;
    private bool isLoading = false;

    private async Task LoginUsuario()
    {
        if (isLoading) return;

        try
        {
            isLoading = true;
            mensaje = "";
            StateHasChanged();

            // Llamada directa sin Task.Run
            bool resultado = await LoginWindow.ValidarUsuarioAsync(modelo.Usuario, modelo.Password);

            if (resultado)
            {
                mensaje = "¡Login correcto!";
                loginExitoso = true;
                StateHasChanged(); // Forzar actualización antes del delay
                await Task.Delay(1500);
                Navigation.NavigateTo("/Main");
            }
            else
            {
                mensaje = "Usuario o contraseña incorrectos";
                loginExitoso = false;
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error de conexión: " + ex.Message;
            loginExitoso = false;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "El usuario es obligatorio")]
        public string Usuario { get; set; } = "";
        [Required(ErrorMessage = "La contraseña es obligatoria")]
        public string Password { get; set; } = "";
    }
}