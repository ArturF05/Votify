@page "/VerResultados"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using System.Net.Http.Json
@using Votify.Core.Entities
@using Votify.Core.Interfaces
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject NavigationManager nav
@inject AppDbContext contexto
@inject HttpClient Http
@inject IEvento eventoService
@inject ProtectedSessionStorage sessionStorage
@rendermode InteractiveServer

<div class="titulo-y-finalizadas">
    <h2 class="titulo">Resultados de votaciones</h2>
</div>

<PageTitle>Resultados de votaciones</PageTitle>

<div class="barra-busqueda">
    <label style="vertical-align:text-bottom">Evento: </label>
    <select @bind="Id_evento" @bind:event="oninput" @onchange="BuscarVotaciones">
        <option value="@Guid.Empty">Todos</option>
        @foreach (var evento in eventos.Where(e => e.Archivado == false))
        {
            <option value="@evento.Id">@evento.Nombre</option>
        }
    </select>

    <label style="vertical-align:text-bottom">Tipo de votación: </label>
    <select @bind="tipoVotacion" @bind:event="oninput" @onchange="BuscarVotaciones">
        <option value="-1">Todos</option>
        <option value="0">Público</option>
        <option value="1">Jurado</option>
        <option value="2">Mixta</option>
    </select>

    <label style="vertical-align:text-bottom">Permite AutoVoto: </label>
    <select @bind="permiteAutoVoto" @bind:event="oninput" @onchange="BuscarVotaciones">
        <option value="-1">Ambos</option>
        <option value="1">Sí</option>
        <option value="0">No</option>
    </select>
</div>

<div>
    <table class="tabla-votaciones">
        <thead>
            <tr>
                <th>Evento</th>
                <th>Tipo de votación</th>
                <th>Permite autovoto</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Resultados del evento</th>
            </tr>
        </thead>

        <tbody>
            @if (!cargado)
            {
                <tr>
                    <td colspan="6">
                        <div class="loading-box">
                            <div class="spinner"></div>
                            <p>Cargando resultados...</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var vot in votaciones.Where(vot =>
                            vot.EstadoVotacion == EstadoVotacion.Abierta ||
                            vot.EstadoVotacion == EstadoVotacion.Pausada ||
                            vot.EstadoVotacion == EstadoVotacion.Finalizada))
                {
                    <tr>
                        <td>@eventos.FirstOrDefault(e => e.Id == vot.Id_evento)?.Nombre</td>
                        <td>@ObtenerTipoVotacion(vot)</td>
                        <td>@vot.PermiteAutoVoto</td>
                        <td>@vot.FechaInicio.ToLocalTime()</td>
                        <td>@vot.FechaFin.ToLocalTime()</td>

                        <td>
                            <div class="tooltip-wrapper">
                                <button class="boton-editar"
                                        @onclick='() => VerDashboard(vot)'
                                        disabled="@(!PuedeVerResultados(vot))">
                                    Resultados
                                </button>

                                @if (!PuedeVerResultados(vot))
                                {
                                    <span class="tooltip-text">@ObtenerMotivoBloqueo(vot)</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <label class="noHayResult">@noHayResultados</label>
</div>

@code {
    List<Votify.Core.Entities.Evento> eventos = new();
    List<Votify.Core.Entities.Votacion> votaciones = new();
    List<Votify.Core.Entities.Votacion> votacionesActuales = new();

    private Guid Id_evento = Guid.Empty;
    private int tipoVotacion = -1;
    private int permiteAutoVoto = -1;
    private string noHayResultados = "";
    private Guid idUsuario;
    private bool cargado = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || cargado)
            return;

        var resultado = await sessionStorage.GetAsync<Guid>("IdUsuario");

        if (!resultado.Success || resultado.Value == Guid.Empty)
        {
            nav.NavigateTo("/Login");
            return;
        }

        idUsuario = resultado.Value;

        await ActualizarEstadosVotaciones();
        eventos = await contexto.Evento.AsNoTracking().Include(e => e.Categoria).Include(e => e.Proyectos).ToListAsync();

        votaciones = await contexto.Votacion
            .Where(v => contexto.EventoUsuarioRol
                .Any(eur =>
                    eur.EventoId == v.Id_evento &&
                    eur.UsuarioId == idUsuario &&
                    eur.Rol.Nombre == "Organizador"))
            .ToListAsync();

        await BuscarVotaciones();

        cargado = true;
        StateHasChanged();
    }

    private async Task ActualizarEstadosVotaciones()
    {
        var ahora = DateTime.UtcNow;

        var listaVotaciones = await contexto.Votacion.ToListAsync();

        foreach (var votacion in listaVotaciones)
        {
            if (votacion.EstadoVotacion == EstadoVotacion.Cerrada &&
                votacion.FechaInicio <= ahora)
            {
                votacion.EstadoVotacion = EstadoVotacion.Abierta;
            }
        }

        await contexto.SaveChangesAsync();
    }

    private async Task BuscarVotaciones()
    {
        noHayResultados = "";

        var query = contexto.Votacion
            .Where(v => contexto.EventoUsuarioRol
                .Include(eur => eur.Rol)
                .Any(eur =>
                    eur.EventoId == v.Id_evento &&
                    eur.UsuarioId == idUsuario &&
                    (
                        eur.Rol.Nombre == "Organizador" ||
                        eur.Rol.Nombre == "Participante"
                    )))
            .AsQueryable();

        if (Id_evento != Guid.Empty)
        {
            query = query.Where(v => v.Id_evento == Id_evento);
        }

        if (tipoVotacion != -1)
        {
            if (tipoVotacion == 0)
                query = query.Where(v => v is VotacionPublico);

            if (tipoVotacion == 1)
                query = query.Where(v => v is VotacionJurado);

            if (tipoVotacion == 2)
                query = query.Where(v => v is VotacionMixta);
        }

        if (permiteAutoVoto != -1)
        {
            bool permite = permiteAutoVoto == 1;
            query = query.Where(v => v.PermiteAutoVoto == permite);
        }

        votaciones = await query.ToListAsync();

        HayVotaciones();

        StateHasChanged();
    }

    private bool PuedeVerResultados(Votify.Core.Entities.Votacion votacion)
    {
        return ObtenerMotivoBloqueo(votacion) == null;
    }

    private string? ObtenerMotivoBloqueo(Votify.Core.Entities.Votacion votacion)
    {
        var evento = eventos.FirstOrDefault(e => e.Id == votacion.Id_evento);

        if (evento == null)
            return "El evento no existe";

        if (evento.Proyectos == null || evento.Proyectos.Count == 0)
            return "No se han presentado proyectos para este evento";

        if (votacion.EstadoVotacion == EstadoVotacion.Finalizada)
            return null;

        if (votacion.EstadoVotacion == EstadoVotacion.Abierta ||
            votacion.EstadoVotacion == EstadoVotacion.Pausada)
        {
            if (!votacion.VerRes)
                return "Los resultados no están disponibles mientras la votación no haya finalizado";
        }

        return null;
    }

    private void VerDashboard(Votify.Core.Entities.Votacion vot)
    {
        nav.NavigateTo($"/Dashboard/{vot.Id_evento}");
    }

    private void HayVotaciones()
    {
        votacionesActuales = votaciones.Where(vot =>
            vot.EstadoVotacion == EstadoVotacion.Abierta ||
            vot.EstadoVotacion == EstadoVotacion.Pausada ||
            vot.EstadoVotacion == EstadoVotacion.Finalizada
        ).ToList();

        noHayResultados = votacionesActuales.Count == 0
            ? "No hay votaciones con resultados disponibles"
            : "";
    }

    private string ObtenerTipoVotacion(Votify.Core.Entities.Votacion vot)
    {
        if (vot is VotacionPublico) return "Público";
        if (vot is VotacionJurado) return "Jurado";
        if (vot is VotacionMixta) return "Mixta";
        return "Desconocido";
    }
}