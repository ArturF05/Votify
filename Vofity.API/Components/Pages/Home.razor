@page "/Home"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Votify.Infrastructure.Data
@using Votify.Core.Entities
@inject AppDbContext contexto
@inject HttpClient Http
@inject ProtectedSessionStorage sessionStorage
@inject NavigationManager nav
<PageTitle>Home - Votify </PageTitle>
<div class="page">

    <div class="header">
        @if (usuarioActual == null)
        {
            <h1>Home</h1>
        }
        else{
            <h1>Hola <span>@usuarioActual.Nombre</span> 👋</h1>
        }
        <p>Consulta los eventos en los que participas y apúntate a nuevos</p>
    </div>

    <div class="section">
        <h2>Eventos en los que participas</h2>
        <div class="participando-list">
            @foreach (var evento in eventosParticipando)
            {
                <div class="item">
                    <div class="item-left">
                        @if (!string.IsNullOrEmpty(evento.ImagenUrl))
                        {
                            <img src="@GetProxyUrl(evento.ImagenUrl)" class="item-img" />
                        }

                        <div class="item-info">
                            <span class="item-title">@evento.Nombre</span>

                            <span class="item-date">
                                📅 @evento.FechaInicio.ToString("dd/MM/yyyy") - @evento.FechaFin.ToString("dd/MM/yyyy")
                            </span>
                        </div>
                    </div>

                    <span class="estado-evento estado-curso">En curso</span>

                    <div class="item-actions">
                        <div class="card-actions">
                            <button class="boton-secundario" @onclick='() => VerInfo(evento.Id)'>Ver Información</button>
                            <button class="btn" @onclick='() => Apuntarse(evento.Id)'>Apuntarme</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="section">
        <h2>Eventos a los que puedes unirte</h2>

        <div class="grid">
            @foreach (var evento in eventosDisponibles)
            {
                <div class="card">

                    @if (!string.IsNullOrEmpty(evento.ImagenUrl))
                    {
                        <img src="@GetProxyUrl(evento.ImagenUrl)" class="card-img" />
                    }

                    <div class="card-content">

                        <div class="card-title">
                            @evento.Nombre
                        </div>

                        <div class="card-dates">
                            <div>Inicio: @evento.FechaInicio</div>
                            <div>Fin: @evento.FechaFin</div>
                        </div>

                        <div class="card-actions">
                            <button class="boton-secundario"
                                    @onclick='() => VerInfo(evento.Id)'>
                                Ver Información
                            </button>

                            <button class="btn"
                                    @onclick='() => Apuntarse(evento.Id)'>
                                Apuntarme
                            </button>
                        </div>

                    </div>

                </div>
            }
        </div>
    </div>
    <div>
        <label>@mensaje</label>
    </div>
</div>

@code {
    List<Votify.Core.Entities.Evento> eventos = new();
    List<Votify.Core.Entities.Evento> eventosParticipando = new();
    List<Votify.Core.Entities.Evento> eventosDisponibles = new();

    private string debugInfo = "";
    private string mensaje = "";
    private Guid idUsuario;
    private Votify.Core.Entities.Usuario? usuarioActual;
    private string GetProxyUrl(string url)=> $"/api/miniaturas/from-url?url={Uri.EscapeDataString(url)}";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ActualizarEstadosVotaciones();
        try
        {
            ProtectedBrowserStorageResult <Guid> resultado;
            try
            {
                resultado = await sessionStorage.GetAsync<Guid>("IdUsuario");
            }
            catch (Exception e)
            {
                nav.NavigateTo("/Login");
                return;
            }

            bool resSuccess = !resultado.Success;
            bool resIsEmpty = resultado.Value == Guid.Empty;
            if (resSuccess || resIsEmpty)
            {
                nav.NavigateTo("/Login");
                return;
            }

            idUsuario = resultado.Value;

            usuarioActual = await contexto.Usuario
                .Include(u => u.Rol)
                .FirstOrDefaultAsync(u => u.Id == idUsuario);

            if (usuarioActual == null)
            {
                nav.NavigateTo("/Login");
                return;
            }

            eventos = await contexto.Evento
                .AsNoTracking()
                .Include(e => e.Categoria)
                .ToListAsync();

            eventosParticipando = eventos
                .Where(e => contexto.EventoUsuarioRol
                    .Include(eur => eur.Rol)
                    .Any(eur => eur.EventoId == e.Id
                        && eur.UsuarioId == idUsuario
                        && eur.Rol.Nombre != "Organizador"))
                .ToList();

            eventosDisponibles = eventos
                .Where(e =>
                !contexto.EventoUsuarioRol
                .Include(eur => eur.Rol)
                .Any(eur => eur.EventoId == e.Id
                     && eur.UsuarioId == idUsuario
                     && eur.Rol.Nombre == "Organizador")
                && !contexto.EventoUsuarioRol
                .Any(eur => eur.EventoId == e.Id
                     && eur.UsuarioId == idUsuario)
    )
    .ToList();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            mensaje = $"Error cargando Home: {ex.Message}";
            Console.WriteLine($"[HOME ERROR] {ex}");
        }
    }
    private async Task ActualizarEstadosVotaciones()
    {
        var ahora = DateTime.UtcNow;

        var votaciones = await contexto.Votacion.ToListAsync();

        foreach (var votacion in votaciones)
        {
            Console.WriteLine($"Votación {votacion.Id}");
            Console.WriteLine($"Estado antes: {votacion.EstadoVotacion}");
            Console.WriteLine($"Inicio: {votacion.FechaInicio}");
            Console.WriteLine($"Fin: {votacion.FechaFin}");
            Console.WriteLine($"Ahora: {ahora}");

            bool votacionIsAbierta = votacion.EstadoVotacion == EstadoVotacion.Abierta;
            bool votacionIsPausada = votacion.EstadoVotacion == EstadoVotacion.Pausada;
            bool votacionIsCerrada = votacion.EstadoVotacion == EstadoVotacion.Cerrada;
            bool isEndDateAfterNow = votacion.FechaFin <= ahora;
            bool isIniDateBeforeNow = votacion.FechaInicio <= ahora;
            if ((votacionIsAbierta || votacionIsPausada || votacionIsCerrada) && isEndDateAfterNow)
            {
                votacion.EstadoVotacion = EstadoVotacion.Finalizada;
            }
            else if (votacionIsCerrada && isIniDateBeforeNow)
            {
                votacion.EstadoVotacion = EstadoVotacion.Abierta;
            }

            Console.WriteLine($"Estado después: {votacion.EstadoVotacion}");
        }

        await contexto.SaveChangesAsync();
    }

    private async Task Apuntarse(Guid eventoId)
    {
        try
        {
            if (idUsuario == Guid.Empty)
            {
                mensaje = "No hay sesión.";
                return;
            }

            var url = $"api/eventos/{eventoId}/apuntarse?usuarioId={idUsuario}&apuntar=true";

            var respuesta = await Http.PatchAsync(url, new StringContent(""));

            var detalle = await respuesta.Content.ReadAsStringAsync();

            if (respuesta.IsSuccessStatusCode)
            {
                var evento = eventosDisponibles.FirstOrDefault(e => e.Id == eventoId);

                if (evento != null)
                {
                    eventosDisponibles.Remove(evento);
                    eventosParticipando.Add(evento);
                }

                StateHasChanged();
            }
            else
            {
                mensaje = $"Error HTTP {(int)respuesta.StatusCode} - {respuesta.ReasonPhrase}. Detalle: {detalle}";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al apuntarse: {ex.Message} | Inner: {ex.InnerException?.Message}";
        }
    }

    private async Task Desapuntarse(Guid eventoId)
    {
        try
        {
            if (idUsuario == Guid.Empty)
            {
                mensaje = "No hay sesión.";
                return;
            }

            var respuesta = await Http.PatchAsync(
                $"api/eventos/{eventoId}/apuntarse?usuarioId={idUsuario}&apuntar=false",
                new StringContent(""));

            if (respuesta.IsSuccessStatusCode)
            {
                var evento = eventosParticipando.FirstOrDefault(e => e.Id == eventoId);

                if (evento != null)
                {
                    eventosParticipando.Remove(evento);
                    eventosDisponibles.Add(evento);
                }

                StateHasChanged();
            }
            else
            {
                mensaje = "No se pudo cancelar la inscripción en el evento.";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al desapuntarse: {ex.Message}";
        }
    }

    private void VerInfo(Guid eventoId)
    {
        nav.NavigateTo($"/DashboardEvento/{eventoId}");
    }
}