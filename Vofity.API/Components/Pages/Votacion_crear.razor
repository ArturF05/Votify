@page "/CrearVotacion"
@rendermode InteractiveServer 
@using Microsoft.EntityFrameworkCore
@using Votify.Core.Entities
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@using Votify.Infrastructure.Repositorios
@using Votify.API.DTOs
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject NavigationManager nav
@inject AppDbContext contexto
@inject HttpClient Http
@inject ProtectedSessionStorage sessionStorage

<div class="form-evento">
    <h3>Nueva votacion</h3>
    <hr class="linea">
    <div class="campo">
        <label>Evento de la votación*: </label>
        <select value="@Id_evento" @onchange="EventoSeleccionado" title="No se puede cambiar de evento una votación ya creada">
            <option value="@Guid.Empty"></option>
            @foreach (var evento in eventos.Where(e => e.FechaFin.CompareTo(DateTime.Now)>=0))
            {
                <option value="@evento.Id">@evento.Nombre</option>
            }
        </select>
    </div>
    <div class="labels">
        @if(Id_evento != Guid.Empty)
        {
            <label>Inicio del evento: @inicioEvento    </label>
            <label>Fin del evento: @finEvento</label>
        }
    </div>
    <hr>
    <label>Tipo de votación*:</label>
    <div class="grupo-botones-votacion">
        <button type="button"
                class="boton-votacion @(tipoVotacion == TipoVotacion.Publico ? "activo" : "")"
                @onclick='() => SeleccionarTipo(TipoVotacion.Publico)'>
            Público
        </button>

        <button type="button"
                class="boton-votacion @(tipoVotacion == TipoVotacion.Jurado ? "activo" : "")"
                @onclick='() => SeleccionarTipo(TipoVotacion.Jurado)'>
            Jurado
        </button>

        <button type="button"
                class="boton-votacion @(tipoVotacion == TipoVotacion.Mixto ? "activo" : "")"
                @onclick='() => SeleccionarTipo(TipoVotacion.Mixto)'>
            Mixto
        </button>
    </div>
    <div class="campo">
        <label>Permitir Autovoto*:</label>
        <select @bind ="permiteAutoVoto">
            <option value="1">Sí</option>
            <option value="0">No</option>
        </select>
    </div>
    <div class="campo campo-columna">
        <label>Permitir ver resultados en vivo*:</label>
        <select @bind="verRes">
            <option value="1">Sí</option>
            <option value="0">No</option>
        </select>
    </div>
    <div class="campo">
        <label>Número de proyectos votables*:</label>
        <input type="number" @bind="numProy" min="1" />
    </div>
    <div class="campo">
        <label>Inicio de la votación*:</label>
        <input type="datetime-local" @bind="inicioVotacion" />
    </div>
    <div class="campo">
        <label>Fin de la votación*:</label>
        <input type="datetime-local" @bind="finVotacion" />
    </div>
    <div class="campo campo-columna">
        <label>Permitir comentarios*</label>
        <select @onchange="(e) => cambioPermiteComentarios(e)">
            <option value="1">Sí</option>
            <option value="0">No</option>
        </select>
    </div>
    <div class="campo campo-columna">
        <label>Comentarios Obligatorios*:</label>
        <select @bind="comentariosObligatorios" disabled="@(permiteComentarios == 0)"
                title="@(permiteComentarios == 0 ? "No se puede modificar porque no se permiten comentarios" : null)">
            <option value="0">No</option>
            <option value="1">Sí</option>
        </select>
    </div>
    <div class="errores">
        <div><label style="color:red">@mensaje</label></div>
        <div><label style="color:red">@mensaje2</label></div>
    </div>

    <div class="separador-criterios"></div>

    <section class="bloque-criterios">
        <h3 class="titulo-criterios">Categorías del evento</h3>

        <div class="criterio-formulario">
            <input type="text" placeholder="Nombre de categoría" @bind="nombreCategoriaEvento" class="input-criterio" />
            <button type="button" class="boton-principal" @onclick="GuardarCategoriaEvento">Añadir categoría</button>
        </div>

        @foreach (var categoria in categoriasEvento)
        {
            <div class="criterio-item">
                <div class="criterio-texto">
                    <span class="criterio-nombre">@categoria.Nombre</span>
                </div>
                <div class="criterio-acciones">
                    <button type="button" class="boton-secundario" @onclick="() => QuitarCategoriaEvento(categoria.Id)">Quitar</button>
                </div>
            </div>

            <div class="criterio-formulario">
                <input type="text" placeholder="Nombre criterio" @bind="nombreCriterio" class="input-criterio" />
                <input type="text" placeholder="Descripción" @bind="descripcionCriterio" class="input-criterio" />
                <button type="button" class="boton-principal" @onclick="() => GuardarCriterio(categoria.Id)">Añadir criterio</button>
            </div>

            <div class="lista-criterios">
            @foreach (var c in categoria.Criterios)
            {
                <div class="criterio-item">
                    <div class="criterio-texto">
                        <span class="criterio-nombre">@c.Nombre</span>
                        <span class="criterio-descripcion">@c.Descripcion</span>
                    </div>

                    <div class="criterio-acciones">
                        <span class="criterio-descripcion">Peso (%):</span>
                        <input type="text" class="criterio-peso" @bind="c.Peso" />
                        <button type="button" class="boton-secundario" @onclick="() => QuitarCriterio(categoria.Id, c.Id)">Quitar</button>
                    </div>
                </div>
            }
            </div>
        }

        <div>
            <div><label style="color:red">@mensajeErrorCriterio</label></div>
        </div>
    </section>

    @if (tipoVotacion != TipoVotacion.Publico)
    {
        <div class="jurado-section">
            <div class="jurado-column">
                <h3>Usuarios disponibles</h3>

                <div class="buscador-jurado">
                    <input type="text"
                           placeholder="Buscar por nombre..."
                           @bind="busquedaUsuario"
                           @bind:event="oninput" />
                    <span>🔍</span>
                </div>

                <div class="lista-jurado">
                    @foreach (var usuario in UsuariosDisponiblesFiltrados)
                    {
                        <div class="fila-jurado">
                            <span>@usuario.Nombre</span>

                            <button type="button"
                                    class="boton-add-jurado"
                                    @onclick="() => AnadirJurado(usuario)">
                                +
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="jurado-column">
                <h3>Miembros del jurado seleccionados</h3>

                <div class="lista-jurado seleccionados">
                    @if (!juradoSeleccionado.Any())
                    {
                        <div class="jurado-vacio">
                            No hay miembros seleccionados
                        </div>
                    }
                    else
                    {
                        @foreach (var usuario in juradoSeleccionado)
                        {
                            <div class="fila-jurado">
                                <span>@usuario.Nombre</span>

                                <button type="button"
                                        class="boton-remove-jurado"
                                        @onclick="() => QuitarJurado(usuario)">
                                    🗑
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    <div class="botones">
        <div>
            <button type="button" class="boton-secundario" @onclick="Cancelar">Cancelar</button>
        </div>
        <div>
            <button type="button" class="boton-principal" @onclick="GuardarVotacion">Crear Votacion</button>
        </div>
    </div>
</div>

@code {
    private int permiteAutoVoto = 1;
    public int permiteComentarios = 1;
    public int comentariosObligatorios = 0;
    private DateTime inicioVotacion = DateTime.Now;
    private DateTime finVotacion = DateTime.Now.AddHours(1);
    private DateTime inicioEvento = DateTime.Now;
    private DateTime finEvento = DateTime.Now.AddDays(1);
    private Guid Id_evento = Guid.Empty;
    private int numProy = 1;
    private TipoVotacion tipoVotacion = TipoVotacion.Publico;
    private string mensaje = "";
    private string mensaje2 = "";
    private string mensajeErrorCriterio = "";
    private string mensajeNoCriterio = "";
    private string nombreCategoriaEvento = "";
    private string nombreCriterio = "";
    private string descripcionCriterio = "";
    private int pesoCriterio = 0;
    List<Votify.Core.Entities.Evento> eventos = new();
    List<Votify.Core.Entities.Votacion> votaciones = new();
    List<Votify.Core.Entities.DimensionesDeValor> criterios = new();
    List<CategoriaEventoForm> categoriasEvento = new();
    private Votify.Core.Entities.Evento? evento;
    private Guid idUsuario;
    private bool cargado = false;
    private int verRes = 1;

    private string busquedaUsuario = "";

    private List<Usuario> usuariosDisponibles = new();
    private List<Usuario> juradoSeleccionado = new();

    private List<Usuario> UsuariosDisponiblesFiltrados =>
        usuariosDisponibles
            .Where(u => !juradoSeleccionado.Any(j => j.Id == u.Id))
            .Where(u =>
                string.IsNullOrWhiteSpace(busquedaUsuario)
                || (u.Nombre ?? "").Contains(busquedaUsuario, StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || cargado)
            return;

        var resultado = await sessionStorage.GetAsync<Guid>("IdUsuario");

        if (!resultado.Success || resultado.Value == Guid.Empty)
        {
            nav.NavigateTo("/Login");
            return;
        }

        idUsuario = resultado.Value;

        eventos = await contexto.Evento
            .AsNoTracking()
            .Include(e => e.Categoria)
            .Where(e => contexto.EventoUsuarioRol
                .Include(eur => eur.Rol)
                .Any(eur => eur.EventoId == e.Id
                         && eur.UsuarioId == idUsuario
                         && eur.Rol.Nombre == "Organizador"))
            .ToListAsync();

        usuariosDisponibles = await contexto.Usuario
            .AsNoTracking()
            .Where(u => u.Id != idUsuario)
            .OrderBy(u => u.Nombre)
            .ToListAsync();

        cargado = true;
        StateHasChanged();
    }

    private async Task EventoSeleccionado(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var idEvento))
            idEvento = Guid.Empty;

        Id_evento = idEvento;
        await ponerTiempos();
        await CargarCategoriasEvento();
    }

    private async Task ponerTiempos()
    {
        evento = await contexto.Evento.AsNoTracking().Include(e => e.Categoria).FirstOrDefaultAsync(e => e.Id == Id_evento);
        if (evento == null) return;
        inicioEvento = evento.FechaInicio;
        finEvento = evento.FechaFin;
        StateHasChanged();
    }

    private async Task CargarCategoriasEvento()
    {
        categoriasEvento = await contexto.CategoriaEvento
            .AsNoTracking()
            .Where(c => c.Id_evento == Id_evento)
            .Select(c => new CategoriaEventoForm
            {
                Id = c.Id,
                Nombre = c.Nombre,
                EsNueva = false,
                Criterios = contexto.DimensionesDeValor
                    .Where(d => d.Id_categoria_evento == c.Id)
                    .Select(d => new DimensionesDeValor
                    {
                        Id = Guid.NewGuid(),
                        Id_categoria_evento = c.Id,
                        Nombre = d.Nombre,
                        Descripcion = d.Descripcion,
                        Peso = d.Peso
                    })
                    .ToList()
            })
            .ToListAsync();
    }
    void Cancelar()
    {
        nav.NavigateTo("/GestionarVotaciones");
    }
    void SeleccionarTipo(TipoVotacion tipo)
    {
        tipoVotacion = tipo;
    }
    private void cambioPermiteComentarios(ChangeEventArgs e)
    {
        int nuevoValor = int.Parse(e.Value.ToString());
        permiteComentarios = nuevoValor;
        if (nuevoValor == 0) comentariosObligatorios = 0;
    }
    private async Task GuardarVotacion()
    {
        try
        {
            votaciones = await contexto.Votacion.ToListAsync();

            bool franjaUsada = false;
            bool tipoUsado = false;
            if (Id_evento == Guid.Empty)
            {
                mensaje = "Selecciona un evento";
                return;
            }
            if (finEvento.CompareTo(DateTime.Now) <= 0)
            {
                mensaje = "no puedes añadir votaciones a eventos finalizados";
                return;
            }
            foreach (var vot in votaciones.Where(e=> e.Id_evento == Id_evento))
            {
                if (inicioVotacion.CompareTo(vot.FechaInicio)>=0 && inicioVotacion.CompareTo(vot.FechaFin)<=0)
                {
                    franjaUsada = true;
                    break;
                }
                if (
                    (tipoVotacion == TipoVotacion.Publico && vot is VotacionPublico) ||
                    (tipoVotacion == TipoVotacion.Jurado && vot is VotacionJurado) ||
                    (tipoVotacion == TipoVotacion.Mixto && vot is VotacionMixta)
                )
                {
                    tipoUsado = true;
                    break;
                }
            }
            if (finVotacion.CompareTo(inicioVotacion) <= 0)
            {
                mensaje2 = "El final de la votación debe ser posterior al inicio";
                return;
            }
            if(inicioVotacion.CompareTo(inicioEvento)<0 || finVotacion.CompareTo(finEvento) > 0)
            {
                mensaje = "La votación debe de realizarse durante el evento al que corresponde";
                return;
            }
            if (franjaUsada)
            {
                mensaje = "Hay una votación en esta franja de tiempo, no se permiten votaciones concurrentes en un mismo evento";
                return;
            }
            if (tipoUsado)
            {
                mensaje = "Ya hay una votación de este tipo registrada para este evento";
                return;
            }
            if(numProy<=0)
            {
                mensaje = "Se tiene que poder votar mínimo 1 proyecto";
                return;
            }
            if (!categoriasEvento.Any())
            {
                mensajeErrorCriterio = "El evento debe tener al menos una categoría de votación";
                return;
            }

            foreach (var categoria in categoriasEvento)
            {
                if (!categoria.Criterios.Any())
                {
                    mensajeErrorCriterio = $"La categoría {categoria.Nombre} debe tener al menos un criterio";
                    return;
                }

                if (categoria.Criterios.Sum(c => c.Peso) != 100)
                {
                    mensajeErrorCriterio = $"La suma de pesos de la categoría {categoria.Nombre} debe ser 100";
                    return;
                }
            }

            if (permiteComentarios == 0) comentariosObligatorios = 0;
            evento = await contexto.Evento.AsNoTracking().Include(e => e.Categoria).FirstOrDefaultAsync(e => e.Id == Id_evento);
            await GuardarCategoriasEvento();

            var dto = new CrearVotacionDTOs
            {
                Id_evento = Id_evento,
                FechaInicio = inicioVotacion.ToUniversalTime(),
                FechaFin = finVotacion.ToUniversalTime(),
                PermiteAutoVoto = permiteAutoVoto == 1,
                TipoVotacion = tipoVotacion,
                Num_Proy = numProy,
                VerRes = verRes==1,
                EstadoVotacion= EstadoVotacion.Cerrada,
                Jurados = juradoSeleccionado.Select(u => u.Id).ToList(),
                Criterios = categoriasEvento
                    .SelectMany(categoria => categoria.Criterios.Select(c => new Votify.Core.DTOs.CrearCriterioDTO
                    {
                        Id = c.Id == Guid.Empty ? Guid.NewGuid() : c.Id,
                        IdCategoriaEvento = categoria.Id,
                        Nombre = c.Nombre,
                        Descripcion = c.Descripcion,
                        Peso = c.Peso
                    }))
                    .ToList(),
                PermiteComentarios = permiteComentarios == 1,
                ComentariosObligatorios = comentariosObligatorios == 1
            };
            var response = await Http.PostAsJsonAsync("api/v1/votaciones", dto);

            if (response.IsSuccessStatusCode)
            {
                nav.NavigateTo("/GestionarVotaciones");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensaje = $"No se pudo crear la votación: {error}";
                Console.WriteLine(error);
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
    }

    private async Task GuardarCategoriasEvento()
    {
        foreach (var categoria in categoriasEvento)
        {
            if (categoria.EsNueva)
            {
                await contexto.CategoriaEvento.AddAsync(new CategoriaEvento
                {
                    Id = categoria.Id,
                    Id_evento = Id_evento,
                    Nombre = categoria.Nombre
                });
            }
            else
            {
                var categoriaDb = await contexto.CategoriaEvento.FirstOrDefaultAsync(c => c.Id == categoria.Id);
                if (categoriaDb != null)
                    categoriaDb.Nombre = categoria.Nombre;
            }

        }

        await contexto.SaveChangesAsync();
    }

    private void GuardarCategoriaEvento()
    {
        if (Id_evento == Guid.Empty)
        {
            mensajeErrorCriterio = "Selecciona un evento antes de crear categorías";
            return;
        }

        if (string.IsNullOrWhiteSpace(nombreCategoriaEvento))
        {
            mensajeErrorCriterio = "Debes indicar el nombre de la categoría";
            return;
        }

        if (categoriasEvento.Any(c => c.Nombre.Equals(nombreCategoriaEvento.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            mensajeErrorCriterio = "Ya existe una categoría con ese nombre";
            return;
        }

        var categoria = new CategoriaEventoForm
        {
            Id = Guid.NewGuid(),
            Nombre = nombreCategoriaEvento.Trim(),
            EsNueva = true
        };

        categoriasEvento.Add(categoria);
        nombreCategoriaEvento = "";
        mensajeErrorCriterio = "";
    }

    private void QuitarCategoriaEvento(Guid idCategoria)
    {
        var categoria = categoriasEvento.FirstOrDefault(c => c.Id == idCategoria);
        if (categoria == null)
            return;

        if (!categoria.EsNueva)
        {
            mensajeErrorCriterio = "No puedes quitar desde aquí una categoría que ya existe en el evento";
            return;
        }

        categoriasEvento.Remove(categoria);
    }

    private void GuardarCriterio(Guid idCategoria)
    {
        if (nombreCriterio == "")
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Debes asignar un nombre al criterio";
            return;
        }

        if (descripcionCriterio == "")
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Debes asignar una descripción al criterio";
            return;
        }

        var categoria = categoriasEvento.FirstOrDefault(c => c.Id == idCategoria);
        if (categoria == null)
            return;

        if (categoria.Criterios.Any(c => c.Nombre == nombreCriterio))
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Ya existe un criterio con ese nombre en esta categoría";
            return;
        }

        categoria.Criterios.Add(new DimensionesDeValor
        {
            Id = Guid.NewGuid(),
            Id_votacion = Guid.Empty,
            Id_categoria_evento = idCategoria,
            Nombre = nombreCriterio,
            Descripcion = descripcionCriterio,
            Peso = 0
        });

        nombreCriterio = "";
        descripcionCriterio = "";
        mensajeErrorCriterio = "";
        mensajeNoCriterio = "";
        pesoCriterio = 0;
    }

    private void QuitarCriterio(Guid idCategoria, Guid idCriterio)
    {
        var categoria = categoriasEvento.FirstOrDefault(c => c.Id == idCategoria);
        categoria?.Criterios.RemoveAll(c => c.Id == idCriterio);
    }

    private void AnadirJurado(Usuario usuario)
    {
        if (!juradoSeleccionado.Any(u => u.Id == usuario.Id))
        {
            juradoSeleccionado.Add(usuario);
        }
    }

    private void QuitarJurado(Usuario usuario)
    {
        juradoSeleccionado.RemoveAll(u => u.Id == usuario.Id);
    }

    class CategoriaEventoForm
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
        public bool EsNueva { get; set; }
        public List<DimensionesDeValor> Criterios { get; set; } = new();
    }
}
