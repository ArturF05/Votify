@page "/CrearEvento"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Votify.Core.Entities
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@using Votify.Infrastructure.Repositorios
@using Votify.API.DTOs
@using System.Net.Http.Json
@inject NavigationManager nav
@inject AppDbContext contexto
@inject HttpClient Http

<h3>Crear Evento</h3>

<div class="form-evento">
    <h3>Nuevo evento</h3>
    <hr class="linea">

    <div class="campo">
        <label>Nombre*:</label>
        <input type="text" class="input-ancho" @bind="nombre" placeholder="Nombre del evento..." />
    </div>

    <div class="form-grid">
        <div class="campo">
            <label>Categoría*:</label>
            <select @bind="Id_categoria">
                @foreach (var cat in categorias)
                {
                    <option value="@cat.Id">@cat.Nombre</option>
                }
            </select>
        </div>

        <div class="campo">
            <label>Tipo de evento*:</label>
            <select @bind="tipo">
                <option value="Hackathon">Hackathon</option>
                <option value="Concurso">Concurso</option>
            </select>
        </div>

        <div class="campo">
            <label>Fecha de inicio*:</label>
            <input type="date" @bind="inicio" />
        </div>

        <div class="campo">
            <label>Fecha de cierre*:</label>
            <input type="date" @bind="fin" />
        </div>

        <div class="campo campo-completo campo-tipo-votacion">
            <label>Tipo de votación*:</label>
            <div class="grupo-botones-votacion">
                <button type="button"
                        class="boton-votacion @(tipoVotacion == TipoVotacion.Publico ? "activo" : "")"
                        @onclick='() => SeleccionarTipo(TipoVotacion.Publico)'>
                    Público
                </button>

                <button type="button"
                        class="boton-votacion @(tipoVotacion == TipoVotacion.Jurado ? "activo" : "")"
                        @onclick='() => SeleccionarTipo(TipoVotacion.Jurado)'>
                    Jurado
                </button>

                <button type="button"
                        class="boton-votacion @(tipoVotacion == TipoVotacion.Mixto ? "activo" : "")"
                        @onclick='() => SeleccionarTipo(TipoVotacion.Mixto)'>
                    Mixto
                </button>
            </div>
        </div>

        <div class="campo campo-completo campo-descripcion">
            <label>Descripción:</label>
            <textarea @bind="descripcion" placeholder="Descripción..."></textarea>
        </div>
    </div>

    <div class="errores">
        <div><label style="color:red">@mensaje</label></div>
        <div><label style="color:red">@mensaje2</label></div>
    </div>

    <div class="botones">
        <div>
            <button type="button" class="boton-secundario" @onclick="Cancelar">Cancelar</button>
        </div>
        <div>
            <button type="button" class="boton-principal" @onclick="GuardarEvento">Crear Evento</button>
        </div>
    </div>
</div>

@code {
    DateOnly inicio = DateOnly.FromDateTime(DateTime.Today);
    DateOnly fin = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
    private string nombre = "";
    private Guid Id_categoria = new Guid("0d4e9ac5-56ee-4a5c-817e-ee78bf8a8ed9");
    private string descripcion = "";
    private string mensaje = "";
    private string mensaje2 = "";
    private string tipo = "Hackathon";
    private TipoVotacion tipoVotacion = TipoVotacion.Publico;
    List<Categoria> categorias = new();
    List<Votify.Core.Entities.Evento> eventos = new();

    protected override async Task OnInitializedAsync()
    {
        categorias = await contexto.Categoria.ToListAsync();
    }

    void Cancelar()
    {
        nav.NavigateTo("/Evento");
    }

    void SeleccionarTipo(TipoVotacion tipo)
    {
        tipoVotacion = tipo;
    }

    private async Task GuardarEvento()
    {
        try
        {
            mensaje = "";
            mensaje2 = "";

            eventos = await contexto.Evento
                .Include(e => e.Categoria)
                .Where(e => e.Archivado == false)
                .ToListAsync();

            bool nombreUsado = false;
            bool nombreVacio = string.IsNullOrWhiteSpace(nombre);

            if (nombreVacio)
            {
                mensaje = "El nombre del evento es obligatorio";
                return;
            }

            foreach (var eve in eventos)
            {
                if (eve.Nombre.ToLower().Equals(nombre.ToLower()))
                {
                    nombreUsado = true;
                    break;
                }
            }

            if (nombreUsado)
            {
                mensaje = "El nombre del evento ya está en uso";
                return;
            }

            if (fin.CompareTo(inicio) <= 0)
            {
                mensaje2 = "La fecha del fin del evento debe ser posterior a la fecha de inicio";
                return;
            }

            var dto = new CrearEventoDTOs
            {
                Nombre = nombre,
                Id_categoria = Id_categoria,
                FechaInicio = inicio,
                Descripcion = descripcion,
                FechaFin = fin,
                Tipo = tipo,
                TipoVotacion = tipoVotacion
            };

            var response = await Http.PostAsJsonAsync("api/eventos", dto);

            if (response.IsSuccessStatusCode)
            {
                nav.NavigateTo("/Evento");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensaje = $"No se pudo crear el evento: {error}";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
    }
}