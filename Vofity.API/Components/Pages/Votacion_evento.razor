@page "/Votacion_evento/{id:guid}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Votify.Core.DTOs
@using Votify.Core.Entities
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@using Votify.Infrastructure.Repositorios
@using Votify.Core.Interfaces
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@inject NavigationManager nav;
@inject AppDbContext contexto
@inject HttpClient Http
@inject ProtectedSessionStorage sessionStorage
@inject IVotacion VotacionService
@inject UsuarioSesion usuarioSesion

<style>
    ﻿.votacion-evento-page {
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: 34px;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .titulo {
        font-size: 2rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
    }

    .subtitulo {
        color: #6b7280;
        margin-top: 0.4rem;
        font-size: 0.95rem;
    }

    .estado-card {
        background: #ffffff;
        border-radius: 1.25rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        border: 1px solid #f1ebe3;
        padding: 1.5rem;
    }

    .proyecto-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
    }

    .proyecto-card {
        background: #ffffff;
        border-radius: 1.25rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        border: 1px solid #f1ebe3;
        min-height: 180px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.25s ease;
    }

        .proyecto-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 50px rgba(245, 166, 35, 0.22);
            border-color: #f28c28;
        }

    .proyecto-top {
        display: flex;
        justify-content: flex-end;
    }

    .boton-favorito {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        width: 44px;
        height: 44px;
        border-radius: 999px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

        .boton-favorito:hover {
            background: #f28c28;
            border-color: #f28c28;
        }

            .boton-favorito:hover img {
                transform: scale(1.08);
            }

    .estrella-img {
        width: 22px;
        height: 22px;
        object-fit: contain;
        transition: transform 0.2s ease;
    }

    .proyecto-header {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        flex: 1;
        padding: 0.5rem;
    }

    .proyecto-nombre {
        font-size: 1.15rem;
        font-weight: 700;
        color: #1a1a1a;
        line-height: 1.35;
    }

    .acciones {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 2rem;
        flex-wrap: wrap;
    }

    .acciones-izquierda,
    .acciones-derecha {
        display: flex;
        gap: 0.85rem;
        flex-wrap: wrap;
    }

    .boton-principal {
        background: linear-gradient(135deg, #F5A623 0%, #FF8C00 100%);
        color: white;
        border: none;
        padding: 0.9rem 1.35rem;
        border-radius: 12px;
        cursor: pointer;
        font-size: 0.95rem;
        font-weight: 600;
        transition: all 0.25s ease;
        box-shadow: 0 4px 15px -3px rgba(245, 166, 35, 0.45);
    }

        .boton-principal:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px -5px rgba(245, 166, 35, 0.5);
        }

    .boton-secundario {
        background: #ffffff;
        border: 1px solid #f28c28;
        color: #f28c28;
        padding: 0.9rem 1.2rem;
        border-radius: 12px;
        cursor: pointer;
        font-size: 0.95rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .boton-volver {
        background-color: #F28C2F;
        color: white;
        padding: 6px 14px;
        border-radius: 5px;
        margin-top: 20px;
    }

    .texto-error {
        margin-top: 10px;
        color: red;
    }

    .boton-secundario:hover {
        background: #f28c28;
        color: white;
    }

    .mensaje-estado {
        margin-top: 1rem;
        padding: 1rem;
        border-radius: 12px;
        background: #fff7ed;
        color: #c56d00;
        border: 1px solid #fed7aa;
        font-weight: 500;
    }

    .criterios-proyecto {
        margin-top: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

    .linea-criterios {
        border: none;
        border-top: 1px solid #ece2d8;
        margin: 0.25rem 0 0.2rem 0;
    }

    .criterio-fila {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.8rem;
        background: #fcfbfa;
        border: 1px solid #eee3d8;
        border-radius: 14px;
        padding: 0.7rem 0.8rem;
    }

    .criterio-nombre-voto {
        font-size: 0.95rem;
        font-weight: 500;
        color: #1f2937;
    }

    .input-puntuacion {
        width: 54px;
        min-width: 54px;
        text-align: center;
        background: #f3f4f6;
        border: 2px solid transparent;
        border-radius: 12px;
        padding: 0.55rem 0.35rem;
        font-size: 0.95rem;
        font-weight: 700;
        color: #1f2937;
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

        .input-puntuacion:focus,
        .input-puntuacion:hover {
            background: #ffffff;
            border-color: #f28c28;
        }

    .comentario-container {
        margin-top: 0.7rem;
    }

    .textarea-comentario {
        width: 100%;
        min-height: 78px;
        background: #f3f4f6;
        border: 2px solid transparent;
        border-radius: 14px;
        padding: 0.85rem 0.95rem;
        font-size: 0.95rem;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
        resize: none;
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

        .textarea-comentario:focus,
        .textarea-comentario:hover {
            background: #ffffff;
            border-color: #f28c28;
        }

        .textarea-comentario::placeholder {
            color: #8b93a1;
        }
</style>

<div class="votacion-evento-page">
    @if (evento == null)
    {
        <div class="estado-card">
            <label>Cargando proyectos...</label>
        </div>
    }
    else if (evento.Proyectos == null || evento.Proyectos.Count == 0)
    {
        <div class="page-header">
            <h2 class="titulo">Proyectos del evento @evento.Nombre</h2>
            <p class="subtitulo">Selecciona tus proyectos favoritos</p>
        </div>

        <div class="estado-card">
            <label>No se han presentado proyectos para este evento todavía</label>
        </div>
    }
    else
    {
        <div class="page-header">
            <h2 class="titulo">Proyectos del evento @evento.Nombre</h2>
            <p class="subtitulo">Selecciona tus 3 proyectos favoritos</p>
        </div>

        <div class="proyecto-container">
            @foreach (var proyecto in evento.Proyectos)
            {
                <div class="proyecto-card">
                    <div class="proyecto-top">
                        <button class="boton-favorito" @onclick="() => Favorito(proyecto.Id)">
                            <img src="@(proyectosSeleccionados.Contains(proyecto.Id)
                                ? "/EsFavorito.jpg"
                                : "/Estrella.png")"
                                 alt="Símbolo Favorito"
                                 class="estrella-img" />
                        </button>
                    </div>

                    <div class="proyecto-header">
                        <div class="proyecto-nombre">@proyecto.Titulo</div>
                    </div>

                    @if (proyectosSeleccionados.Contains(proyecto.Id))
                    {
                        <div class="criterios-proyecto">
                            <hr class="linea-criterios" />

                            @foreach (var criterio in criterios)
                            {
                                <div class="criterio-fila">
                                    <span class="criterio-nombre-voto">@criterio.Nombre</span>

                                    <input type="number"
                                           min="0"
                                           max="10"
                                           class="input-puntuacion"
                                           value="@puntuacionesPorProyecto[proyecto.Id][criterio.Id]"
                                           @oninput="(e) => notaValida(e, proyecto.Id, criterio.Id)" />
                                </div>
                            }

                            <div class="comentario-container">
                                <textarea @bind="comentariosPorProyecto[proyecto.Id]"
                                          placeholder="Añadir comentario..."
                                          class="textarea-comentario">
                        </textarea>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div class="acciones">
        <div class="acciones-izquierda">
            <button type="button" class="boton-secundario" @onclick='() => Volver()'>Volver</button>
        </div>

        <div class="acciones-derecha">
            @if (PuedeVerResultados())
            {
                <button type="button" class="boton-secundario" @onclick='() => VerResultados()'>
                    Ver Resultados
                </button>
            }
            <button type="button" class="boton-principal" @onclick='() => EnviarVoto()'>Enviar Voto</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="mensaje-estado">@mensaje</div>
    }
</div>

@code{
    private Votify.Core.Entities.Evento? evento;
    [Parameter]
    public Guid id { get; set; }
    private List<Guid> proyectosSeleccionados = new();
    private Guid idVotacion;
    private Votify.Core.Entities.Votacion? votacion;
    private Guid idVotante;
    private string mensaje = "";
    private Dictionary<Guid, string> comentariosPorProyecto = new();
    private List<DimensionesDeValor> criterios = new();
    private Dictionary<Guid, Dictionary<Guid, int>> puntuacionesPorProyecto = new();

    protected override async Task OnInitializedAsync()
    {
        evento = await contexto.Evento.Include(e => e.Proyectos).FirstOrDefaultAsync(e => e.Id == id);
        votacion = await contexto.Votacion
            .FirstOrDefaultAsync(v => v.Id_evento == id);

        if (votacion != null)
        {
            idVotacion = votacion.Id;
        }
        if (evento == null)
        {
            mensaje = "No se ha encontrado el evento.";
            return;
        }

        criterios = await contexto.DimensionesDeValor.Where(d => d.Id_votacion == votacion.Id).ToListAsync();

        foreach (var proyecto in evento.Proyectos)
        {
            if (!comentariosPorProyecto.ContainsKey(proyecto.Id))
                comentariosPorProyecto[proyecto.Id] = "";

            if (!puntuacionesPorProyecto.ContainsKey(proyecto.Id))
                puntuacionesPorProyecto[proyecto.Id] = new Dictionary<Guid, int>();

            foreach (var criterio in criterios)
            {
                if (!puntuacionesPorProyecto[proyecto.Id].ContainsKey(criterio.Id))
                    puntuacionesPorProyecto[proyecto.Id][criterio.Id] = 0;
            }
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        ProtectedBrowserStorageResult<Guid> resultado;
        try
        {
            resultado = await sessionStorage.GetAsync<Guid>("IdUsuario");
            if (resultado.Success)
            {
                idVotante = resultado.Value;
                usuarioSesion.IdUsuario = resultado.Value;
                StateHasChanged();
            }
            if (!resultado.Success || resultado.Value == Guid.Empty)
            {
                nav.NavigateTo("/Login");
                return;
            }
        }
        catch (Exception e)
        {
            nav.NavigateTo("/Login");
            return;
        }
    }
    private void Favorito(Guid idProyecto)
    {
        if (proyectosSeleccionados.Contains(idProyecto))
        {
            proyectosSeleccionados.Remove(idProyecto);
        }
        else
        {
            if (proyectosSeleccionados.Count < 3)
            {
                proyectosSeleccionados.Add(idProyecto);
                comentariosPorProyecto[idProyecto] = "";
            }
        }
    }

    private async Task EnviarVoto()
    {
        if (idVotante == Guid.Empty)
        {
            mensaje = "Error: No se detecta una sesión activa. Por favor, reingresa.";
            return;
        }

        var usuario = await contexto.Usuario.Include(u => u.Rol).FirstOrDefaultAsync(u => u.Id == idVotante);
        if (usuario == null)
        {
            mensaje = "No se ha encontrado el usuario autenticado.";
            return;
        }
        if (evento == null)
        {
            mensaje = "No se ha podido cargar el evento.";
            return;
        }

        if (idVotacion == Guid.Empty)
        {
            mensaje = "No hay una votación activa para este evento, espera a que haya una para poder votar.";
            return;
        }
        var rolUsuario = usuario.Rol.Nombre;

        if (votacion is VotacionPublico)
        {
            if (rolUsuario != "Publico")
            {
                mensaje = "Solo usuarios públicos pueden votar en este evento.";
                return;
            }
        }
        else if (votacion is VotacionJurado)
        {
            var autorizacion = await contexto.EventoUsuarioRol
                .Where(eur => eur.EventoId == id && eur.UsuarioId == usuario.Id)
                .AnyAsync();

            if (!autorizacion)
            {
                mensaje = "Solo el jurado asignado puede votar.";
                return;
            }
        }
        else if (votacion is VotacionMixta)
        {
            bool esPublico = rolUsuario == "Publico";

            bool esJuradoAsignado = await contexto.EventoUsuarioRol
                .Where(eur => eur.EventoId == id && eur.UsuarioId == usuario.Id)
                .AnyAsync();

            if (!esPublico && !esJuradoAsignado)
            {
                mensaje = "Solo usuarios públicos o jurado asignado pueden votar en este evento.";
                return;
            }
        }

        if (proyectosSeleccionados.Count != 3)
        {
            mensaje = "Debes seleccionar exactamente 3 proyectos para votar.";
            return;
        }

        foreach (var idProyecto in proyectosSeleccionados)
        {
            if (!puntuacionesPorProyecto.ContainsKey(idProyecto))
            {
                mensaje = "Faltan puntuaciones en uno de los proyectos seleccionados.";
                return;
            }

            foreach (var criterio in criterios)
            {
                if (!puntuacionesPorProyecto[idProyecto].ContainsKey(criterio.Id))
                {
                    mensaje = $"Falta la puntuación del criterio {criterio.Nombre} en uno de los proyectos.";
                    return;
                }

                int nota = puntuacionesPorProyecto[idProyecto][criterio.Id];

                if (nota < 0 || nota > 10)
                {
                    mensaje = $"La puntuación del criterio {criterio.Nombre} debe estar entre 0 y 10.";
                    return;
                }
            }
        }

        // evitar votos duplicados  
        var yaVoto = await contexto.Voto
            .AnyAsync(v => v.Id_votante == usuario.Id && v.Id_votacion == idVotacion);

        if (yaVoto)
        {
            mensaje = "Ya has votado en este evento.";
            return;
        }
        var votoDto = new EmitirVotoDTO
        {
            IdVotante = usuario.Id,
            Votos = proyectosSeleccionados.Select(idProyecto => new VotoDetalleDTO
            {
                IdProyecto = idProyecto,
                Comentario = comentariosPorProyecto.ContainsKey(idProyecto)
                    ? comentariosPorProyecto[idProyecto]
                    : string.Empty,
                Puntuaciones = criterios.Select(c => new PuntuacionCriterioDTO
                {
                    IdCriterio = c.Id,
                    Nota = puntuacionesPorProyecto[idProyecto][c.Id]
                }).ToList()
            }).ToList()
        };

        var resultado = await VotacionService.RegistrarVotoAsync(idVotacion, votoDto);

        mensaje = resultado
            ? "Voto enviado correctamente."
            : "Error al registrar el voto. Verifica que no hayas votado antes y que la votación esté activa.";
    }

    void Volver()
    {
        nav.NavigateTo("/Votacion");
    }

    void VerResultados()
    {
        nav.NavigateTo($"/Dashboard/{evento.Id}");
    }

    private bool PuedeVerResultados()
    {
        if (votacion == null)
            return false;

        var hoy = DateTime.Now;

        return votacion.FechaFin <= hoy;
    }

    private void notaValida(ChangeEventArgs e, Guid idProyecto, Guid idCriterio)
    {
        if (!int.TryParse(e.Value?.ToString(), out int valor))
            valor = 0;

        if (valor < 0)
            valor = 0;
        else if (valor > 10)
            valor = 10;

        puntuacionesPorProyecto[idProyecto][idCriterio] = valor;
    }
}