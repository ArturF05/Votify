@page "/Votacion_evento/{id:guid}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Votify.Core.DTOs
@using Votify.Core.Entities
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@using Votify.Infrastructure.Repositorios
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@inject NavigationManager nav;
@inject AppDbContext contexto
@inject HttpClient Http
@inject UsuarioSesion usuarioSesion
@inject ProtectedSessionStorage sessionStorage
@inject UsuarioSesion usuarioSesion
@if (evento == null)
{
    <label>Cargando proyectos...</label>
}
else if (evento.Proyectos == null || evento.Proyectos.Count == 0)
{
    <h2 class="titulo">Proyectos del evento @evento.Nombre</h2>
    <label>No se han presentado proyectos todavía</label>
}
else
{
    <h2 class="titulo">Proyectos del evento @evento.Nombre</h2>
    <div class="proyecto-container">
        @foreach (var proyecto in evento.Proyectos)
        {
            <div class="proyecto-card">
                <button class="boton-favorito" @onclick="() => Favorito(proyecto.Id)">
                    <img src="@(proyectosSeleccionados.Contains(proyecto.Id) ? "/EsFavorito.jpg" : "/Estrella.png")"
                         class="estrella-img" />
                </button>

                <div class="proyecto-header">
                    <label>@proyecto.Titulo</label>
                </div>

                
                @if (proyectosSeleccionados.Contains(proyecto.Id))
                {
                    <div class="comentario-container">
                        <textarea @bind="comentariosPorProyecto[proyecto.Id]"
                                  placeholder="Escribe tu comentario aquí..."
                                  class="form-control">
                                </textarea>
                    </div>
                }
            </div>
        }
    </div>
}
<div>
    <button type="button" class="boton-volver" @onclick='() => Volver()'>Volver</button>
    <button type="button" class="boton-volver" @onclick='() => EnviarVoto()'>Enviar Voto</button>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <p>@mensaje</p>
}

@code{
    private Votify.Core.Entities.Evento evento;
    [Parameter]
    public Guid id { get; set; }
    private List<Guid> proyectosSeleccionados = new();
    private Guid idVotacion;
    private Guid idVotante;
    private string mensaje = "";
    private Dictionary<Guid, string> comentariosPorProyecto = new();

    protected override async Task OnInitializedAsync()
    {
        evento = await contexto.Evento.Include(e => e.Proyectos).FirstOrDefaultAsync(e => e.Id == id);
        var votacion = await contexto.Votacion.FirstOrDefaultAsync(v => v.Id_evento == id);
        if (votacion != null) { idVotacion = votacion.Id; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var resultado = await sessionStorage.GetAsync<Guid>("IdUsuario");

            if (resultado.Success)
            {
                idVotante = resultado.Value;
                usuarioSesion.IdUsuario = resultado.Value;
                StateHasChanged();
            }
        }
    }
    private void Favorito(Guid idProyecto)
    {
        if (proyectosSeleccionados.Contains(idProyecto))
        {
            proyectosSeleccionados.Remove(idProyecto);
        }
        else
        {
            if (proyectosSeleccionados.Count < 3)
            {
                proyectosSeleccionados.Add(idProyecto);
                comentariosPorProyecto[idProyecto] = "";
            }
        }
    }

    private async Task EnviarVoto()
    {
        if (idVotante == Guid.Empty)
        {
            mensaje = "No hay ningún usuario autenticado.";
            return;
        }
        var votoDto = new 
        {
            IdVotante = idVotante,
            Votos = proyectosSeleccionados.Select(id => new VotoDetalleDTO
            {
                IdProyecto = id,
                Comentario = comentariosPorProyecto.ContainsKey(id) ? comentariosPorProyecto[id] : ""
            }).ToList()
        };

        var respuesta = await Http.PostAsJsonAsync($"api/v1/votaciones/{idVotacion}/votos", votoDto);
        var errorMsg = await respuesta.Content.ReadAsStringAsync();

        if (respuesta.IsSuccessStatusCode)
        {
            mensaje = "Voto enviado correctamente.";
        }
        else
        {
            mensaje = $"Error {(int)respuesta.StatusCode} : {errorMsg}";
        }
    }

    void Volver()
    {
        nav.NavigateTo("/Votacion");
    }
}