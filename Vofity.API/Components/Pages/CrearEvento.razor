    private void CopiarCriteriosCategoria(Guid idCategoriaDestino)
    {
        var categoriaDestino = categoriasEvento
            .FirstOrDefault(c => c.Id == idCategoriaDestino);

        if (categoriaDestino == null)
            return;

        // Si todavía no hay nada copiado = copiar
        if (criteriosCopiadosCategoria == null)
        {
            criteriosCopiadosCategoria = categoriaDestino.Criterios
                .Select(c => new DimensionesDeValor
                {
                    Id = Guid.NewGuid(),
                    Id_votacion = Guid.Empty,
                    Id_categoria_evento = categoriaDestino.Id,
                    Nombre = c.Nombre,
                    Descripcion = c.Descripcion,
                    Peso = c.Peso
                }).ToList();

            idCategoriaCopiadaDe = idCategoriaDestino;
            return;
        }

        // Click sobre la misma categoría = cancelar copiado
        if (idCategoriaCopiadaDe == idCategoriaDestino)
        {
            criteriosCopiadosCategoria = null;
            idCategoriaCopiadaDe = Guid.Empty;
            return;
        }

        // PEGAR
        foreach (var c in criteriosCopiadosCategoria)
        {
            if (categoriaDestino.Criterios.Any(x =>
                x.Nombre.Equals(c.Nombre, StringComparison.OrdinalIgnoreCase)))
                continue;

            categoriaDestino.Criterios.Add(new DimensionesDeValor
            {
                Id = Guid.NewGuid(),
                Id_votacion = Guid.Empty,
                Id_categoria_evento = categoriaDestino.Id,
                Nombre = c.Nombre,
                Descripcion = c.Descripcion,
                Peso = c.Peso
            });
        }

        criteriosCopiadosCategoria = null;
        idCategoriaCopiadaDe = Guid.Empty;
        hayCambios = true;
    }
    private void cambioPermiteComentarios(ChangeEventArgs e, int i)
    {
        hayCambios = true;
        int nuevoValor = int.Parse(e.Value.ToString());
        votaciones[i].PermiteComentarios = nuevoValor;
        if (nuevoValor == 0) votaciones[i].ComentariosObligatorios = 0;
    }
    private async Task OnImagenSeleccionada(InputFileChangeEventArgs e)
    {
        var file = e.File;
        const long max = 5 * 1024 * 1024;

        if (file.Size > max)
        {
            mensaje = "Imagen demasiado grande";
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLower();
        var permitidas = new[] { ".jpg", ".jpeg", ".png" };

        if (!permitidas.Contains(ext))
        {
            mensaje = "Formato no permitido";
            return;
        }

        imagenNombre = file.Name;

        using var stream = file.OpenReadStream(max);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        imagenBytes = ms.ToArray();
    }
    private async Task GuardarEvento()
    {
        errorGuardado = false;
        try
        {
            mensaje = "";
            mensaje2 = "";

            eventos = await contexto.Evento
                .Include(e => e.Categoria)
                .Where(e => e.Archivado == false)
                .ToListAsync();

            bool nombreUsado = false;
            bool nombreVacio = string.IsNullOrWhiteSpace(nombre);

            if (nombreVacio)
            {
                mensaje = "El nombre del evento es obligatorio";
                errorGuardado = true;
                return;
            }

            foreach (var eve in eventos)
            {
                if (eve.Nombre.ToLower().Equals(nombre.ToLower()))
                {
                    nombreUsado = true;
                    break;
                }
            }

            if (nombreUsado)
            {
                mensaje = "El nombre del evento ya está en uso";
                errorGuardado = true;
                return;
            }

            if (fin.CompareTo(inicio) <= 0)
            {
                mensaje2 = "La fecha del fin del evento debe ser posterior a la fecha de inicio";
                errorGuardado = true;
                return;
            }
            bool franjaUsada = false;
            for (int i = 0; i < votaciones.Count; i++)
            {
                for (int j = 0; j<votaciones.Count; j++)
                {
                    if (j != i)
                    {
                        franjaUsada = (votaciones[i].Inicio < votaciones[j].Fin && votaciones[i].Fin > votaciones[j].Inicio) || franjaUsada;
                    }
                }
                if (votaciones[i].Inicio.CompareTo(inicio) < 0 || votaciones[i].Fin.CompareTo(fin) > 0)
                {
                    mensaje = "La votación " +(i+1)+ " debe de realizarse durante el evento";
                    errorGuardado = true;
                    return;
                }
                if (votaciones[i].Fin.CompareTo(votaciones[i].Inicio) <= 0)
                {
                    mensaje2 = "El final de la votación "+ (i+1) + " debe ser posterior a su inicio";
                    errorGuardado = true;
                    return;
                }
                if (franjaUsada)
                {
                    mensaje = "No se permiten votaciones concurrentes en un mismo evento";
                    errorGuardado = true;
                    return;
                }
                if (votaciones[i].NumProy <= 0)
                {
                    mensaje = $"La votación {i + 1} debe permitir votar al menos 1 proyecto";
                    errorGuardado = true;
                    return;
                }
                if (votaciones[i].PermiteComentarios == 0) votaciones[i].ComentariosObligatorios = 0;
            }

            if (!categoriasEvento.Any())
            {
                mensajeErrorCriterio = "Debes crear al menos una categoría de votación";
                errorGuardado = true;
                return;
            }

            for (int i = 0; i < votaciones.Count; i++)
            {
                var categoriasDeLaVotacion = categoriasEvento
                    .Where(c => votaciones[i].IdCategoriaVotacion == Guid.Empty ||
                                c.Id == votaciones[i].IdCategoriaVotacion)
                    .ToList();

                foreach (var categoria in categoriasDeLaVotacion)
                {
                    if (!categoria.Criterios.Any())
                    {
                        mensajeErrorCriterio = $"La categoría {categoria.Nombre} (votación {i + 1}) debe tener al menos un criterio";
                        errorGuardado = true;
                        return;
                    }
                    if (categoria.Criterios.Sum(c => c.Peso) != 100)
                    {
                        mensajeErrorCriterio = $"La suma de pesos de la categoría {categoria.Nombre} (votación {i + 1}) debe ser 100";
                        errorGuardado = true;
                        return;
                    }
                }
            }

            List<CrearVotacionDTOs> crearVotacionDTOs = new();
            for (int i = 0; i < votaciones.Count; i++)
            {
                var dtoVotacion = new CrearVotacionDTOs
                {
                    FechaInicio = votaciones[i].Inicio.ToUniversalTime(),
                    FechaFin = votaciones[i].Fin.ToUniversalTime(),
                    PermiteAutoVoto = votaciones[i].PermiteAutoVoto == 1,
                    TipoVotacion = votaciones[i].Tipo,
                    Num_Proy = votaciones[i].NumProy,
                    EstadoVotacion = EstadoVotacion.Cerrada,
                    PermiteComentarios = votaciones[i].PermiteComentarios == 1,
                    ComentariosObligatorios = votaciones[i].ComentariosObligatorios == 1,
                    Id_categoria_evento = votaciones[i].IdCategoriaVotacion == Guid.Empty
                        ? null
                        : votaciones[i].IdCategoriaVotacion,
                    Criterios = categoriasEvento.Where(categoria =>     
                        votaciones[i].IdCategoriaVotacion == Guid.Empty ||
                        categoria.Id == votaciones[i].IdCategoriaVotacion)
                        .SelectMany(categoria => categoria.Criterios.Select(c => new Votify.Core.DTOs.CrearCriterioDTO
                        {
                            Id = Guid.NewGuid(),
                            IdCategoriaEvento = categoria.Id,
                            Nombre = c.Nombre,
                            Descripcion = c.Descripcion,
                            Peso = c.Peso
                        }))
                        .ToList(),

                    VerRes = votaciones[i].VerRes==1

                };
                crearVotacionDTOs.Add(dtoVotacion);
            }
            var dto = new CrearEventoDTOs
            {
                Nombre = nombre,
                Id_categoria = Id_categoria,
                FechaInicio = inicio.ToUniversalTime(),
                Descripcion = descripcion,
                FechaFin = fin.ToUniversalTime(),
                Tipo = tipo,
                CategoriasEvento = categoriasEvento.Select(categoria => new CategoriaEventoConCriteriosDTO
                {
                    Id = categoria.Id,
                    Nombre = categoria.Nombre,
                    Criterios = categoria.Criterios.Select(c => new CrearCriterioCategoriaDTO
                    {
                        Nombre = c.Nombre,
                        Descripcion = c.Descripcion,
                        Peso = c.Peso
                    }).ToList()
                }).ToList(),
                dTOsVotacion = crearVotacionDTOs,
                UsuarioCreadorId = usuarioActual.Id,
                ImagenBytes = imagenBytes,
                ImagenNombre = imagenNombre
            };

            var responseEvento = await Http.PostAsJsonAsync("api/eventos", dto);
            var responseVotaciones = responseEvento;

            if (responseEvento.IsSuccessStatusCode)
            {
                hayCambios = false;
                await JS.InvokeVoidAsync("history.back");

            }
            else
            {
                var error = await responseEvento.Content.ReadAsStringAsync();
                mensaje = $"No se pudo crear el evento: {error}";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
    }

    private void GuardarCategoriaEvento()
    {
        if (string.IsNullOrWhiteSpace(nombreCategoriaEvento))
        {
            mensajeErrorCriterio = "Debes indicar el nombre de la categoría";
            return;
        }

        if (categoriasEvento.Any(c => c.Nombre.Equals(nombreCategoriaEvento.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            mensajeErrorCriterio = "Ya existe una categoría con ese nombre";
            return;
        }
        hayCambios = true;
        var nuevaCategoria = new CategoriaEventoForm
        {
            Id = Guid.NewGuid(),
            Nombre = nombreCategoriaEvento.Trim()
        };

        categoriasEvento.Add(nuevaCategoria);
        nombreCategoriaEvento = "";
        mensajeErrorCriterio = "";
    }

    private void QuitarCategoriaEvento(Guid idCategoria)
    {
        hayCambios = true;
        categoriasEvento.RemoveAll(c => c.Id == idCategoria);
    }

    private void GuardarCriterioCategoria(Guid idCategoria)
    {
        if (nombreCriterio == "")
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Debes asignar un nombre al criterio";
            return;
        }

        if (descripcionCriterio == "")
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Debes asignar una descripción al criterio";
            return;
        }

        var categoria = categoriasEvento.FirstOrDefault(c => c.Id == idCategoria);
        if (categoria == null)
            return;

        if (categoria.Criterios.Any(c => c.Nombre == nombreCriterio))
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Ya existe un criterio con ese nombre en esta categoría";
            return;
        }
        hayCambios = true;
        categoria.Criterios.Add(new DimensionesDeValor
            {
                Id = Guid.NewGuid(),
                Id_votacion = Guid.Empty,
                Id_categoria_evento = idCategoria,
                Nombre = nombreCriterio,
                Descripcion = descripcionCriterio,
                Peso = 0
            });

        nombreCriterio = "";
        descripcionCriterio = "";
        mensajeErrorCriterio = "";
        mensajeNoCriterio = "";
        pesoCriterio = 0;
    }

    private void QuitarCriterioCategoria(Guid idCategoria, Guid idCriterio)
    {
        hayCambios = true;
        var categoria = categoriasEvento.FirstOrDefault(c => c.Id == idCategoria);
        categoria?.Criterios.RemoveAll(c => c.Id == idCriterio);
    }
    private string GetTooltipGeneral(PlantillaGeneral pg)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Tipo de evento: {pg.Tipo}");
        sb.AppendLine($"Votación: {pg.Votacion.Tipo} | Autovoto: {(pg.Votacion.PermiteAutoVoto == 1 ? "Sí" : "No")} | Ver resultados en vivo: {(pg.Votacion.VerRes == 1 ? "Sí" : "No")}");
        sb.AppendLine($"Comentarios: {(pg.Votacion.PermiteComentarios == 1 ? "Sí" : "No")} | Obligatorios: {(pg.Votacion.ComentariosObligatorios == 1 ? "Sí" : "No")} | Proyectos votables: {pg.Votacion.NumProy}");
        foreach (var cat in pg.Categorias)
        {
            sb.AppendLine($"Categoría: {cat.Nombre}");
            foreach (var c in cat.Criterios)
                sb.AppendLine($"  · {c.Nombre} ({c.Peso}%): {c.Descripcion}");
        }
        return sb.ToString();
    }

