@page "/EditarVotacion/{id:guid}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Votify.Core.Entities
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@using Votify.Infrastructure.Repositorios
@using Votify.API.DTOs
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage sessionStorage
@inject NavigationManager nav
@inject AppDbContext contexto
@inject HttpClient Http
@inject IJSRuntime JS

<div class="form-evento">
    <h3>Editar votación</h3>
    <hr class="linea">
    <div class="campo">
        <label>Evento de la votación*: </label>
        <select @bind="Id_evento" disabled>
            <option value="@Guid.Empty"></option>
            @foreach (var evento in eventos.Where(e => e.FechaFin.CompareTo(DateTime.Now)>=0))
            {
                <option value="@evento.Id">@evento.Nombre</option>
            }
        </select>
    </div>
    <div class="labels">
        <label>Inicio del evento: @inicioEvento    </label>
        <label>Fin del evento: @finEvento</label>
    </div>
    <hr>
    <label>Tipo de votación*:</label>
    <div class="grupo-botones-votacion">
        <button type="button"
        class="boton-votacion @(tipoVotacion == TipoVotacion.Publico ? "activo" : "")"
        @onclick='() => SeleccionarTipo(TipoVotacion.Publico)'>
            Público
        </button>

        <button type="button"
        class="boton-votacion @(tipoVotacion == TipoVotacion.Jurado ? "activo" : "")"
        @onclick='() => SeleccionarTipo(TipoVotacion.Jurado)'>
            Jurado
        </button>
    
        <button type="button"
        class="boton-votacion @(tipoVotacion == TipoVotacion.Mixto ? "activo" : "")"
        @onclick='() => SeleccionarTipo(TipoVotacion.Mixto)'>
            Mixto
        </button>
    </div>
    <label> Estado Votacion: @estadoVotacion </label>
    <div class="grupo-botones-estados">
        <button type="button"
                class="boton-control abrir"
                disabled="@(estadoVotacion != EstadoVotacion.Cerrada)"
                @onclick='() => SeleccionarEstado(EstadoVotacion.Abierta)'>
            ▷ Abrir
        </button>
        <button type="button"
                class="boton-control detener"
                disabled="@(estadoVotacion == EstadoVotacion.Pausada || estadoVotacion == EstadoVotacion.Cerrada)"
                @onclick='() => SeleccionarEstado(EstadoVotacion.Pausada)'>
            ⏸ Pausar
        </button>
        <button type="button"
                class="boton-control reanudar"
                disabled="@(estadoVotacion != EstadoVotacion.Pausada)"
                @onclick='() => SeleccionarEstado(EstadoVotacion.Abierta)'>
            ▷ Reanudar
        </button>
        <button type="button"
                class="boton-control cerrar"
                disabled="@(estadoVotacion == EstadoVotacion.Cerrada)"
                @onclick='() => SeleccionarEstado(EstadoVotacion.Cerrada)'>
            ⊙ Cerrar
        </button>
    </div>
    <div class="campo">
        <label>Permitir Autovoto*:</label>
        <select @onchange="cambioPermiteAutoVoto">
            <option value="1">Sí</option>
            <option value="0">No</option>
        </select>
    </div>
    <div class="campo campo-columna">
        <label>Permitir ver resultados en vivo*:</label>
        <select @bind="verRes">
            <option value="1">Sí</option>
            <option value="0">No</option>
        </select>
    </div>
    <div class="campo">
        <label>Inicio de la votación*:</label>
        <input type="datetime-local" @bind-value="inicioVotacion" @bind-value:event="onchange" disabled="@(inicioVotacion < DateTime.Now)" 
               title='@(inicioVotacion < DateTime.Now
                        ? "No se puede modificar el inicio de una votación en curso"
                        : null)'/>
    </div>
    <div class="campo">
        <label>Fin de la votación*:</label>
        <input type="datetime-local" @bind-value="finVotacion" @bind-value:event="onchange" />
    </div>
    <div class="campo campo-columna">
        <label>Número de proyectos votables*:</label>
        <input type="number" min=1 value="@NumProy" @onchange="cambioNumProy" />
    </div>
    <div class="campo">
        <label>Permitir Comentarios*:</label>
        <select value="@permiteComentarios" @onchange="cambioPermiteComentarios">
            <option value="1">Sí</option>
            <option value="0">No</option>
        </select>
    </div>
    <div class="campo campo-columna">
        <label>Comentarios Obligatorios*:</label>
        <select value="@comentariosObligatorios" @onchange="cambioComentariosObligatorios" disabled="@(permiteComentarios == 0)"
                title="@(permiteComentarios == 0 ? "No se puede modificar porque no se permiten comentarios" : null)">
            <option value="0">No</option>
            <option value="1">Sí</option>
        </select>
    </div>
    <div class="errores">
        <div><label style="color:red">@mensaje5</label></div>
        <div><label style="color:red">@mensaje3</label></div>
        <div><label style="color:red">@mensaje4</label></div>
        <div><label style="color:red">@mensaje</label></div>
        <div><label style="color:red">@mensaje2</label></div>
    </div>

    <div class="separador-criterios"></div>

    <section class="bloque-criterios">
        <h3 class="titulo-criterios">Criterios</h3>

        <div class="lista-criterios">
            @foreach (var c in criterios)
            {
                <div class="criterio-item">
                    <div class="criterio-texto">
                        <span class="criterio-nombre">@c.Nombre</span>
                        <span class="criterio-descripcion">@c.Descripcion</span>
                    </div>

                    <div class="criterio-acciones">
                        <span class="criterio-descripcion">Peso (%):</span>
                        <input type="text" class="criterio-peso" @bind="c.Peso" />
                        <button type="button" class="boton-secundario" @onclick='() => QuitarCriterio(c.Id)'>Quitar</button>
                    </div>
                </div>
            }
        </div>

        <div><label style="color:black">@mensajeNoCriterio</label></div>

        <div class="criterio-formulario">
            <input type="text" placeholder="Nombre" @bind="nombreCriterio" class="input-criterio" />
            <input type="text" placeholder="Descripción" @bind="descripcionCriterio" class="input-criterio" />
            <button type="button" class="boton-principal" @onclick="GuardarCriterio" >Añadir</button>
        </div>

        <div>
            <div><label style="color:red">@mensajeErrorCriterio</label></div>
        </div>

    </section>

    @if (tipoVotacion != TipoVotacion.Publico)
    {
        <div class="jurado-section">
            <div class="jurado-column">
                <h3>Usuarios disponibles</h3>

                <div class="buscador-jurado">
                    <input type="text"
                           placeholder="Buscar por nombre..."
                           @bind="busquedaUsuario"
                           @bind:event="oninput" />
                    <span>🔍</span>
                </div>

                <div class="lista-jurado">
                    @foreach (var usuario in UsuariosDisponiblesFiltrados)
                    {
                        <div class="fila-jurado">
                            <span>@usuario.Nombre</span>

                            <button type="button"
                                    class="boton-add-jurado"
                                    @onclick="() => AnadirJurado(usuario)">
                                +
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="jurado-column">
                <h3>Miembros del jurado seleccionados</h3>

                <div class="lista-jurado seleccionados">
                    @if (!juradoSeleccionado.Any())
                    {
                        <div class="jurado-vacio">
                            No hay miembros seleccionados
                        </div>
                    }
                    else
                    {
                        @foreach (var usuario in juradoSeleccionado)
                        {
                            <div class="fila-jurado">
                                <span>@usuario.Nombre</span>

                                <button type="button"
                                        class="boton-remove-jurado"
                                        @onclick="() => QuitarJurado(usuario)">
                                    🗑
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    <div class="botones">
        <div>
            <button type="button" class="boton-secundario" @onclick="Cancelar">Cancelar</button>
            <button type="button" class="boton-secundario boton-peligro" @onclick="ConfirmarEliminar">Eliminar Votación</button>
        </div>
        <div>
            <button type="button" class="boton-principal" @onclick="GuardarVotacion">Guardar Cambios</button>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(debugInfo))
    {
        <div style="background:#fff3cd; padding:10px; border-radius:8px; margin-bottom:10px;">
            @debugInfo
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid id { get; set; }
    private string debugInfo = "";
    private Votify.Core.Entities.Votacion votacion;
    private int NumProy = 0;
    private int permiteAutoVoto = 1;
    private int permiteComentarios = 1;
    private int comentariosObligatorios = 0;
    private int numProyAUX = 1;
    private int permiteAutoVotoAUX = 1;
    private int permiteComentariosAUX = 1;
    private int comentariosObligatoriosAUX = 0;
    private DateTime inicioVotacion = DateTime.Now;
    private DateTime finVotacion = DateTime.Now.AddHours(1);
    private DateTime inicioEvento = DateTime.Now;
    private DateTime finEvento = DateTime.Now.AddDays(1);
    private Guid Id_evento = Guid.Empty;
    private TipoVotacion tipoVotacion = TipoVotacion.Publico;
    private string mensaje = "";
    private string mensaje2 = "";
    private string mensaje3 = "";
    private string mensaje4 = "";
    private string mensaje5 = "";
    private string mensaje6 = "";

    private string mensajeErrorCriterio = "";
    private string mensajeNoCriterio = "";
    private string nombreCriterio = "";
    private string descripcionCriterio = "";
    private int pesoCriterio = 0;
    private EstadoVotacion estadoVotacion=0;
    List<Votify.Core.Entities.Evento> eventos = new();
    List<Votify.Core.Entities.Votacion> votaciones = new();
    List<Votify.Core.Entities.DimensionesDeValor> criterios = new();
    private Votify.Core.Entities.Evento? evento;
    private Guid idUsuarioActual = Guid.Empty;
    private int verRes = 1;
    private string busquedaUsuario = "";

    private List<Usuario> usuariosDisponibles = new();
    private List<Usuario> juradoSeleccionado = new();

    private List<Usuario> UsuariosDisponiblesFiltrados =>
        usuariosDisponibles
            .Where(u => !juradoSeleccionado.Any(j => j.Id == u.Id))
            .Where(u =>
                string.IsNullOrWhiteSpace(busquedaUsuario)
                || (u.Nombre ?? "").Contains(busquedaUsuario, StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        eventos = await contexto.Evento.Include(e => e.Categoria).ToListAsync();

        votacion = await contexto.Votacion.FirstOrDefaultAsync(e => e.Id == id);

        if (votacion == null)
            throw new Exception("No existe la votación");

        criterios = await contexto.DimensionesDeValor
            .Where(d => d.Id_votacion == votacion.Id)
            .ToListAsync();

        if (!criterios.Any())
            mensajeNoCriterio = "Esta votación no tiene criterios";

        await SetVotacion(votacion);

        usuariosDisponibles = await contexto.Usuario
            .AsNoTracking()
            .OrderBy(u => u.Nombre)
            .ToListAsync();

        // Obtener el id del rol Jurado
        var idRolJurado = await contexto.Role
            .Where(r => r.Nombre == "Jurado")
            .Select(r => r.Id)
            .FirstOrDefaultAsync();

        // Obtener ids de usuarios jurado en ese evento
        var idsJurado = await contexto.EventoUsuarioRol
            .Where(eur => eur.EventoId == votacion.Id_evento && eur.RolId == idRolJurado)
            .Select(eur => eur.UsuarioId)
            .ToListAsync();

        // Obtener los usuarios completos
        juradoSeleccionado = await contexto.Usuario
            .AsNoTracking()
            .Where(u => idsJurado.Contains(u.Id))
            .OrderBy(u => u.Nombre)
            .ToListAsync();
    }
    private async Task ActualizarEstadosVotaciones()
    {
        var ahora = DateTime.UtcNow;

        var votaciones = await contexto.Votacion.ToListAsync();

        foreach (var votacion in votaciones)
        {
            debugInfo = $"FechaFin: {votacion.FechaFin} | " +
            $"Kind: {votacion.FechaFin.Kind} | " +
            $"Ahora UTC: {DateTime.UtcNow} | " +
            $"Ahora Local: {DateTime.Now}";

            if ((votacion.EstadoVotacion == EstadoVotacion.Abierta ||
                 votacion.EstadoVotacion == EstadoVotacion.Pausada ||
                 votacion.EstadoVotacion == EstadoVotacion.Cerrada) &&
                votacion.FechaFin <= ahora)
            {
                votacion.EstadoVotacion = EstadoVotacion.Finalizada;
            }
            else if (votacion.EstadoVotacion == EstadoVotacion.Cerrada &&
                     votacion.FechaInicio <= ahora)
            {
                votacion.EstadoVotacion = EstadoVotacion.Abierta;
            }

            Console.WriteLine($"Estado después: {votacion.EstadoVotacion}");
        }

        await contexto.SaveChangesAsync();
    }
    public async Task SetVotacion(Votify.Core.Entities.Votacion votacion)
    {
        Id_evento = votacion.Id_evento;
        inicioVotacion = UtcFromDbToLocal(votacion.FechaInicio);
        finVotacion = UtcFromDbToLocal(votacion.FechaFin);
        NumProy = votacion.NumProy;
        permiteAutoVoto = votacion.PermiteAutoVoto ? 1 : 0;
        permiteComentarios = votacion.PermiteComentarios ? 1 : 0;
        comentariosObligatorios = votacion.ComentariosObligatorios ? 1 : 0;
        numProyAUX = NumProy;
        permiteAutoVotoAUX = permiteAutoVoto;
        permiteComentariosAUX = permiteComentarios;
        comentariosObligatoriosAUX = comentariosObligatorios;
        estadoVotacion = votacion.EstadoVotacion;
        verRes = votacion.VerRes ? 1 : 0;

        if (votacion is VotacionPublico)
            tipoVotacion = TipoVotacion.Publico;
        else if (votacion is VotacionJurado)
            tipoVotacion = TipoVotacion.Jurado;
        else if (votacion is VotacionMixta)
            tipoVotacion = TipoVotacion.Mixto;

        evento = await contexto.Evento
            .Include(e => e.Categoria)
            .FirstOrDefaultAsync(e => e.Id == Id_evento);

        if (evento == null) return;

        inicioEvento = evento.FechaInicio;
        finEvento = evento.FechaFin;
    }
    private void cambioNumProy(ChangeEventArgs e)
    {
        int nuevoValor = int.Parse(e.Value.ToString());
        if ((numProyAUX != nuevoValor)) mensaje6 = "Atención, el cambio en el número de proyectos votables no es retroactivo";
        else mensaje6 = "";
        NumProy = nuevoValor;
    }
    private void cambioPermiteAutoVoto(ChangeEventArgs e)
    {
        int nuevoValor = int.Parse(e.Value.ToString());
        if ((permiteAutoVotoAUX != nuevoValor)) mensaje5 = "Atención, el cambio en permitir autovoto no es retroactivo";
        else mensaje5 = "";
        permiteAutoVoto = nuevoValor;
    }
    private static TimeZoneInfo ZonaEspaña()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Europe/Madrid");
        }
        catch
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Romance Standard Time");
        }
    }

    private static DateTime UtcFromDbToLocal(DateTime utc)
    {
        var zona = ZonaEspaña();

        return TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(utc, DateTimeKind.Utc),
            zona
        );
    }

    private static DateTime LocalInputToUtc(DateTime local)
    {
        var zona = ZonaEspaña();

        return TimeZoneInfo.ConvertTimeToUtc(
            DateTime.SpecifyKind(local, DateTimeKind.Unspecified),
            zona
        );
    }
    private void cambioPermiteComentarios(ChangeEventArgs e)
    {
        int nuevoValor = int.Parse(e.Value.ToString());
        if ((permiteComentariosAUX != nuevoValor)) mensaje3 = "Atención, el cambio en permitir comentarios no es retroactivo";
        else mensaje3 = "";
        permiteComentarios = nuevoValor;
        if (permiteComentarios == 0 && comentariosObligatorios == 1) cambioComentariosObligatorios(new ChangeEventArgs { Value = 0 });
    }
    private void cambioComentariosObligatorios(ChangeEventArgs e)
    {
        int nuevoValor = int.Parse(e.Value.ToString());
        if (comentariosObligatoriosAUX != nuevoValor) mensaje4 = "Atención, el cambio en la obligación o no a introducir comentarios no es retroactivo";
        else mensaje4 = "";
        comentariosObligatorios = nuevoValor;
    }
    void SeleccionarTipo(TipoVotacion tipo)
    {
        tipoVotacion = tipo;
    }
    void SeleccionarEstado(EstadoVotacion estado)
    {
        estadoVotacion = estado;
    }
    void VerResultados(int verRes)
    {
        this.verRes = verRes;
    }
    void Cancelar()
    {
        nav.NavigateTo("/GestionarVotaciones");
    }

    private async Task GuardarVotacion()
    {
        try
        {
            votaciones = await contexto.Votacion.ToListAsync();

            bool franjaUsada = false;
            bool tipoUsado = false;

            foreach (var vot in votaciones.Where(v => v.Id != votacion.Id && v.Id_evento == Id_evento))
            {
                if (inicioVotacion.CompareTo(vot.FechaInicio) >= 0 && inicioVotacion.CompareTo(vot.FechaFin) <= 0)
                {
                    franjaUsada = true;
                    break;
                }
                if (
                     (tipoVotacion == TipoVotacion.Publico && vot is VotacionPublico) ||
                     (tipoVotacion == TipoVotacion.Jurado && vot is VotacionJurado) ||
                     (tipoVotacion == TipoVotacion.Mixto && vot is VotacionMixta)
                 )
                {
                    tipoUsado = true;
                    break;
                }
            }
            if (finVotacion.CompareTo(inicioVotacion) <= 0)
            {
                mensaje2 = "El final de la votación debe ser posterior al inicio";
                return;
            }
            if (franjaUsada)
            {
                mensaje = "Hay una votación en esta franja de tiempo, no se permiten votaciones concurrentes";
                return;
            }
            if (tipoUsado)
            {
                mensaje = "Ya hay una votación de este tipo registrada para este evento";
                return;
            }
            if (NumProy <= 0)
            {
                mensaje = "Se tiene que poder votar mínimo 1 proyecto";
                return;
            }

            if (criterios.Sum(c => c.Peso) != 100)
            {
                mensajeErrorCriterio = "La suma de los pesos debe ser 100";
                return;
            }

            var dto = new CrearVotacionDTOs
            {
                Id_evento = Id_evento,
                FechaInicio = LocalInputToUtc(inicioVotacion),
                FechaFin = LocalInputToUtc(finVotacion),
                PermiteAutoVoto = permiteAutoVoto == 1,
                TipoVotacion = tipoVotacion,
                VerRes=verRes==1,
                Num_Proy = NumProy,
                Jurados = juradoSeleccionado.Select(u => u.Id).ToList(),
                EstadoVotacion=estadoVotacion,
                Criterios = criterios.Select(c => new Votify.Core.DTOs.CrearCriterioDTO
                {
                    Id = c.Id,
                    Nombre = c.Nombre,
                    Descripcion = c.Descripcion,
                    Peso = c.Peso
                }).ToList(),
                PermiteComentarios = permiteComentarios == 1,
                ComentariosObligatorios = comentariosObligatorios == 1
            };
            var response = await Http.PutAsJsonAsync($"api/v1/votaciones/{id}", dto);

            if (response.IsSuccessStatusCode)
            {
                nav.NavigateTo("/GestionarVotaciones", forceLoad: true);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensaje = $"No se pudo editar la votación: {error}";
                Console.WriteLine(error);
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
    }
    async Task ConfirmarEliminar()
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Seguro que quieres eliminar esta votación? Esta acción no es reversible");

        if (confirmado)
        {
            await EliminarVotacion();
        }
    }
    async Task EliminarVotacion()
    {
        if (votacion == null)
            return;

        var response = await Http.DeleteAsync($"api/v1/votaciones/{id}");

        if (response.IsSuccessStatusCode)
        {
            nav.NavigateTo("/GestionarVotaciones");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            mensaje = $"No se pudo eliminar la votación: {error}";
        }
    }

    private void GuardarCriterio()
    {
        if(nombreCriterio == "")
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Debes asignar un nombre al criterio";
            return;
        }

        if (descripcionCriterio == "")
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Debes asignar una descripción al criterio";
            return;
        }

        if (criterios.Any(c => c.Nombre == nombreCriterio))
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Ya existe un criterio con ese nombre";
            return;
        }

        criterios.Add(new DimensionesDeValor
        {
            Id = Guid.NewGuid(),
            Id_votacion = votacion.Id,
            Nombre = nombreCriterio,
            Descripcion = descripcionCriterio,
            Peso = 0
        });
        
        nombreCriterio = "";
        descripcionCriterio = "";
        mensajeErrorCriterio = "";
        mensajeNoCriterio = "";
        pesoCriterio = 0;
    }
    
    private void QuitarCriterio(Guid idCriterio)
    {
        criterios.RemoveAll(c => c.Id == idCriterio);
    }

    private void AnadirJurado(Usuario usuario)
    {
        if (!juradoSeleccionado.Any(u => u.Id == usuario.Id))
        {
            juradoSeleccionado.Add(usuario);
        }
    }

    private void QuitarJurado(Usuario usuario)
    {
        juradoSeleccionado.RemoveAll(u => u.Id == usuario.Id);
    }
}
