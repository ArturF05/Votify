@page "/EditarEvento/{id:guid}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using System.Net.Http.Json
@using Votify.Core.Entities
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@using Votify.API.DTOs
@using EventoEntidad = Votify.Core.Entities.Evento
@inject NavigationManager nav
@inject AppDbContext contexto
@inject IJSRuntime JS
@inject HttpClient Http
@inject AzureStorageService azureStorageService
<PageTitle>Editar evento - Votify </PageTitle>
<div class="editar-evento-page">
    <div class="page-header">
        <div>
            <h2 class="page-title">Editar Evento</h2>
        </div>
    </div>

    <div class="form-evento">
        <div class="evento-header">
            <h3>@nombreAntiguo</h3>
        </div>

        <hr class="linea">

        <div class="campo campo-columna">
            <label>Nombre*:</label>
            <input type="text" maxlength="@MaxNombre"
                   value="@nombre"
                   @oninput="OnInputNombre"
                   placeholder="Nombre del evento..." />
            @if (nombre.Length >= MaxNombre)
            {
                <span class="mensaje-limite">⚠️ Límite de @MaxNombre caracteres alcanzado</span>
            }
            else
            {
                <span class="contador">@nombre.Length / @MaxNombre</span>
            }
        </div>

        <div class="form-grid">
            <div class="campo campo-columna">
                <label>Categoría*:</label>
                <select @bind="Id_categoria">
                    @foreach (var cat in categorias)
                    {
                        <option value="@cat.Id">@cat.Nombre</option>
                    }
                </select>
            </div>
            <div class="campo campo-columna">
                <label>Fecha de inicio*:</label>
                <input type="datetime-local" @bind="inicio" />
            </div>

            <div class="campo campo-columna campo-descripcion">
                <label>Descripción:</label>
                <textarea maxlength="@MaxDescripcion"
                          value="@descripcion"
                          @oninput="OnInputDescripcion"
                          placeholder="Descripción..."></textarea>
                @if (descripcion.Length >= MaxDescripcion)
                {
                    <span class="mensaje-limite">⚠️ Límite de @MaxDescripcion caracteres alcanzado</span>
                }
                else
                {
                    <span class="contador">@descripcion.Length / @MaxDescripcion</span>
                }
            </div>

            <div class="campo campo-columna">
                <label>Fecha de cierre*:</label>
                <input type="datetime-local" @bind="fin" />
            </div>
            <div class="campo campo-columna">
                <label>Imagen del evento:</label>
                <InputFile OnChange="OnImagenSeleccionada" accept=".jpg,.jpeg,.png" />
                @if (imagenBytes != null)
                {
                    <p>Nueva imagen: @imagenNombre</p>
                }
            </div>
            <div class="campo campo-columna">
                <label>Imagen antigua:</label>
                @if (evento != null && !string.IsNullOrEmpty(evento.ImagenUrl))
                {
                    <img src="@GetProxyUrl(evento.ImagenUrl)" class="img" />
                }
                else
                {
                    <label class="labelNI">El evento no tenía imagen</label>
                }
                <label>Imagen nueva:</label>
                @if (imagenNueva != null)
                {
                    <img src="@(imagenNueva)" class="img" />
                }
            </div>
        </div>

        <div class="separador-criterios"></div>

        <section class="bloque-criterios">
            <h3 class="titulo-criterios">Categorías de votación del evento</h3>

            <div class="lista-criterios">
                @foreach (var categoria in categoriasEvento)
                {
                    <div class="criterio-item">
                        <div class="criterio-texto">
                            <input type="text" class="input-criterio" placeholder="Nombre de categoría" maxlength="@MaxNombreCategoriaEvento"
                           value="@categoria.Nombre"
                           @oninput="OnInputNombreCategoria" />
                            @if (categoria.Nombre.Length >= MaxNombreCategoriaEvento)
                            {
                                <span class="mensaje-limite">⚠️ Límite de @MaxNombreCategoriaEvento caracteres alcanzado</span>
                            }
                            else
                            {
                                <span class="contador">@categoria.Nombre.Length / @MaxNombreCategoriaEvento</span>
                            }
                            @if (categoria.TieneVotos)
                            {
                                <span class="criterio-descripcion">Tiene votos asociados</span>
                            }
                        </div>
                        <div class="criterio-acciones">
                            <button type="button"
                                    class="boton-secundario"
                                    disabled="@categoria.TieneVotos"
                                    @onclick="() => QuitarCategoriaEvento(categoria.Id)">
                                Quitar
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="criterio-formulario">
                <input type="text" placeholder="Nombre de categoría" @bind="nombreCategoriaEvento" class="input-criterio" />
                <button type="button" class="boton-principal" @onclick="AnadirCategoriaEvento">Añadir categoría</button>
            </div>
        </section>

        <div>
            <div><label style="color:red">@mensaje</label></div>
            <div><label style="color:red">@mensaje2</label></div>
        </div>

        <div class="botones">
            <div class="grupo-botones">
                <button type="button" class="boton-secundario" @onclick="Cancelar">Cancelar cambios</button>
                <button type="button" class="boton-secundario boton-peligro" @onclick="ConfirmarEliminar">Eliminar evento</button>
            </div>

            <div class="grupo-botones">
                <button type="button" class="boton-secundario" @onclick="ArchivarEvento">Archivar</button>
                <button type="button" class="boton-principal" @onclick="GuardarEvento">Guardar cambios</button>
            </div>
        </div>
    </div>
</div>

@code {
    private const int MaxNombre = 50;
    private const int MaxDescripcion = 500;
    private const int MaxNombreCategoriaEvento = 50;

    DateTime inicio = DateTime.Today;
    DateTime fin = DateTime.Today.AddDays(1);

    private EventoEntidad? evento;
    private string nombre = "";
    private string nombreAntiguo = "";
    private Guid Id_categoria = new Guid("0d4e9ac5-56ee-4a5c-817e-ee78bf8a8ed9");
    private string descripcion = "";
    private string mensaje = "";
    private string mensaje2 = "";
    private string tipo = "Hackaton";
    private string nombreCategoriaEvento = "";
    private byte[]? imagenBytes;
    private string? imagenNombre;
    List<Categoria> categorias = new();
    private List<CategoriaEventoForm> categoriasEvento = new();
    private string GetProxyUrl(string url) => $"/api/miniaturas/from-url?url={Uri.EscapeDataString(url)}";
    private string? imagenNueva;
    [Parameter]
    public Guid id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        categorias = await contexto.Categoria.ToListAsync();

        evento = await contexto.Evento.AsNoTracking().Include(e => e.Categoria).FirstOrDefaultAsync(e => e.Id == id);

        if (evento == null)
        {
            mensaje = "No se ha encontrado el evento";
            return;
        }

        SetEvento(evento);
        await CargarCategoriasEvento();
    }

    private async Task CargarCategoriasEvento()
    {
        var categoriasDb = await contexto.CategoriaEvento
            .AsNoTracking()
            .Where(c => c.Id_evento == id)
            .OrderBy(c => c.Nombre)
            .ToListAsync();

        categoriasEvento = new();
        foreach (var categoria in categoriasDb)
        {
            categoriasEvento.Add(new CategoriaEventoForm
            {
                Id = categoria.Id,
                Nombre = categoria.Nombre,
                EsNueva = false,
                TieneVotos = await contexto.Voto.AnyAsync(v => v.Id_categoria == categoria.Id)
            });
        }
    }

    void Cancelar()
    {
        nav.NavigateTo("/Evento");
    }
    private void OnInputNombre(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        nombre = val.Length > MaxNombre ? val[..MaxNombre] : val;
    }
    private void OnInputDescripcion(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        descripcion = val.Length > MaxDescripcion ? val[..MaxDescripcion] : val;
    }
    private void OnInputNombreCategoria(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        nombreCategoriaEvento = val.Length > MaxNombreCategoriaEvento ? val[..MaxNombreCategoriaEvento] : val;
    }
    async Task ArchivarEvento()
    {
        if (evento == null)
            return;

        var response = await Http.PatchAsync($"api/eventos/{evento.Id}/archivo?archivar=true", null);

        if (response.IsSuccessStatusCode)
        {
            nav.NavigateTo("/Evento");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            mensaje = $"No se pudo archivar el evento: {error}";
        }
    }

    async Task ConfirmarEliminar()
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Seguro que quieres eliminar este evento? Esta acción no es reversible");

        if (confirmado)
        {
            await EliminarEvento();
        }
    }

    async Task EliminarEvento()
    {
        if (evento == null)
            return;

        var response = await Http.DeleteAsync($"api/eventos/{evento.Id}");

        if (response.IsSuccessStatusCode)
        {
            await azureStorageService.EliminarArchivoAsync(evento.ImagenUrl);
            nav.NavigateTo("/Evento");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            mensaje = $"No se pudo eliminar el evento: {error}";
        }
    }

    public void SetEvento(EventoEntidad evento)
    {
        nombre = evento.Nombre;
        nombreAntiguo = evento.Nombre;
        Id_categoria = evento.Id_categoria;
        descripcion = evento.Descripcion;
        inicio = evento.FechaInicio;
        fin = evento.FechaFin;
        if (evento is EventoConcurso)
            tipo = "Concurso";
        else
            tipo = "Hackathon";
    }
    private async Task OnImagenSeleccionada(InputFileChangeEventArgs e)
    {
        var file = e.File;
        const long max = 5 * 1024 * 1024;

        if (file.Size > max)
        {
            mensaje = "Imagen demasiado grande";
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLower();
        var permitidas = new[] { ".jpg", ".jpeg", ".png" };

        if (!permitidas.Contains(ext))
        {
            mensaje = "Formato no permitido";
            return;
        }

        imagenNombre = file.Name;

        using var stream = file.OpenReadStream(max);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        imagenBytes = ms.ToArray();
        imagenNueva = $"data:image/png;base64,{Convert.ToBase64String(imagenBytes)}";
    }
    private async Task GuardarEvento()
    {
        if (evento == null)
            return;

        if (Id_categoria == Guid.Empty)
        {
            mensaje = "Error, selecciona la categoría del evento";
            return;
        }

        bool nombreVacio = string.IsNullOrWhiteSpace(nombre);

        if (nombreVacio)
        {
            mensaje = "El nombre del evento es obligatorio";
        }
        else
        {
            mensaje = "";
        }

        if (fin.CompareTo(inicio) <= 0)
        {
            mensaje2 = "La fecha del fin del evento debe ser posterior a la fecha de inicio";
        }
        else
        {
            mensaje2 = "";
        }

        if (!nombreVacio && fin.CompareTo(inicio) > 0)
        {
            var dto = new CrearEventoDTOs
            {
                Nombre = nombre,
                Id_categoria = Id_categoria,
                FechaInicio = inicio,
                Descripcion = descripcion,
                FechaFin = fin,
                Tipo = tipo,
                dTOsVotacion = new List<CrearVotacionDTOs>(),
                ImagenBytes = imagenBytes,
                ImagenNombre = imagenNombre
            };
            bool aux = evento.ImagenUrl == null;
            string? aux2 = evento.ImagenUrl;
            var response = await Http.PutAsJsonAsync($"api/eventos/{evento.Id}", dto);

            if (response.IsSuccessStatusCode)
            {
                await GuardarCategoriasEvento();

                if (imagenBytes != null && !aux)
                {
                    await azureStorageService.EliminarArchivoAsync(aux2);
                }
                nav.NavigateTo("/Evento");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensaje = $"No se pudo editar el evento: {error}";
            }
        }
    }

    private void AnadirCategoriaEvento()
    {
        if (string.IsNullOrWhiteSpace(nombreCategoriaEvento))
        {
            mensaje = "El nombre de la categoría es obligatorio";
            return;
        }

        if (categoriasEvento.Any(c => c.Nombre.Equals(nombreCategoriaEvento.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            mensaje = "Ya existe una categoría con ese nombre en el evento";
            return;
        }

        categoriasEvento.Add(new CategoriaEventoForm
        {
            Id = Guid.NewGuid(),
            Nombre = nombreCategoriaEvento.Trim(),
            EsNueva = true
        });

        nombreCategoriaEvento = "";
        mensaje = "";
    }

    private void QuitarCategoriaEvento(Guid idCategoria)
    {
        var categoria = categoriasEvento.FirstOrDefault(c => c.Id == idCategoria);
        if (categoria == null)
            return;

        if (categoria.TieneVotos)
        {
            mensaje = "No se puede eliminar una categoría que ya tiene votos asociados";
            return;
        }

        categoriasEvento.Remove(categoria);
    }

    private async Task GuardarCategoriasEvento()
    {
        var categoriasDb = await contexto.CategoriaEvento
            .Where(c => c.Id_evento == id)
            .ToListAsync();

        foreach (var categoriaForm in categoriasEvento)
        {
            var categoriaDb = categoriasDb.FirstOrDefault(c => c.Id == categoriaForm.Id);

            if (categoriaDb == null)
            {
                await contexto.CategoriaEvento.AddAsync(new CategoriaEvento
                {
                    Id = categoriaForm.Id,
                    Id_evento = id,
                    Nombre = categoriaForm.Nombre.Trim()
                });
            }
            else
            {
                categoriaDb.Nombre = categoriaForm.Nombre.Trim();
            }
        }

        var idsFormulario = categoriasEvento.Select(c => c.Id).ToHashSet();
        var categoriasABorrar = categoriasDb.Where(c => !idsFormulario.Contains(c.Id)).ToList();

        foreach (var categoria in categoriasABorrar)
        {
            var tieneVotos = await contexto.Voto.AnyAsync(v => v.Id_categoria == categoria.Id);
            if (tieneVotos)
                throw new Exception($"No se puede eliminar la categoría {categoria.Nombre} porque ya tiene votos asociados.");

            contexto.CategoriaEvento.Remove(categoria);
        }

        await contexto.SaveChangesAsync();
    }

    class CategoriaEventoForm
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = "";
        public bool EsNueva { get; set; }
        public bool TieneVotos { get; set; }
    }
}
