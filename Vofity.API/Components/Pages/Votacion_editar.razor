@page "/EditarVotacion/{id:guid}"
@rendermode InteractiveServer 
@using Microsoft.EntityFrameworkCore
@using Votify.Core.Entities
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@using Votify.Infrastructure.Repositorios
@using Votify.API.DTOs
@using System.Net.Http.Json
@inject NavigationManager nav
@inject AppDbContext contexto
@inject HttpClient Http
@inject IJSRuntime JS

<div class="form-evento">
    <h3>Editar votación</h3>
    <hr class="linea">
    <div class="campo">
        <label>Evento de la votación*: </label>
        <select @bind="Id_evento" disabled>
            <option value="@Guid.Empty"></option>
            @foreach (var evento in eventos.Where(e => e.FechaFin.CompareTo(DateTime.Now)>=0))
            {
                <option value="@evento.Id">@evento.Nombre</option>
            }
        </select>
    </div>
    <div class="labels">
        <label>Inicio del evento: @inicioEvento    </label>
        <label>Fin del evento: @finEvento</label>
    </div>
    <hr>
    <label>Tipo de votación*:</label>
    <div class="grupo-botones-votacion">
        <button type="button"
                class="boton-votacion @(tipoVotacion == TipoVotacion.Publico ? "activo" : "")"
                @onclick='() => SeleccionarTipo(TipoVotacion.Publico)'>
            Público
        </button>

        <button type="button"
                class="boton-votacion @(tipoVotacion == TipoVotacion.Jurado ? "activo" : "")"
                @onclick='() => SeleccionarTipo(TipoVotacion.Jurado)'>
            Jurado
        </button>

        <button type="button"
                class="boton-votacion @(tipoVotacion == TipoVotacion.Mixto ? "activo" : "")"
                @onclick='() => SeleccionarTipo(TipoVotacion.Mixto)'>
            Mixto
        </button>
    </div>
    <div class="campo">
        <label>Permitir Autovoto*:</label>
        <select @bind-value="permiteAutoVoto" @bind-value:event="onchange">
            <option value="1">Sí</option>
            <option value="0">No</option>
        </select>
    </div>

    <div class="campo">
        <label>Inicio de la votación*:</label>
        <input type="datetime-local" @bind-value="inicioVotacion" @bind-value:event="onchange" />
    </div>
    <div class="campo">
        <label>Fin de la votación*:</label>
        <input type="datetime-local" @bind-value="finVotacion" @bind-value:event="onchange" />
    </div>

    <div class="errores">
        <div><label style="color:red">@mensaje</label></div>
        <div><label style="color:red">@mensaje2</label></div>
    </div>

    <div class="botones">
        <div>
            <button type="button" class="boton-secundario" @onclick="Cancelar">Cancelar</button>
            <button type="button" class="boton-secundario boton-peligro" @onclick="ConfirmarEliminar">Eliminar Votación</button>
        </div>
        <div>
            <button type="button" class="boton-principal" @onclick="GuardarVotacion">Guardar Cambios</button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid id { get; set; }
    private Votify.Core.Entities.Votacion votacion;

    private int permiteAutoVoto = 1;
    private DateTime inicioVotacion = DateTime.Now;
    private DateTime finVotacion = DateTime.Now.AddHours(1);
    private DateTime inicioEvento = DateTime.Now;
    private DateTime finEvento = DateTime.Now.AddDays(1);
    private Guid Id_evento = Guid.Empty;
    private TipoVotacion tipoVotacion = TipoVotacion.Publico;
    private string mensaje = "";
    private string mensaje2 = "";
    List<Votify.Core.Entities.Evento> eventos = new();
    List<Votify.Core.Entities.Votacion> votaciones = new();
    private Votify.Core.Entities.Evento? evento;
    protected override async Task OnInitializedAsync()
    {
        eventos = await contexto.Evento.Include(e => e.Categoria).ToListAsync();
        votacion = await contexto.Votacion.Include(e => e.Evento).FirstOrDefaultAsync(e => e.Id == id);
        if (votacion == null) throw new Exception("No existe la votación");
        await SetVotacion(votacion);
    }
    public async Task SetVotacion(Votify.Core.Entities.Votacion votacion)
    {
        Id_evento = votacion.Id_evento;
        inicioVotacion = votacion.FechaInicio.ToLocalTime();
        finVotacion = votacion.FechaFin.ToLocalTime();
        tipoVotacion = votacion.TipoVotacion;
        if (votacion.PermiteAutoVoto) permiteAutoVoto = 1;
        else permiteAutoVoto = 0;
        evento = await contexto.Evento.Include(e => e.Categoria).FirstOrDefaultAsync(e => e.Id == Id_evento);
        if (evento == null) return;
        inicioEvento = evento.FechaInicio;
        finEvento = evento.FechaFin;

    }

    void SeleccionarTipo(TipoVotacion tipo)
    {
        tipoVotacion = tipo;
    }
    void Cancelar()
    {
        nav.NavigateTo("/GestionarVotaciones");
    }

    private async Task GuardarVotacion()
    {
        try
        {
            votaciones = await contexto.Votacion.ToListAsync();

            bool franjaUsada = false;
            bool tipoUsado = false;

            foreach (var vot in votaciones.Where(v => v.Id != votacion.Id && v.Id_evento == Id_evento))
            {
                if (inicioVotacion.CompareTo(vot.FechaInicio) >= 0 && inicioVotacion.CompareTo(vot.FechaFin) <= 0)
                {
                    franjaUsada = true;
                    break;
                }
                if (tipoVotacion == vot.TipoVotacion)
                {
                    tipoUsado = true;
                    break;
                }
            }
            if (finVotacion.CompareTo(inicioVotacion) <= 0)
            {
                mensaje2 = "El final de la votación debe ser posterior al inicio";
                return;
            }
            if (franjaUsada)
            {
                mensaje = "Hay una votación en esta franja de tiempo, no se permiten votaciones concurrentes";
                return;
            }
            if (tipoUsado)
            {
                mensaje = "Ya hay una votación de este tipo registrada para este evento";
                return;
            }

            var dto = new CrearVotacionDTOs
            {
                Id_evento = Id_evento,
                FechaInicio = inicioVotacion,
                FechaFin = finVotacion,
                PermiteAutoVoto = permiteAutoVoto == 1,
                TipoVotacion = tipoVotacion
            };
            var response = await Http.PutAsJsonAsync($"api/v1/votaciones/{votacion.Id}", dto);

            if (response.IsSuccessStatusCode)
            {
                nav.NavigateTo("/GestionarVotaciones", forceLoad: true);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensaje = $"No se pudo editar la votación: {error}";
                Console.WriteLine(error);
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
    }
    async Task ConfirmarEliminar()
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Seguro que quieres eliminar esta votación? Esta acción no es reversible");

        if (confirmado)
        {
            await EliminarVotacion();
        }
    }
    async Task EliminarVotacion()
    {
        if (votacion == null)
            return;

        var response = await Http.DeleteAsync($"api/Votacion/{votacion.Id}");

        if (response.IsSuccessStatusCode)
        {
            nav.NavigateTo("/GestionarVotaciones");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            mensaje = $"No se pudo eliminar la votación: {error}";
        }
    }
}
