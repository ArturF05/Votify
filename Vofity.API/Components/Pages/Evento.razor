@page "/Evento"
<h3>Eventos</h3>

<style>
    body {
        min-width: 1120px;
        min-height: 600px;
    }
</style>

<PageTitle>Evento</PageTitle>
<div style="display:flex; justify-content:space-between; gap:15px">
    <input type="text" placeholder="Buscar eventos..." style="flex:1; height:35px" />
    <select style="height:35px">
        <option>Hackaton</option>
        <option>Futbolín</option>
    </select>
    <button @onclick='() => BuscarEventos()'>Buscar</button>
</div>

<div style="display:flex; justify-content:space-between; gap:15px">
    <table style="border-collapse:separate; border-spacing:15px; flex:1">
        <thread>
            <tr>
                <th>Evento</th>
                <th>Categoría</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Editar</th>
            </tr>
        </thread>
        <tbody>
            <tr>
                <td>Pequeños Informáticos</td>
                <td>Hackaton</td>
                <td>13/12/2006</td>
                <td>14/12/2006</td>
                <td><button @onclick='() => EditarEvento()'>Editar</button></td>
            </tr>
            <tr>
                <td>Torneo de futbolín</td>
                <td>Futbolín</td>
                <td>13/02/2006</td>
                <td>14/02/2006</td>
                <td><button @onclick='() => EditarEvento()'>Editar</button></td>
            </tr>
        </tbody>
    </table>
</div>

<div style="border:1px solid black; padding:15px">
    <h3 style="font-size:large">Crear o editar evento</h3>
    <hr style="height:3px; background-color:black; border:none">
    <div style="display:flex; justify-content:space-between; gap:15px">
        <label>Título:</label>
        <input type="text" placeholder="Título del evento..." style="flex:1; height:35px" />
    </div>
    <br>
    <div style ="display:flex; justify-content:space-between; gap:15px">
        <div>
            <label>Categoría:</label>
            <select style="height:35px">
                <option>Hackaton</option>
                <option>Futbolín</option>
            </select>
        </div>
        <div>
            <label>Fecha de inicio:</label>
            <input type="date" @bind="fechaAct" />
        </div>
    </div>
    <br>
    <div style="display:flex; justify-content:space-between; gap:15px">
        <div>
            <label style="vertical-align: top">Descripción:</label>
            <textarea placeholder="Descripción..." style="width:400px; height:70px" />
        </div>
        <div>
            <label style="vertical-align: top">Fecha de cierre:</label>
            <input type="date" style="vertical-align: top" @bind="fechaMañana" />
        </div>
    </div>
    <br>
    <div style="display:flex; justify-content:space-between; gap:15px">
        <div>
            <button @onclick='() => EliminarEvento()'>Eliminar</button>
        </div>
        <div>
            <button @onclick='() => ArchivarEvento()'>Archivar</button>
            <button @onclick='() => CrearEvento()'>Crear Evento</button>
        </div>
    </div>
</div>

