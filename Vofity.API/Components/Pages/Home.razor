@page "/Home"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Votify.Infrastructure.Data
@inject AppDbContext contexto
@inject HttpClient Http
@inject ProtectedSessionStorage sessionStorage
@inject NavigationManager nav

<div class="page">

    <div class="header">
        <h1>Home</h1>
        <p>Gestiona tus eventos y descubre nuevos</p>
    </div>

    <div class="section">
        <h2>Tus eventos</h2>
        <div class="participando-list">
            @foreach (var evento in eventosParticipando)
            {
                <div class="item">
                    <span>@evento.Nombre</span>
                    <button class="btn" @onclick='() => Desapuntarse(evento.Id)'>Desapuntarme</button>
                </div>
            }
        </div>
    </div>

    <div class="section">
        <h2>Eventos a los que unirte</h2>

        <div class="grid">
            @foreach (var evento in eventosDisponibles)
            {
                <div class="card">
                    <div class="card-title">@evento.Nombre</div>
                    <div class="card-desc">@evento.Descripcion</div>
                    <div class="card-dates">Inicio: @evento.FechaInicio · Fin: @evento.FechaFin</div>
                    <button class="btn" @onclick='() => Apuntarse(evento.Id)'>Apuntarme</button>
                </div>
            }
        </div>
    </div>
    <div>
        <label>@mensaje</label>
    </div>
</div>

@code {
    List<Votify.Core.Entities.Evento> eventos = new();
    List<Votify.Core.Entities.Evento> eventosParticipando = new();
    List<Votify.Core.Entities.Evento> eventosDisponibles = new();

    private string mensaje = "";
    private Guid idUsuario;
    private Votify.Core.Entities.Usuario? usuarioActual;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var resultado = await sessionStorage.GetAsync<Guid>("IdUsuario");

            if (!resultado.Success || resultado.Value == Guid.Empty)
            {
                nav.NavigateTo("/Login");
                return;
            }

            idUsuario = resultado.Value;

            usuarioActual = await contexto.Usuario
                .Include(u => u.Rol)
                .FirstOrDefaultAsync(u => u.Id == idUsuario);

            if (usuarioActual == null)
            {
                nav.NavigateTo("/Login");
                return;
            }

            eventos = await contexto.Evento
                .AsNoTracking()
                .Include(e => e.Categoria)
                .ToListAsync();

            var eventosUsuarioIds = await contexto.EventoUsuarioRol
                .Where(eur => eur.UsuarioId == idUsuario)
                .Select(eur => eur.EventoId)
                .ToListAsync();

            eventosParticipando = eventos
                .Where(e => eventosUsuarioIds.Contains(e.Id))
                .ToList();

            eventosDisponibles = eventos
                .Where(e => !eventosUsuarioIds.Contains(e.Id))
                .ToList();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            mensaje = $"Error cargando Home: {ex.Message}";
            Console.WriteLine($"[HOME ERROR] {ex}");
        }
    }

    private async Task Apuntarse(Guid eventoId)
    {
        try
        {
            if (idUsuario == Guid.Empty)
            {
                mensaje = "No hay sesión.";
                return;
            }

            var respuesta = await Http.PatchAsync(
                $"api/eventos/{eventoId}/apuntarse?usuarioId={idUsuario}&apuntar=true",
                new StringContent(""));

            if (respuesta.IsSuccessStatusCode)
            {
                var evento = eventosDisponibles.FirstOrDefault(e => e.Id == eventoId);

                if (evento != null)
                {
                    eventosDisponibles.Remove(evento);
                    eventosParticipando.Add(evento);
                }

                StateHasChanged();
            }
            else
            {
                mensaje = "No se pudo realizar la inscripción en el evento.";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al apuntarse: {ex.Message}";
        }
    }

    private async Task Desapuntarse(Guid eventoId)
    {
        try
        {
            if (idUsuario == Guid.Empty)
            {
                mensaje = "No hay sesión.";
                return;
            }

            var respuesta = await Http.PatchAsync(
                $"api/eventos/{eventoId}/apuntarse?usuarioId={idUsuario}&apuntar=false",
                new StringContent(""));

            if (respuesta.IsSuccessStatusCode)
            {
                var evento = eventosParticipando.FirstOrDefault(e => e.Id == eventoId);

                if (evento != null)
                {
                    eventosParticipando.Remove(evento);
                    eventosDisponibles.Add(evento);
                }

                StateHasChanged();
            }
            else
            {
                mensaje = "No se pudo cancelar la inscripción en el evento.";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error al desapuntarse: {ex.Message}";
        }
    }
}