@page "/Dashboard/{id:guid}"
@rendermode InteractiveServer
@using Votify.Core.DTOs
@inject HttpClient Http
@inject IJSRuntime JS

<div class="dashboard-container">

    @if (dashboard == null)
    {
        <div class="loading-container" role="status">
            <div class="loading-spinner"></div>
            <p class="cargando">Cargando resultados...</p>
        </div>
    }
    else
    {
        <header class="topbar">
            <div class="title">
                <h1>Dashboard de Resultados</h1>
                <p class="subtitle">@dashboard.NombreEvento</p>
            </div>

            <button class="back-button" @onclick="Volver" aria-label="Volver atras">
                <span class="icon">&#8592;</span> Volver
            </button>
        </header>

        @if (Top3.Any())
        {
            <section class="podium-section">
                <h3 class="section-title">
                    <span class="title-icon">&#127942;</span>
                    Podio de Ganadores
                </h3>

                <div class="podium-container">

                    @if (Top3.Count > 1)
                    {
                        <div class="podium-item">
                            <span class="rank-badge silver">2</span>
                            <div class="podium-bar silver-bar">
                                <h4>@Top3[1].TituloProyecto</h4>
                                <div class="score">@Top3[1].PuntuacionTotal pts</div>
                            </div>
                        </div>
                    }

                    @if (Top3.Count > 0)
                    {
                        <div class="podium-item first-place">
                            <span class="rank-badge gold">1</span>
                            <div class="podium-bar gold-bar">
                                <span class="winner-crown">&#128081;</span>
                                <h4>@Top3[0].TituloProyecto</h4>
                                <div class="score">@Top3[0].PuntuacionTotal pts</div>
                            </div>
                        </div>
                    }

                    @if (Top3.Count > 2)
                    {
                        <div class="podium-item">
                            <span class="rank-badge bronze">3</span>
                            <div class="podium-bar bronze-bar">
                                <h4>@Top3[2].TituloProyecto</h4>
                                <div class="score">@Top3[2].PuntuacionTotal pts</div>
                            </div>
                        </div>
                    }

                </div>
            </section>
        }

        <div class="dashboard-grid">
            @if (dashboard.Criterios?.Any() == true)
            {
                <section class="criterios-section">
                    <h3 class="section-title">
                        <span class="title-icon">&#9881;</span>
                        Criterios de Votacion
                    </h3>
                    <div class="criterios-grid">
                        @foreach (var c in dashboard.Criterios)
                        {
                            <div class="criterio-card">
                                <div class="criterio-header">
                                    <strong class="criterio-nombre">@c.Nombre</strong>
                                    <span class="criterio-peso-badge">@c.Peso%</span>
                                </div>
                                @if (!string.IsNullOrEmpty(c.Descripcion))
                                {
                                    <p class="criterio-descripcion">@c.Descripcion</p>
                                }
                                <div class="criterio-barra-container">
                                    <div class="criterio-barra" style="width: @(c.Peso)%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            <section class="ranking-section">
                <h3 class="section-title">
                    <span class="title-icon">&#128202;</span>
                    Ranking Completo
                </h3>
                <div class="ranking-list">
                    @foreach (var (proyecto, index) in Ranking.Select((p, i) => (p, i)))
                    {
                        <div class="dashboard-ranking-row @GetRankingRowClass(index)">
                            <span class="ranking-position @GetPositionClass(index)">@(index + 1)</span>
                            <span class="dashboard-ranking-name">@proyecto.TituloProyecto</span>
                            <span class="dashboard-ranking-score">@proyecto.PuntuacionTotal <strong>pts</strong></span>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="feedback-sintesis-grid">

            <section class="comentarios-section">
                <h3 class="section-title">
                    <span class="title-icon">&#128172;</span>
                    Feedback de Proyectos
                </h3>

                <div class="selector-wrapper">
                    <label for="proyecto-select">Ver comentarios de:</label>
                    <select id="proyecto-select"
                            value="@proyectoSeleccionadoId"
                            @onchange="OnProyectoChanged">
                        @foreach (var p in Ranking)
                        {
                            <option value="@p.ProyectoId">@p.TituloProyecto</option>
                        }
                    </select>
                </div>

                <div class="lista-comentarios">
                    @if (ProyectoSeleccionado?.Criterios?.Any(c => c.Comentarios.Any()) == true)
                    {
                        @foreach (var criterio in ProyectoSeleccionado.Criterios)
                        {
                            <div class="criterio-feedback-card">
                                <div class="criterio-feedback-header">
                                    <div>
                                        <strong>@criterio.Nombre</strong>
                                        <span>@criterio.PuntuacionMedia.ToString("0.##") / 10 media</span>
                                    </div>
                                    <span class="criterio-peso-badge">@criterio.Peso%</span>
                                </div>

                                @if (criterio.Comentarios.Any())
                                {
                                    @foreach (var comentario in criterio.Comentarios)
                                    {
                                        <div class="comentario-card">
                                            <span class="comentario-icon">&#128100;</span>
                                            <p>@comentario</p>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="comentario-vacio">No hay comentarios para este criterio.</p>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <span class="empty-icon">&#128172;</span>
                            <p>No hay comentarios para mostrar.</p>
                        </div>
                    }
                </div>
            </section>

            <section class="sintesis-ia-section">
                <h3 class="section-title">
                    <span class="title-icon sintesis-icon">&#10024;</span>
                    Síntesis de Comentarios (IA)
                </h3>

                <div class="sintesis-ia-card">
                    @if (!string.IsNullOrWhiteSpace(mensajeSintesis))
                    {
                        <p class="comentario-vacio">@mensajeSintesis</p>
                    }
                    else if (sintesisIA == null)
                    {
                        <p class="comentario-vacio">Generando una síntesis...</p>
                    }
                    else
                    {
                        <p>@sintesisIA.sintesis</p>
                    }
                </div>
            </section>

        </div>
    }
</div>

@code {
    [Parameter] public Guid id { get; set; }

    private DashboardEventoDTO? dashboard;
    private Guid proyectoSeleccionadoId;

    private List<ProyectoDashboardDTO> Ranking => dashboard?.Proyectos?
        .OrderByDescending(p => p.PuntuacionTotal)
        .ToList() ?? new();

    private List<ProyectoDashboardDTO> Top3 => Ranking.Take(3).ToList();

    private ProyectoDashboardDTO? ProyectoSeleccionado => Ranking
        .FirstOrDefault(p => p.ProyectoId == proyectoSeleccionadoId);

    private SintesisIAResultadoDTO? sintesisIA;
    private string mensajeSintesis = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            dashboard = await Http.GetFromJsonAsync<DashboardEventoDTO>($"api/eventos/{id}/dashboard");

            if (dashboard?.Proyectos?.Any() == true)
            {
                proyectoSeleccionadoId = dashboard.ProyectoGanadorId != Guid.Empty
                    ? dashboard.ProyectoGanadorId
                    : Ranking.First().ProyectoId;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar el dashboard: {ex.Message}");
        }
    }

    private string GetRankingRowClass(int index) => index switch
    {
        0 => "ranking-gold",
        1 => "ranking-silver",
        2 => "ranking-bronze",
        _ => ""
    };

    private string GetPositionClass(int index) => index switch
    {
        0 => "position-gold",
        1 => "position-silver",
        2 => "position-bronze",
        _ => ""
    };

    private async Task Volver() => await JS.InvokeVoidAsync("history.back");

    private async Task OnProyectoChanged(ChangeEventArgs e)
    {
        proyectoSeleccionadoId = Guid.Parse(e.Value.ToString());

        await CargarSintesisIA(proyectoSeleccionadoId);
    }

    private async Task CargarSintesisIA(Guid idProyecto)
    {
        sintesisIA = null;
        mensajeSintesis = "";

        try
        {
            sintesisIA = await Http.GetFromJsonAsync<SintesisIAResultadoDTO>(
                $"api/v1/proyecto/{idProyecto}/sintesis-ia"
            );
        }
        catch (Exception ex)
        {
            mensajeSintesis = $"No se pudo generar la síntesis con IA: {ex.Message}";
        }
    }
}
