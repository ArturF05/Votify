@page "/Evento"
@using Microsoft.EntityFrameworkCore
@using Votify.Core.Entities
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@using Votify.Infrastructure.Repositorios
@inject NavigationManager nav;
@inject AppDbContext contexto
@rendermode InteractiveServer
<div class="titulo-y-archivados">
    <h2 class="titulo">Eventos</h2>
    <button class="boton-archivados" @onclick="VerArchivados">Archivados <img src="/Archivados.png" alt="Símbolo Archivados" class="archivados-img" /> </button>
</div>

<PageTitle>Evento</PageTitle>
<div class="barra-busqueda">
    <input @bind="busqueda" @bind:event="oninput" type="text" placeholder="Buscar eventos..." @onkeypress="(e) => EsEnter(e)" />
    <label style="vertical-align:text-bottom">Categoria: </label>
    <select @bind="Id_Categoria">
        <option value="@Guid.Empty">Todas</option>
        @foreach (var cat in categorias)
        {
            <option value="@cat.Id">@cat.Nombre</option>
        }
    </select>
    <button @onclick='() => BuscarEventos()'>Buscar</button>
</div>

<div>
    <table class="tabla-eventos">
        <thead>
            <tr>
                <th>Evento</th>
                <th>Categoría</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Editar</th>
                <th>Archivar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var evento in eventos.Where(e => e.Archivado == false))
            {
            <tr>
                <td>@evento.Nombre</td>
                <td>@evento.Categoria.Nombre</td>
                <td>@evento.FechaInicio</td>
                <td>@evento.FechaFin</td>
                <td><button class="boton-editar" @onclick='() => EditarEvento(evento)'>Editar</button></td>
                <td><button class="boton-editar" @onclick="() => Archivar(evento)">Archivar</button></td>
            </tr>
            }
        </tbody>
        <label> @noHayResultados </label>
    </table>
</div>
<a href="/CrearEvento" class="botonLink">Crear Evento</a>

@code {
    List<Votify.Core.Entities.Evento> eventos = new();
    List<Votify.Core.Entities.Evento> eventosEncontrados = new();
    private EventoRepository eventoRepository;
    private EventoService eventoService;
    private string busqueda;
    private Guid Id_Categoria = Guid.Empty;
    List<Categoria> categorias = new();
    private string noHayResultados = "";

    protected override async Task OnInitializedAsync()
    {
        eventos = await contexto.Evento.Include(e => e.Categoria).ToListAsync();
        categorias = await contexto.Categoria.ToListAsync();
        iniciarServicio();
        hayEventos();
    }
    private void iniciarServicio()
    {
        eventoRepository = new EventoRepository(contexto);
        eventoService = new EventoService(eventoRepository);
    }
    private void EsEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") BuscarEventos();
    }

    async void BuscarEventos()
    {
        if (string.IsNullOrEmpty(busqueda) && Id_Categoria == Guid.Empty)
        {
            eventos = await contexto.Evento.Include(e => e.Categoria).ToListAsync();
            noHayResultados = "";
            if (eventos.Count == 0) noHayResultados = "No se han encontrado resultados";
        } else {
            if (busqueda == null) busqueda = "";
            eventosEncontrados = await eventoService.BuscarEvento(busqueda, Id_Categoria);
            eventos = eventosEncontrados;
            if (eventos == null || eventos.Count == 0) noHayResultados = "No se han encontrado resultados para la búsqueda realizada";
            else noHayResultados = "";
        }
        StateHasChanged();
        iniciarServicio();
    }

    void EditarEvento(Votify.Core.Entities.Evento evento)
    {
        nav.NavigateTo($"/EditarEvento/{evento.Id}");
    }
    void VerArchivados()
    {
        nav.NavigateTo("/EventosArchivados");
    }
    private async void Archivar(Votify.Core.Entities.Evento evento)
    {
        await eventoService.Archivo(evento, true);
        hayEventos();
        StateHasChanged();
    }
    void hayEventos()
    {
        if (eventos.Where(e => e.Archivado == false).Count() == 0) noHayResultados = "No hay eventos";
    }
}