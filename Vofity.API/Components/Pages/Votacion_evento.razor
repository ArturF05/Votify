@page "/Votacion_evento/{id:guid}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Votify.Core.DTOs
@using Votify.Core.Entities
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@using Votify.Infrastructure.Repositorios
@using Votify.Core.Interfaces
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@inject IJSRuntime JS
@inject NavigationManager nav;
@inject AppDbContext contexto
@inject HttpClient Http
@inject ProtectedSessionStorage sessionStorage
@inject IVotacion VotacionService
@inject IPremio PremioService
@inject UsuarioSesion usuarioSesion


<style>
    ﻿.votacion-evento-page {
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: 34px;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .titulo {
        font-size: 2rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
    }

    .subtitulo {
        color: #6b7280;
        margin-top: 0.4rem;
        font-size: 0.95rem;
    }

    .estado-card {
        background: #ffffff;
        border-radius: 1.25rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        border: 1px solid #f1ebe3;
        padding: 1.5rem;
    }

    .proyecto-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
    }

    .proyecto-card {
        background: #ffffff;
        border-radius: 1.25rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        border: 1px solid #f1ebe3;
        min-height: 180px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.25s ease;
    }

        .proyecto-card.deshabilitado {
            opacity: 0.6;
            pointer-events: none;
        }

        .proyecto-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 50px rgba(245, 166, 35, 0.22);
            border-color: #f28c28;
        }

        .proyecto-card.deshabilitado:hover {
            transform: none;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        }

    .proyecto-top {
        display: flex;
        justify-content: flex-end;
    }

    .boton-favorito {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        width: 44px;
        height: 44px;
        border-radius: 999px;
        cursor: pointer;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        transition: all 0.2s ease;
    }

        .boton-favorito:hover {
            background: #f28c28;
            border-color: #f28c28;
        }

            .boton-favorito:hover img {
                transform: scale(1.08);
            }

        .boton-favorito:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .estrella-img {
        width: 22px;
        height: 22px;
        object-fit: contain;
        transition: transform 0.2s ease;
    }

    .proyecto-header {
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        flex: 1;
        padding: 0.5rem;
    }

    .proyecto-nombre {
        font-size: 1.15rem;
        font-weight: 700;
        color: #1a1a1a;
        line-height: 1.35;
    }

    .materiales-proyecto {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
        margin-top: 0.85rem;
    }

    .material-link {
        display: inline-flex;
        align-items: center;
        max-width: 100%;
        border: 1px solid #e7d7c8;
        border-radius: 10px;
        background: #fffaf4;
        color: #7a4b12;
        padding: 0.5rem 0.65rem;
        font-size: 0.82rem;
        font-weight: 700;
        text-decoration: none;
        line-height: 1.15;
        transition: all 0.2s ease;
    }

        .material-link:hover {
            background: #f28c28;
            border-color: #f28c28;
            color: white;
        }

    .material-texto {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .material-imagen {
        background: #f0f9ff;
        border-color: #bae6fd;
        color: #0369a1;
    }

    .material-video {
        background: #fef2f2;
        border-color: #fecaca;
        color: #b91c1c;
    }

    .material-enlace {
        background: #f0fdf4;
        border-color: #bbf7d0;
        color: #166534;
    }

    .acciones {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 2rem;
        flex-wrap: wrap;
    }

    .acciones-izquierda,
    .acciones-derecha {
        display: flex;
        gap: 0.85rem;
        flex-wrap: wrap;
    }

    .boton-principal {
        background: linear-gradient(135deg, #F5A623 0%, #FF8C00 100%);
        color: white;
        border: none;
        padding: 0.9rem 1.35rem;
        border-radius: 12px;
        cursor: pointer;
        font-size: 0.95rem;
        font-weight: 600;
        transition: all 0.25s ease;
        box-shadow: 0 4px 15px -3px rgba(245, 166, 35, 0.45);
    }

        .boton-principal:hover {
            transform: none;
            box-shadow: 0 12px 30px -5px rgba(245, 166, 35, 0.5);
        }

        .boton-principal:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            box-shadow: none;
        }

    .boton-secundario {
        background: #ffffff;
        border: 1px solid #f28c28;
        color: #f28c28;
        padding: 0.9rem 1.2rem;
        border-radius: 12px;
        cursor: pointer;
        font-size: 0.95rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .boton-volver {
        background-color: #F28C2F;
        color: white;
        padding: 6px 14px;
        border-radius: 5px;
        margin-top: 20px;
    }

    .texto-error {
        margin-top: 10px;
        color: red;
    }

    .boton-secundario:hover {
        background: #f28c28;
        color: white;
    }

    .mensaje-estado {
        margin-top: 1rem;
        padding: 1rem;
        border-radius: 12px;
        background: #fff7ed;
        color: #c56d00;
        border: 1px solid #fed7aa;
        font-weight: 500;
    }

    .premios-votacion {
        margin-top: 1rem;
        padding: 1rem;
        border: 1px solid #fed7aa;
        border-radius: 12px;
        background: #fffaf4;
    }

    .premios-votacion h3 {
        margin: 0 0 0.7rem;
        font-size: 1rem;
        color: #7a4b12;
    }

    .premios-lista-voto {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 0.75rem;
    }

    .premio-item {
        display: grid;
        grid-template-columns: 54px minmax(0, 1fr);
        align-items: center;
        gap: 0.65rem;
        border: 1px solid #fed7aa;
        border-radius: 12px;
        background: #ffffff;
        color: #7a4b12;
        padding: 0.55rem;
        font-size: 0.86rem;
        font-weight: 700;
    }

    .premio-item img,
    .premio-foto-placeholder {
        width: 54px;
        height: 54px;
        border-radius: 10px;
        object-fit: cover;
        background: #fff7ed;
        border: 1px solid #fed7aa;
    }

    .premio-foto-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #c56d00;
    }

    .premio-item strong,
    .premio-item span {
        display: block;
    }

    .premio-item span {
        margin-top: 0.15rem;
        color: #8a5a1f;
        font-size: 0.78rem;
        font-weight: 500;
    }

    .criterios-proyecto {
        margin-top: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

    .linea-criterios {
        border: none;
        border-top: 1px solid #ece2d8;
        margin: 0.25rem 0 0.2rem 0;
    }

    .criterio-fila {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.8rem;
        background: #fcfbfa;
        border: 1px solid #eee3d8;
        border-radius: 14px;
        padding: 0.7rem 0.8rem;
    }

    .criterio-voto-contenido {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
    }

    .criterio-nombre-voto {
        font-size: 0.95rem;
        font-weight: 500;
        color: #1f2937;
    }

    .input-puntuacion {
        width: 54px;
        min-width: 54px;
        text-align: center;
        background: #f3f4f6;
        border: 2px solid transparent;
        border-radius: 12px;
        padding: 0.55rem 0.35rem;
        font-size: 0.95rem;
        font-weight: 700;
        color: #1f2937;
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

        .input-puntuacion:focus,
        .input-puntuacion:hover {
            background: #ffffff;
            border-color: #f28c28;
        }

    .comentario-container {
        margin-top: 0.7rem;
    }

    .textarea-comentario {
        width: 100%;
        min-height: 78px;
        background: #f3f4f6;
        border: 2px solid transparent;
        border-radius: 14px;
        padding: 0.85rem 0.95rem;
        font-size: 0.95rem;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
        resize: none;
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

        .textarea-comentario:focus,
        .textarea-comentario:hover {
            background: #ffffff;
            border-color: #f28c28;
        }

        .textarea-comentario::placeholder {
            color: #8b93a1;
        }

    .loading-box {
        min-height: 180px;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 0.8rem;
        color: #737373;
        font-weight: 600;
    }

    .spinner-carga {
        width: 40px;
        height: 40px;
        border: 5px solid #e5e7eb;
        border-top-color: #f28c28;
        border-radius: 50%;
        animation: spinnerCarga 0.8s linear infinite;
    }

    @@keyframes spinnerCarga {
        to {
            transform: rotate(360deg);
        }
    }
    .contador {
        color: #718096;
        font-size: 0.78rem;
        display: block;
        margin-top: 3px;
        text-align: right;
    }
</style>
<PageTitle>Votar proyectos - Votify </PageTitle>
<div class="votacion-evento-page">
    @if (evento == null)
    {
        <div class="estado-card">
            <div class="loading-box">
                <div class="spinner-carga"></div>
                <p>Cargando proyectos...</p>
            </div>
        </div>
    }
    else if (evento.Proyectos == null || evento.Proyectos.Count == 0)
    {
        <div class="page-header">
            <h2 class="titulo">Proyectos del evento @evento.Nombre</h2>
            <p class="subtitulo">Selecciona tus proyectos favoritos</p>
        </div>

        <div class="estado-card">
            <label>No se han presentado proyectos para este evento todavía</label>
        </div>
    }
    else
    {
        <div class="page-header">
            <h2 class="titulo">Proyectos del evento @evento.Nombre</h2>
            <p class="subtitulo">Selecciona tus @NumProy proyectos favoritos</p>
        </div>

        <div class="estado-card">
            <label>Categoría de votación:</label>
            <select value="@idCategoriaSeleccionada"
                    disabled="@procesandoVoto"
                    @onchange="CategoriaSeleccionada">
                <option value="@Guid.Empty">Selecciona una categoría</option>
                @foreach (var categoria in categoriasEvento)
                {
                    <option value="@categoria.Id">@categoria.Nombre</option>
                }
            </select>
        </div>

        @if (idCategoriaSeleccionada != Guid.Empty && premiosCategoria.Any())
        {
            <div class="premios-votacion">
                <h3>Premios disponibles</h3>
                <div class="premios-lista-voto">
                    @foreach (var premio in premiosCategoria)
                    {
                        var imagenPremio = string.IsNullOrWhiteSpace(premio.ImagenUrl)
                            ? null
                            : GetProxyUrl(premio.ImagenUrl);

                        <div class="premio-item" title="@premio.Descripcion">
                            @if (string.IsNullOrWhiteSpace(imagenPremio))
                            {
                                <div class="premio-foto-placeholder">@premio.Orden</div>
                            }
                            else
                            {
                                <img src="@imagenPremio" alt="Imagen de @premio.Nombre" />
                            }
                            <div>
                                <strong>@premio.Nombre</strong>
                                <span>Puesto @premio.Puesto</span>
                                @if (!string.IsNullOrWhiteSpace(premio.Descripcion))
                                {
                                    <span>@premio.Descripcion</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (idCategoriaSeleccionada != Guid.Empty && !ProyectosDeCategoria.Any())
        {
            <div class="mensaje-info">No hay proyectos inscritos en esta categoría.</div>
        }

        <div class="proyecto-container">
            @foreach (var proyecto in ProyectosDeCategoria)
            {
                <div class="proyecto-card @(yaVoto ? "deshabilitado" : "")">
                    <div class="proyecto-top">
                        <button class="boton-favorito" @onclick="() => Favorito(proyecto.Id)" disabled="@(yaVoto || procesandoVoto)">
                            <img src="@(proyectosSeleccionados.Contains(proyecto.Id)
                                                                 ? "/EsFavorito.jpg"
                                                                 : "/Estrella.png")"
                         alt="Símbolo Favorito"
                         class="estrella-img" />
                </button>
            </div>

                    <div class="proyecto-header">
                        <div class="proyecto-nombre">@proyecto.Titulo</div>
                    </div>

                    @if (proyecto.Materiales?.Any() == true)
                    {
                        <div class="materiales-proyecto">
                            @foreach (var material in proyecto.Materiales)
                            {
                                var materialUrl = GetMaterialUrl(material);
                                if (!string.IsNullOrWhiteSpace(materialUrl))
                                {
                                    <a class="material-link @GetMaterialClass(material.Tipo)"
                                       href="@materialUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       title="@material.Nombre">
                                        <span class="material-texto">@GetMaterialLabel(material)</span>
                                    </a>
                                }
                            }
                        </div>
                    }

            @if (proyectosSeleccionados.Contains(proyecto.Id) && idCategoriaSeleccionada != Guid.Empty)
                    {
                        <div class="criterios-proyecto">
                            <hr class="linea-criterios" />

                            @foreach (var criterio in criterios)
                            {
                                <div class="criterio-fila">
                                    <div class="criterio-voto-contenido">
                                        <span class="criterio-nombre-voto">@criterio.Nombre</span>
                                        @if (votacion != null && votacion.PermiteComentarios)
                                        {
                                            <textarea maxlength="500"
                                                      value="@comentariosPorCriterio[proyecto.Id][criterio.Id]"
                                                      @oninput='e => comentariosPorCriterio[proyecto.Id][criterio.Id] = e.Value?.ToString()?.Length > 500 ? e.Value.ToString()[..500] : e.Value?.ToString() ?? ""'
                                                      placeholder="@(yaVoto ? "" : "Comentario sobre este criterio...")"
                                                      class="textarea-comentario"></textarea>
                                            <span class="contador">@(comentariosPorCriterio[proyecto.Id][criterio.Id]?.Length ?? 0) / 500</span>
                                        }
                                    </div>

                                    <input type="number"
                                           min="0"
                                           max="10"
                                           disabled="@procesandoVoto"
                                           class="input-puntuacion"
                                           value="@puntuacionesPorProyecto[proyecto.Id][criterio.Id]"
                                           @oninput="(e) => notaValida(e, proyecto.Id, criterio.Id)" />
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div class="acciones">
        <div class="acciones-izquierda">
            <button type="button"
                    class="boton-secundario"
                    disabled="@procesandoVoto"
                    @onclick='() => Volver()'>
                Volver
            </button>
        </div>

        <div class="acciones-derecha">
            @if (PuedeVerResultados())
            {
                <button type="button" class="boton-secundario" @onclick='() => VerResultados()'>
                    Ver Resultados
                </button>
            }
            <button type="button"
                    class="boton-principal boton-procesando"
                    disabled="@(yaVoto || procesandoVoto)"
                    @onclick='() => EnviarVoto()'>

                @if (procesandoVoto)
                {
                    <span class="spinner"></span>
                }

                @textoProcesando
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="mensaje-estado">@mensaje</div>
    }
</div>

@code {
    private Votify.Core.Entities.Evento? evento;
    [Parameter]
    public Guid id { get; set; }
    private List<Guid> proyectosSeleccionados = new();
    private Guid idVotacion;
    private Votify.Core.Entities.Votacion? votacion;
    private Guid idVotante;
    private int? NumProy = 0;
    private string mensaje = "";
    private Dictionary<Guid, Dictionary<Guid, string>> comentariosPorCriterio = new();
    private Votify.Core.Entities.Usuario usuario;
    private bool yaVoto = false;
    private bool procesandoVoto = false;
    private string textoProcesando = "Enviar Voto";

    private List<DimensionesDeValor> criterios = new();
    private List<Premio> premiosCategoria = new();
    private List<CategoriaEvento> categoriasEvento = new();
    private Guid idCategoriaSeleccionada = Guid.Empty;
    private List<Proyecto> ProyectosDeCategoria =>
        evento?.Proyectos?
            .Where(p => p.Id_categoria_evento == idCategoriaSeleccionada)
            .ToList() ?? new();
    private Dictionary<Guid, Dictionary<Guid, int>> puntuacionesPorProyecto = new();


    protected override async Task OnInitializedAsync()
    {
        evento = await contexto.Evento
            .Include(e => e.Proyectos)
                .ThenInclude(p => p.Materiales)
            .FirstOrDefaultAsync(e => e.Id == id);

        if (evento == null)
        {
            mensaje = "No se ha encontrado el evento.";
            return;
        }

        categoriasEvento = await contexto.CategoriaEvento
            .AsNoTracking()
            .Where(c => c.Id_evento == evento.Id)
            .OrderBy(c => c.Nombre)
            .ToListAsync();

        idCategoriaSeleccionada = Guid.Empty;
        mensaje = "Selecciona una categoría para votar.";

        foreach (var proyecto in ProyectosDeCategoria)
        {
            if (!puntuacionesPorProyecto.ContainsKey(proyecto.Id))
                puntuacionesPorProyecto[proyecto.Id] = new Dictionary<Guid, int>();

            if (!comentariosPorCriterio.ContainsKey(proyecto.Id))
                comentariosPorCriterio[proyecto.Id] = new Dictionary<Guid, string>();

            foreach (var criterio in criterios)
            {
                if (!puntuacionesPorProyecto[proyecto.Id].ContainsKey(criterio.Id))
                    puntuacionesPorProyecto[proyecto.Id][criterio.Id] = 0;

                if (!comentariosPorCriterio[proyecto.Id].ContainsKey(criterio.Id))
                    comentariosPorCriterio[proyecto.Id][criterio.Id] = "";
            }
        }

        ProtectedBrowserStorageResult<Guid> resultado;
        try
        {
            resultado = await sessionStorage.GetAsync<Guid>("IdUsuario");
            if (resultado.Success)
            {
                idVotante = resultado.Value;
                usuarioSesion.IdUsuario = resultado.Value;
                usuario = await contexto.Usuario.Include(u => u.Rol).Include(u => u.ProyectoParticipantes).FirstOrDefaultAsync(u => u.Id == idVotante);
                yaVoto = await contexto.Voto.AnyAsync(v =>
                    v.Id_votacion == idVotacion &&
                    v.Id_votante == idVotante &&
                    v.Id_categoria == idCategoriaSeleccionada);

                if (yaVoto)
                {
                    mensaje = "Ya has votado en esta categoría.";
                    List<Voto> votos = await VotacionService.ObtenerVotosUsuarioAsync(idVotacion, idVotante);
                    await CargarCriteriosVotacion();

                    foreach (var voto in votos.Where(v => v.Id_categoria == idCategoriaSeleccionada))
                    {
                        proyectosSeleccionados.Add(voto.Id_proyecto);

                        if (!comentariosPorCriterio.ContainsKey(voto.Id_proyecto))
                            comentariosPorCriterio[voto.Id_proyecto] = new Dictionary<Guid, string>();

                        foreach (var votoCriterio in voto.VotosCriterio)
                        {
                            comentariosPorCriterio[voto.Id_proyecto][votoCriterio.Id_criterio] = votoCriterio.Comentario ?? "";
                        }
                    }
                }
                StateHasChanged();
            }
            if (!resultado.Success || resultado.Value == Guid.Empty)
            {
                return;
            }
        }
        catch (Exception e)
        {
            return;
        }

    }
    private async Task CategoriaSeleccionada(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var idCategoria))
            idCategoria = Guid.Empty;

        idCategoriaSeleccionada = idCategoria;
        proyectosSeleccionados.Clear();
        await CargarVotacionCategoria();
        await CargarCriteriosVotacion();
        await CargarPremiosVotacion();
        yaVoto = idVotante != Guid.Empty && await contexto.Voto.AnyAsync(v =>
            v.Id_votacion == idVotacion &&
            v.Id_votante == idVotante &&
            v.Id_categoria == idCategoriaSeleccionada);
        mensaje = yaVoto
            ? "Ya has votado en esta categoría."
            : votacion == null
                ? "No hay una votación abierta para esta categoría."
                : $"Puedes votar hasta {NumProy} proyectos";
    }

    private async Task CargarVotacionCategoria()
    {
        votacion = null;
        idVotacion = Guid.Empty;
        NumProy = 0;
        premiosCategoria = new();

        if (evento == null || idCategoriaSeleccionada == Guid.Empty)
            return;

        votacion = await contexto.Votacion
            .Where(vot =>
                vot.Id_evento == evento.Id &&
                vot.EstadoVotacion == EstadoVotacion.Abierta &&
                (vot.Id_categoria_evento == idCategoriaSeleccionada || vot.Id_categoria_evento == null))
            .OrderByDescending(vot => vot.Id_categoria_evento == idCategoriaSeleccionada)
            .FirstOrDefaultAsync();

        if (votacion != null)
        {
            NumProy = votacion.NumProy;
            idVotacion = votacion.Id;
        }
    }

    private async Task CargarPremiosVotacion()
    {
        premiosCategoria = new();

        if (idVotacion == Guid.Empty || idCategoriaSeleccionada == Guid.Empty)
            return;

        premiosCategoria = await PremioService.ObtenerPremiosPorVotacionAsync(idVotacion, idCategoriaSeleccionada);
    }

    private async Task CargarCriteriosVotacion()
    {
        if (votacion == null)
        {
            criterios = new();
            return;
        }

        criterios = await contexto.DimensionesDeValor
            .AsNoTracking()
            .Where(d => d.Id_votacion == votacion.Id && d.Id_categoria_evento == idCategoriaSeleccionada)
            .OrderBy(d => d.Nombre)
            .ToListAsync();

        if (evento?.Proyectos == null)
            return;

        foreach (var proyecto in ProyectosDeCategoria)
        {
            if (!puntuacionesPorProyecto.ContainsKey(proyecto.Id))
                puntuacionesPorProyecto[proyecto.Id] = new Dictionary<Guid, int>();

            if (!comentariosPorCriterio.ContainsKey(proyecto.Id))
                comentariosPorCriterio[proyecto.Id] = new Dictionary<Guid, string>();

            foreach (var criterio in criterios)
            {
                if (!puntuacionesPorProyecto[proyecto.Id].ContainsKey(criterio.Id))
                    puntuacionesPorProyecto[proyecto.Id][criterio.Id] = 0;

                if (!comentariosPorCriterio[proyecto.Id].ContainsKey(criterio.Id))
                    comentariosPorCriterio[proyecto.Id][criterio.Id] = "";
            }
        }
    }

    private void Favorito(Guid idProyecto)
    {
        if (yaVoto) return;
        if (proyectosSeleccionados.Contains(idProyecto))
        {
            proyectosSeleccionados.Remove(idProyecto);
        }
        else
        {
            if (proyectosSeleccionados.Count < NumProy)
            {
                proyectosSeleccionados.Add(idProyecto);
                //if(votacion.PermiteComentarios)comentariosPorProyecto[idProyecto] = "";
            }
        }
    }

    private async Task EnviarVoto()
    {
        if (procesandoVoto)
            return;

        procesandoVoto = true;
        textoProcesando = "Procesando voto...";
        mensaje = "";

        try
        {
            if (idVotante == Guid.Empty)
            {
                mensaje = "Error: No se detecta una sesión activa. Por favor, reingresa.";
                return;
            }

            if (usuario == null)
            {
                mensaje = "No se ha encontrado el usuario autenticado.";
                await Task.Delay(900);
                nav.NavigateTo("/Login");
                return;
            }

            if (evento == null)
            {
                mensaje = "No se ha podido cargar el evento.";
                return;
            }

            if (idVotacion == Guid.Empty)
            {
                mensaje = "No hay una votación activa para este evento, espera a que haya una para poder votar.";
                return;
            }

            if (idCategoriaSeleccionada == Guid.Empty)
            {
                mensaje = "Selecciona una categoría antes de votar.";
                return;
            }

            if (!criterios.Any())
            {
                mensaje = "La categoría seleccionada no tiene criterios.";
                return;
            }

            if (proyectosSeleccionados.Count > NumProy)
            {
                mensaje = $"No puedes seleccionar más de {NumProy} proyectos para votar.";
                return;
            }

            if (proyectosSeleccionados.Count < NumProy)
            {
                bool confirmar = await JS.InvokeAsync<bool>(
                    "confirm",
                    $"Vas a votar a menos proyectos de los permitidos ({proyectosSeleccionados.Count}/{NumProy}). ¿Deseas continuar igualmente?"
                );

                if (!confirmar)
                    return;
            }

            foreach (var idProyecto in proyectosSeleccionados)
            {
                if (!puntuacionesPorProyecto.ContainsKey(idProyecto))
                {
                    mensaje = "Faltan puntuaciones en uno de los proyectos seleccionados.";
                    return;
                }

                foreach (var criterio in criterios)
                {
                    if (!puntuacionesPorProyecto[idProyecto].ContainsKey(criterio.Id))
                    {
                        mensaje = $"Falta la puntuación del criterio {criterio.Nombre} en uno de los proyectos.";
                        return;
                    }

                    if (puntuacionesPorProyecto[idProyecto][criterio.Id] > 10 ||
                        puntuacionesPorProyecto[idProyecto][criterio.Id] < 0)
                    {
                        mensaje = $"La puntuación en los criterios debe estar entre 0 y 10, el criterio {criterio.Nombre} no lo cumple";
                        return;
                    }

                    if (votacion != null && votacion.PermiteComentarios && votacion.ComentariosObligatorios)
                    {
                        if (!comentariosPorCriterio[idProyecto].ContainsKey(criterio.Id) ||
                            string.IsNullOrWhiteSpace(comentariosPorCriterio[idProyecto][criterio.Id]))
                        {
                            mensaje = "En esta votación es obligatorio incluir un comentario por criterio en cada voto";
                            return;
                        }
                    }
                }
            }

            var votoDto = new EmitirVotoDTO
                {
                    IdVotante = usuario.Id,
                    Votos = proyectosSeleccionados.Select(idProyecto => new VotoDetalleDTO
                    {
                        IdProyecto = idProyecto,
                        IdCategoriaEvento = idCategoriaSeleccionada,
                        Puntuaciones = criterios.Select(c => new PuntuacionCriterioDTO
                        {
                            IdCriterio = c.Id,
                            Nota = puntuacionesPorProyecto[idProyecto][c.Id],
                            Comentario = votacion != null && votacion.PermiteComentarios
                                ? comentariosPorCriterio[idProyecto][c.Id]
                                : null
                        }).ToList()
                    }).ToList(),
                    IdEvento = evento.Id
                };

            await VotacionService.RegistrarVotoAsync(idVotacion, votoDto);

            mensaje = "Voto enviado correctamente.";
            yaVoto = true;
            textoProcesando = "Voto enviado";
        }
        catch (Exception ex)
        {
            mensaje = ex.InnerException == null
                ? ex.Message
                : $"{ex.Message} Detalle: {ex.InnerException.Message}";
            textoProcesando = "Enviar Voto";
        }
        finally
        {
            procesandoVoto = false;

            if (!yaVoto)
                textoProcesando = "Enviar Voto";
        }
    }

    void Volver()
    {
        nav.NavigateTo("javascript:history.back()");
    }

    void VerResultados()
    {
        nav.NavigateTo($"/Dashboard/{evento.Id}");
    }

    private bool PuedeVerResultados()
    {
        if (votacion == null)
            return false;

        DateTime hoy = DateTime.UtcNow;

        return votacion.FechaFin <= hoy;
    }

    private void notaValida(ChangeEventArgs e, Guid idProyecto, Guid idCriterio)
    {
        if (!int.TryParse(e.Value?.ToString(), out int valor))
            valor = 0;

        if (valor < 0)
            valor = 0;
        else if (valor > 10)
            valor = 10;

        puntuacionesPorProyecto[idProyecto][idCriterio] = valor;
    }

    private string GetProxyUrl(string url) => $"/api/miniaturas/from-url?url={Uri.EscapeDataString(url)}";

    private string GetMaterialUrl(Material material)
    {
        if (string.IsNullOrWhiteSpace(material.Url))
            return string.Empty;

        return material.Tipo == "Imagen"
            ? GetProxyUrl(material.Url)
            : material.Url;
    }

    private static string GetMaterialLabel(Material material)
    {
        var prefijo = material.Tipo switch
        {
            "Imagen" => "Imagen",
            "Video" => "Video",
            "Enlace" => "Enlace",
            "Archivo" => "Archivo",
            _ => "Material"
        };

        return string.IsNullOrWhiteSpace(material.Nombre)
            ? prefijo
            : $"{prefijo}: {material.Nombre}";
    }

    private static string GetMaterialClass(string tipo) => tipo switch
    {
        "Imagen" => "material-imagen",
        "Video" => "material-video",
        "Enlace" => "material-enlace",
        _ => "material-archivo"
    };
}
