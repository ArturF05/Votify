@page "/CrearEvento"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Votify.Core.Entities
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@using Votify.Infrastructure.Repositorios
@using Votify.API.DTOs
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager nav
@inject AppDbContext contexto
@inject HttpClient Http
@inject ProtectedSessionStorage sessionStorage
@inject IJSRuntime JS

<PageTitle>Crear Evento - Votify </PageTitle>
<div class="crear-evento-page">
    <div class="page-header">
        <h2 class="page-title">Crear Evento</h2>
    </div>

    <div class="form-evento">
        <div class="evento-header">
            <h3>Nuevo evento</h3>
            <div class="plantillas-wrapper">
                <button type="button" class="boton-accion-votacion @(plantillasGeneralesAbierto ? "activo" : "")"
                        @onclick="TogglePlantillasGenerales">
                    ☰ Plantillas evento
                </button>
                @if (plantillasGeneralesAbierto)
                {
                    <div class="plantillas-inline">
                        @foreach (var pg in plantillasGenerales)
                        {
                            <button type="button" class="dropdown-item"
                                    title="@GetTooltipGeneral(pg)"
                                    @onclick="() => AplicarPlantillaGeneral(pg)">
                                @pg.Nombre
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <hr class="linea">

        <div class="campo campo-columna">
            <label>Nombre*:</label>
            <div class="input-ancho">
            <input type="text" maxlength="@MaxNombre"
                   value="@nombre"
                   @oninput="OnInputNombre"
                   placeholder="Nombre del evento..." />
            <span class="contador">@nombre.Length / @MaxNombre</span>
            </div>
        </div>
        <div class="campo campo-columna">
            <label>Imagen del evento:</label>
            <InputFile OnChange="OnImagenSeleccionada" accept=".jpg,.jpeg,.png" />

            @if (imagenBytes != null)
            {
                <p>Imagen lista: @imagenNombre</p>
            }
        </div>
        <div class="form-grid">
            <div class="campo campo-columna">
                <label>Categoría*:</label>
                <select @bind="Id_categoria">
                    @foreach (var cat in categorias)
                    {
                        <option value="@cat.Id">@cat.Nombre</option>
                    }
                </select>
            </div>

            <div class="campo campo-columna">
                <label>Tipo de evento*:</label>
                <select @bind="tipo">
                    <option value="Hackathon">Hackathon</option>
                    <option value="Concurso">Concurso</option>
                </select>
            </div>

            <div class="campo campo-columna">
                <label>Fecha de inicio*:</label>
                <input type="datetime-local" @bind="inicio" />
            </div>

            <div class="campo campo-columna">
                <label>Fecha de cierre*:</label>
                <input type="datetime-local" @bind="fin" />
            </div>
            <div class="campo">
                <label>Descripción:</label>
                <textarea maxlength="@MaxDescripcion"
                          value="@descripcion"
                          @oninput="OnInputDescripcion"
                          placeholder="Descripción..."></textarea>
                <span class="contador">@descripcion.Length / @MaxDescripcion</span>
            </div>

            <div class="separador-criterios"></div>

            <section class="bloque-criterios-ev campo-completo">
                <h4 class="titulo-criterios">Añadir categoría</h4>
                <div class="criterio-formulario-añadir">
                    <div class="input-y-contador">
                        <input type="text" placeholder="Nombre de categoría"
                               maxlength="@MaxNombreCategoriaEvento"
                               value="@nombreCategoriaEvento"
                               @oninput="OnInputNombreCategoria"
                               class="input-criterio" />
                        <span class="contador">@nombreCategoriaEvento.Length / @MaxNombreCategoriaEvento</span>
                    </div>
                    <button type="button" class="boton-principal" @onclick="GuardarCategoriaEvento">
                        Añadir categoría
                    </button>
                </div>
                <div class="separador-criterios"></div>
                <div class="titulo-con-boton">
                    <h4 class="titulo-criterios">Categorías de votación</h4>
                    <div class="plantillas-wrapper">
                        <button type="button" class="boton-accion-votacion @(plantillasCategoriasAbierto ? "activo" : "")"
                                @onclick="TogglePlantillasCategorias">
                            ☰ Plantillas categorías
                        </button>
                        @if (plantillasCategoriasAbierto)
                        {
                            <div class="plantillas-inline">
                                @foreach (var pc in plantillasCategorias)
                                {
                                    <button type="button" class="dropdown-item"
                                            title="@GetTooltipCategorias(pc)"
                                            @onclick="() => AplicarPlantillaCategorias(pc)">
                                        @pc.Nombre
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="lista-criterios">
                    @if (!categoriasEvento.Any())
                    {
                        <label>No se ha creado ninguna categoría para este evento</label>
                    }
                    @foreach (var categoria in categoriasEvento)
                    {
                        <div class="criterio-item criterio-item-categoria">
                            <div class="criterio-texto">
                                <span class="criterio-nombre">@categoria.Nombre</span>
                            </div>
                            <div class="criterio-acciones">
                                <button type="button"
                                        class="boton-accion-votacion @(criteriosCopiadosCategoria != null && idCategoriaCopiadaDe == categoria.Id ? "boton-accion-pegar" : "")"
                                        @onclick="() => CopiarCriteriosCategoria(categoria.Id)">
                                    @if (criteriosCopiadosCategoria == null)
                                    {
                                        <text>📄 Copiar criterios</text>
                                    }
                                    else if (idCategoriaCopiadaDe == categoria.Id)
                                    {
                                        <text>❌ Cancelar copia</text>
                                    }
                                    else
                                    {
                                        <text>📋 Pegar criterios</text>
                                    }
                                </button>
                                <button type="button" class="boton-secundario"
                                        @onclick="() => QuitarCategoriaEvento(categoria.Id)">
                                    Quitar
                                </button>
                            </div>
                        </div>

                        <div class="lista-criterios lista-criterios-sangria">
                            @foreach (var criterio in categoria.Criterios)
                            {
                                <div class="criterio-item">
                                    <div class="criterio-texto">
                                        <span class="criterio-nombre">@criterio.Nombre</span>
                                        <span class="criterio-descripcion">@criterio.Descripcion</span>
                                    </div>
                                    <div class="criterio-acciones">
                                        <span class="criterio-descripcion">Peso (%):</span>
                                        <input type="number" class="criterio-peso" @bind="criterio.Peso" />
                                        <button type="button" class="boton-secundario"
                                                @onclick="() => QuitarCriterioCategoria(categoria.Id, criterio.Id)">
                                            Quitar
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="separador-criterios"></div>
                <h4 class="titulo-criterios">Crear nuevos criterios</h4>
                <div class="criterio-formulario-ev-crear">
                    <div class="criterio-fila-superior">
                        <div class="criterio-campo">
                            <label>Categoría:</label>
                            <select @bind="idCategoriaNuevoCriterio" class="input-criterio">
                                <option value="@Guid.Empty">Selecciona categoría</option>
                                @foreach (var cat in categoriasEvento)
                                {
                                    <option value="@cat.Id">@cat.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="criterio-campo">
                            <label>Nombre del criterio:</label>
                            <input type="text" placeholder="Nombre criterio" class="input-criterio"
                                   maxlength="@MaxNombreCriterio"
                                   value="@nombreCriterio"
                                   @oninput="OnInputNombreCriterio" />
                            <span class="contador">@nombreCriterio.Length / @MaxNombreCriterio</span>
                        </div>
                    </div>
                    <div class="criterio-campo">
                        <label>Descripción del criterio:</label>
                        <input type="text" placeholder="Descripción" class="input-criterio"
                               maxlength="@MaxDescripcionCriterio"
                               value="@descripcionCriterio"
                               @oninput="OnInputDescripcionCriterio" />
                        <span class="contador">@descripcionCriterio.Length / @MaxDescripcionCriterio</span>
                    </div>
                    <button type="button" class="boton-principal"
                            @onclick="GuardarCriterioConSelector">
                        Añadir
                    </button>
                </div>
                <div><label style="color:red">@mensajeErrorCriterio</label></div>
            </section>
            <div class="separador-criterios"></div>
            <h4 class="titulo-criterios">Crear Votaciones</h4>
            @for(int index = 0; index<votaciones.Count; index++)
            {
                int i = index;
                <div class="campo campo-columna campo-completo">
                    <div class="votacion-header">
                        <h4 class="votacion-titulo">Votación @(i + 1)</h4>
                        <div class="votacion-acciones">

                            
                            <div class="plantillas-wrapper">
                                <button type="button" class="boton-accion-votacion @(plantillasAbierto == i ? "activo" : "")"
                                        @onclick="() => TogglePlantillas(i)">
                                    ☰ Plantillas votación
                                </button>
                                @if (plantillasAbierto == i)
                                {
                                    <div class="plantillas-inline">
                                        @foreach (var plantilla in plantillasDisponibles)
                                        {
                                            <button type="button" class="dropdown-item"
                                                    title="@GetTooltipVotacion(plantilla)"
                                                    @onclick="() => AplicarPlantilla(i, plantilla)">
                                                @plantilla.Nombre
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="campo campo-columna campo-completo">
                        <label>Categoría de la votación*:</label>
                        <select @bind="votaciones[i].IdCategoriaVotacion"
                                disabled="@(!categoriasEvento.Any())">
                            <option value="@Guid.Empty">Todas las categorías</option>
                            @foreach (var cat in categoriasEvento.OrderBy(c => c.Nombre))
                            {
                                <option value="@cat.Id">@cat.Nombre</option>
                            }
                        </select>
                        @if (!categoriasEvento.Any())
                        {
                            <span style="color:#9ca3af; font-size:0.85rem;">
                                Crea primero al menos una categoría de votación
                            </span>
                        }
                    </div>
                    <label>Tipo de votación*:</label>
                    <div class="grupo-botones-votacion">
                        <button type="button"
                                class="boton-votacion @(votaciones[i].Tipo == TipoVotacion.Publico ? "activo" : "")"
                                @onclick='() => SeleccionarTipo(TipoVotacion.Publico, i)'>
                            Público
                        </button>

                        <button type="button"
                                class="boton-votacion @(votaciones[i].Tipo == TipoVotacion.Jurado ? "activo" : "")"
                                @onclick='() => SeleccionarTipo(TipoVotacion.Jurado, i)'>
                            Jurado
                        </button>

                        <button type="button"
                                class="boton-votacion @(votaciones[i].Tipo == TipoVotacion.Mixto ? "activo" : "")"
                                @onclick='() => SeleccionarTipo(TipoVotacion.Mixto, i)'>
                            Mixto
                        </button>
                    </div>
                </div>
                <div class="campo campo-columna">
                    <label>Permitir Autovoto*:</label>
                    <select @bind="votaciones[i].PermiteAutoVoto">
                        <option value="1">Sí</option>
                        <option value="0">No</option>
                    </select>
                </div>
                <div class="campo campo-columna">
                    <label>Permitir ver resultados en vivo*:</label>
                    <select @bind="votaciones[i].VerRes">
                        <option value="1">Sí</option>
                        <option value="0">No</option>
                    </select>
                </div>
                <div class="campo campo-columna">
                    <label>Inicio automático*:</label>
                    <input type="datetime-local" @bind-value="votaciones[i].Inicio" @bind-value:event="onchange" />
                </div>
                <div class="campo campo-columna">
                    <label>Fin automático*:</label>
                    <input type="datetime-local" @bind-value="votaciones[i].Fin" @bind-value:event="onchange" />
                </div>
                <div class="campo campo-columna">
                    <label>Número de proyectos votables*:</label>
                    <input type="number" @bind-value="votaciones[i].NumProy" min="1" />
                </div>
                <div class="campo campo-columna">
                    <label>Permitir comentarios*</label>
                    <select @onchange="(e)=> cambioPermiteComentarios(e,i)">
                        <option value="1">Sí</option>
                        <option value="0">No</option>
                    </select>
                </div>
                <div class="campo campo-columna">
                    <label>Comentarios obligatorios*</label>
                    <select @bind="votaciones[i].ComentariosObligatorios" disabled="@(votaciones[i].PermiteComentarios ==0)" 
                        title="@(votaciones[i].PermiteComentarios == 0 ? "No se puede modificar porque no se permiten comentarios": null)">
                        <option value="0">No</option>
                        <option value="1">Sí</option>
                    </select>
                </div>
                <div class="grupo-botones-votacion">
                    <button type="button" class="boton-duplicar-votacion"
                            @onclick="() => DuplicarVotacion(i)"
                            title="Añade una nueva votación a la lista con los mismos parámetros que esta">
                        ⧉ Duplicar
                    </button>
                    <button type="button" class="boton-quitar-votacion" @onclick='() => quitarVotacion(i)' disabled="@(votaciones.Count <= 1)"
                            title="@(votaciones.Count <= 1 ? "Un evento debe tener como mínimo una votación" : null)">
                        Quitar votación
                    </button>
                </div>
                @if (index != votaciones.Count -1)
                {
                    <div class="separador-votaciones"></div>
                }
            }
            <div class="grupo-botones-votacion boton-add-votacion-wrapper">
                <button type="button" class="boton-votacion" @onclick="otraVotacion">Añadir votación</button>
            </div>

            

    </div>

        <div class="botones">
            <div class="grupo-botones">
                <button type="button" class="boton-secundario" @onclick="Cancelar">Cancelar</button>
            </div>
            <div class="zona-guardado">
                @if (errorGuardado)
                {
                    <div class="mensaje-error-guardado">
                        @if (!string.IsNullOrEmpty(mensaje))
                        {
                            <span>@mensaje</span>
                        }
                        @if (!string.IsNullOrEmpty(mensaje2))
                        {
                            <span>@mensaje2</span>
                        }
                        @if (!string.IsNullOrEmpty(mensajeErrorCriterio))
                        {
                            <span>@mensajeErrorCriterio</span>
                        }
                        @if (string.IsNullOrEmpty(mensaje) && string.IsNullOrEmpty(mensaje2) && string.IsNullOrEmpty(mensajeErrorCriterio))
                        {
                            <span>No se ha podido crear el evento porque faltan datos obligatorios o hay errores pendientes de resolver</span>
                        }
                    </div>
                }
                <button type="button" class="boton-principal" @onclick="GuardarEvento">Crear Evento</button>
            </div>
        </div>
    </div>
    <NavigationLock ConfirmExternalNavigation="true"
                    OnBeforeInternalNavigation="ConfirmarSalida" />
</div>

           

@code {
    DateTime inicio = DateTime.Now;
    DateTime fin = DateTime.Now.AddDays(1);
    List<VotacionForm> votaciones = new();
    private string nombre = "";
    private Guid Id_categoria = new Guid("0d4e9ac5-56ee-4a5c-817e-ee78bf8a8ed9");
    private Guid idCategoriaNuevoCriterio = Guid.Empty;
    private string descripcion = "";
    private string mensaje = "";
    private string mensaje2 = "";
    private string mensajeErrorCriterio = "";
    private string mensajeNoCriterio = "";
    private string nombreCategoriaEvento = "";
    private string nombreCriterio = "";
    private string descripcionCriterio = "";
    private int pesoCriterio = 0;
    private string tipo = "Hackathon";
    List<Categoria> categorias = new();
    List<CategoriaEventoForm> categoriasEvento = new();
    List<Votify.Core.Entities.Evento> eventos = new();
    List<Votify.Core.Entities.DimensionesDeValor> criterios = new();
    private Guid idUsuario;
    private Votify.Core.Entities.Usuario? usuarioActual;
    private byte[]? imagenBytes;
    private string? imagenNombre;

    private const int MaxNombre = 50;
    private const int MaxDescripcion = 500;
    private const int MaxNombreCategoriaEvento = 50;
    private const int MaxNombreCriterio = 50;
    private const int MaxDescripcionCriterio = 100;

    private bool plantillasGeneralesAbierto = false;
    private bool plantillasCategoriasAbierto = false;
    private int? plantillasAbierto = null; 

    private bool errorGuardado = false;
    private bool hayCambios = false;

    private List<DimensionesDeValor>? criteriosCopiadosCategoria = null;
    private Guid idCategoriaCopiadaDe = Guid.Empty;


    private void AplicarPlantillaGeneral(PlantillaGeneral pg)
    {
        hayCambios = true;
        tipo = pg.Tipo;
        categoriasEvento.Clear();
        foreach (var cat in pg.Categorias)
        {
            var nueva = new CategoriaEventoForm { Id = Guid.NewGuid(), Nombre = cat.Nombre };
            foreach (var c in cat.Criterios)
                nueva.Criterios.Add(new DimensionesDeValor
                {
                    Id = Guid.NewGuid(),
                    Id_votacion = Guid.Empty,
                    Id_categoria_evento = nueva.Id,
                    Nombre = c.Nombre,
                    Descripcion = c.Descripcion,
                    Peso = c.Peso
                });
            categoriasEvento.Add(nueva);
        }
        // Aplica también la votación predefinida en la primera ranura
        if (votaciones.Any()) AplicarPlantilla(0, pg.Votacion);
        plantillasGeneralesAbierto = false;
    }

    private void AplicarPlantillaCategorias(PlantillaCategorias pc)
    {
        hayCambios = true;
        foreach (var cat in pc.Categorias)
        {
            if (categoriasEvento.Any(c => c.Nombre.Equals(cat.Nombre, StringComparison.OrdinalIgnoreCase)))
                continue;
            var nueva = new CategoriaEventoForm { Id = Guid.NewGuid(), Nombre = cat.Nombre };
            foreach (var c in cat.Criterios)
                nueva.Criterios.Add(new DimensionesDeValor
                {
                    Id = Guid.NewGuid(),
                    Id_votacion = Guid.Empty,
                    Id_categoria_evento = nueva.Id,
                    Nombre = c.Nombre,
                    Descripcion = c.Descripcion,
                    Peso = c.Peso
                });
            categoriasEvento.Add(nueva);
        }
        plantillasCategoriasAbierto = false;
    }
    protected override async Task OnInitializedAsync()
    {
        categorias = await contexto.Categoria.ToListAsync();
        ProtectedBrowserStorageResult<Guid> resultado;
        try
        {
            resultado = await sessionStorage.GetAsync<Guid>("IdUsuario");
            if (!resultado.Success || resultado.Value == Guid.Empty)
            {
                nav.NavigateTo("/Login");
                return;
            }
        }
        catch (Exception e)
        {
            nav.NavigateTo("/Login");
            return;
        }

        if (!resultado.Success || resultado.Value == Guid.Empty)
        {
            nav.NavigateTo("/Login");
            return;
        }
        idUsuario = resultado.Value;

        usuarioActual = await contexto.Usuario
            .Include(u => u.Rol)
            .FirstOrDefaultAsync(u => u.Id == idUsuario);
        otraVotacion();
    }
    private async Task ConfirmarSalida(LocationChangingContext context)
    {
        if (!hayCambios) return;
        var confirmado = await JS.InvokeAsync<bool>("confirm",
            "Tienes cambios sin guardar. ¿Seguro que quieres salir?");
        if (!confirmado) context.PreventNavigation();
    }
    private async Task Cancelar() => await JS.InvokeVoidAsync("history.back");
    private void OnInputNombre(ChangeEventArgs e)
    {
        hayCambios = true;
        var val = e.Value?.ToString() ?? "";
        nombre = val.Length > MaxNombre ? val[..MaxNombre] : val;
    }

    private void OnInputDescripcion(ChangeEventArgs e)
    {
        hayCambios = true;
        var val = e.Value?.ToString() ?? "";
        descripcion = val.Length > MaxDescripcion ? val[..MaxDescripcion] : val;
    }

    private void OnInputNombreCategoria(ChangeEventArgs e)
    {
        hayCambios = true;
        var val = e.Value?.ToString() ?? "";
        nombreCategoriaEvento = val.Length > MaxNombreCategoriaEvento ? val[..MaxNombreCategoriaEvento] : val;
    }

    private void OnInputNombreCriterio(ChangeEventArgs e)
    {
        hayCambios = true;
        var val = e.Value?.ToString() ?? "";
        nombreCriterio = val.Length > MaxNombreCriterio ? val[..MaxNombreCriterio] : val;
    }

    private void OnInputDescripcionCriterio(ChangeEventArgs e)
    {
        hayCambios = true;
        var val = e.Value?.ToString() ?? "";
        descripcionCriterio = val.Length > MaxDescripcionCriterio ? val[..MaxDescripcionCriterio] : val;
    }
    private void GuardarCriterioConSelector()
    {
        if (idCategoriaNuevoCriterio == Guid.Empty)
        {
            mensajeErrorCriterio = "Selecciona la categoría del criterio";
            return;
        }
        GuardarCriterioCategoria(idCategoriaNuevoCriterio);
    }
    void SeleccionarTipo(TipoVotacion tipo, int numeroVotacion)
    {
        votaciones[numeroVotacion].Tipo = tipo;
    }
    private void otraVotacion()
    {
        hayCambios = true;
        votaciones.Add(new VotacionForm
        {
            Tipo = TipoVotacion.Publico,
            Inicio = DateTime.Now,
            Fin = DateTime.Now.AddDays(1),
            PermiteAutoVoto = 1,
            NumProy = 1,
            PermiteComentarios = 1,
            ComentariosObligatorios = 0,
            VerRes=1,
        });
    }
    private void quitarVotacion(int numeroVotacion)
    {
        hayCambios = true;
        votaciones.RemoveAt(numeroVotacion);
        /*if (mensajeCopiadoDe == numeroVotacion)
        {
            criteriosCopiados = null;
            mensajeCopiadoDe = -1;
            }*/
    }
    private void TogglePlantillasGenerales()
    {
        plantillasGeneralesAbierto = !plantillasGeneralesAbierto;
        StateHasChanged();
    }

    private void TogglePlantillasCategorias()
    {
        plantillasCategoriasAbierto = !plantillasCategoriasAbierto;
        StateHasChanged();
    }
    private void TogglePlantillas(int i)
    {
        plantillasAbierto = (plantillasAbierto == i) ? null : i;
        StateHasChanged();
    }
    private void AplicarPlantilla(int i, PlantillaVotacion plantilla)
    {
        hayCambios = true;
        votaciones[i].Tipo = plantilla.Tipo;
        votaciones[i].PermiteAutoVoto = plantilla.PermiteAutoVoto;
        votaciones[i].VerRes = plantilla.VerRes;
        votaciones[i].PermiteComentarios = plantilla.PermiteComentarios;
        votaciones[i].ComentariosObligatorios = plantilla.ComentariosObligatorios;
        votaciones[i].NumProy = plantilla.NumProy;
        plantillasAbierto = null;
    }
    private void DuplicarVotacion(int i)
    {
        var origen = votaciones[i];
        votaciones.Add(new VotacionForm
        {
            Tipo = origen.Tipo,
            Inicio = origen.Inicio,
            Fin = origen.Fin,
            PermiteAutoVoto = origen.PermiteAutoVoto,
            VerRes = origen.VerRes,
