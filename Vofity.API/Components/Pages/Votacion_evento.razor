@page "/Votacion_evento/{id:guid}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Votify.Core.DTOs
@using Votify.Core.Entities
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@using Votify.Infrastructure.Repositorios
@inject NavigationManager nav;
@inject AppDbContext contexto
@inject HttpClient Http
@inject IVotacion VotacionService
@using Votify.Core.Interfaces
@inject IUsuarioSesion UsuarioSesion

            @if(evento == null)
            {
                <label>Cargando proyectos...</label>
            }
            else if (evento.Proyectos == null || evento.Proyectos.Count == 0)
            {
                <h2 class="titulo">Proyectos del evento @evento.Nombre</h2>
                <label>No se han presentado proyectos para este evento todavía</label>
            }
            else
            {
                <h2 class="titulo">Proyectos del evento @evento.Nombre</h2>
                <div class="proyecto-container">    
                @foreach (var proyecto in evento.Proyectos)
                {
                    <div class="proyecto-card">
                        <button class="boton-favorito" @onclick="() => Favorito(proyecto.Id)"><img src="@(proyectosSeleccionados.Contains(proyecto.Id)
                            ? "/EsFavorito.jpg"
                            : "/Estrella.png")"
                            alt="Símbolo Favorito" class="estrella-img" /> </button>
                        <div class="proyecto-header">
                            <div class="logo-container">
                                <label>@proyecto.Titulo</label>
                            </div>
                        </div>
                    </div>
                }
                </div>
            }
<div>
    <button type="button" class="boton-volver" @onclick='() => Volver()'>Volver</button>
    <button type="button" class="boton-volver" @onclick='() => EnviarVoto()'>Enviar Voto</button>
    <button type="button" class="boton-volver" @onclick='() => VerResultados()'>Ver Resultados</button>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <p>@mensaje</p>
}

@code{
    private Votify.Core.Entities.Evento evento;
    [Parameter]
    public Guid id { get; set; }
    private List<Guid> proyectosSeleccionados = new();
    private Guid idVotacion;
    
    private string mensaje = "";

    protected override async Task OnInitializedAsync()
    {
        evento = await contexto.Evento.Include(e => e.Proyectos).FirstOrDefaultAsync(e => e.Id == id);
        var votacion = await contexto.Votacion.FirstOrDefaultAsync(v => v.Id_evento == id);
        if (votacion != null) { idVotacion = votacion.Id; }
     
        
    }
    private void Favorito(Guid idProyecto)
    {
        if (proyectosSeleccionados.Contains(idProyecto))
        {
            proyectosSeleccionados.Remove(idProyecto);
        }
        else
        {
            if (proyectosSeleccionados.Count < 3)
            {
                proyectosSeleccionados.Add(idProyecto);
            }
        }
    }

    private async Task EnviarVoto()
    {
        if (UsuarioSesion.UsuarioActual == null)
        {
            mensaje = "Error: No se detecta una sesión activa. Por favor, reingresa.";
            return;
        }

        var usuario = UsuarioSesion.UsuarioActual;

      
        if (idVotacion == Guid.Empty)
        {
            mensaje = "No existe votación para este evento.";
            return;
        }
        var tipoEvento = evento.TipoVotacion;
        var rolUsuario = usuario.Rol.Nombre;

        if (tipoEvento == TipoVotacion.Publico)
        {
            if (rolUsuario != "Publico")
            {
                mensaje = "Solo usuarios públicos pueden votar en este evento.";
                return;
            }
        }
        if (tipoEvento == TipoVotacion.Jurado)
        {
            var atorizacion = await contexto.EventoUsuarioRol
                .Where(eur => eur.EventoId == id && eur.UsuarioId == usuario.Id)
                .AnyAsync();

            if (!atorizacion)
            {
                mensaje = "Solo el jurado asignado puede votar.";
                return;
            }
        }
       

        if (proyectosSeleccionados.Count != 3)
        {
            mensaje = "Debes seleccionar exactamente 3 proyectos para votar.";
            return;
        }

        // evitar votos duplicados  
        var yaVoto = await contexto.Voto
            .AnyAsync(v => v.Id_votante == usuario.Id && v.Id_votacion == idVotacion);

        if (yaVoto)
        {
            mensaje = "Ya has votado en este evento.";
            return;
        }
        var votoDto = new EmitirVotoDTO
        {
            IdVotante = UsuarioSesion.UsuarioActual.Id,
            IdsProyectos = proyectosSeleccionados
        };

        try
        {
            var resultado = await VotacionService.RegistrarVotoAsync(idVotacion, votoDto);

            if (resultado)
            {
                mensaje = "Voto enviado correctamente.";
            }
            else
            {
                mensaje = "Error al registrar el voto. Verifica que no hayas votado antes y que la votación esté activa.";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"HTTP Error: {ex.Message}";
            Console.WriteLine($"[DEBUG] Full exception: {ex}");
        }
    }

    void Volver()
    {
        nav.NavigateTo("/Votacion");
    }

    void VerResultados()
    {
        nav.NavigateTo("/Dashboard");
    }
}