@page "/GestionarVotaciones"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using System.Net.Http.Json
@using Votify.Core.Entities
@using Votify.Core.Interfaces
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@inject NavigationManager nav
@inject AppDbContext contexto
@inject HttpClient Http
@inject IEvento eventoService
@rendermode InteractiveServer

<div class="titulo-y-finalizadas">
    @if (!verFinalizadas)
    {
        <h2 class="titulo">Votaciones no finalizadas</h2>
    }
    else
    {
        <h2 class="titulo">Votaciones finalizadas</h2>
    }

    <button class="boton-finalizadas" @onclick="VerFinalizadas">
        @boton 
    </button>
</div>

<PageTitle>Gestionar Votaciones</PageTitle>

<div class="barra-busqueda">
    <label style="vertical-align:text-bottom">Evento: </label>
    <select @bind="Id_evento" @bind:event="oninput" @onchange="BuscarVotaciones">
        <option value="@Guid.Empty">Todos</option>
        @foreach (var evento in eventos.Where(e => e.Archivado == false))
        {
            <option value="@evento.Id">@evento.Nombre</option>
        }
    </select>
    <label style="vertical-align:text-bottom">Tipo de votación: </label>
    <select @bind="tipoVotacion" @bind:event="oninput" @onchange="BuscarVotaciones">
        <option value="-1">Todos</option>
        <option value="0">Público</option>
        <option value="1">Jurado</option>
        <option value="2">Mixta</option>
    </select>
    <label style="vertical-align:text-bottom">Permite AutoVoto: </label>
    <select @bind="permiteAutoVoto" @bind:event="oninput" @onchange="BuscarVotaciones">
        <option value="-1">Ambos</option>
        <option value="1">Sí</option>
        <option value="0">No</option>
    </select>
</div>

<div>
    <table class="tabla-votaciones">
        <thead>
            <tr>
                <th>Evento</th>
                <th>Tipo de votación</th>
                <th>Permite autovoto</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th hidden="@(verFinalizadas)">Editar</th>
                <th hidden="@(!verFinalizadas)"></th>
                <th hidden="@(!verFinalizadas)">Resultados del evento</th>
            </tr>
        </thead>
        <tbody>
            @if(votaciones == null)
            {
                <label>Cargando Votaciones ...</label>
            }
            else
            {
                @foreach (var vot in votaciones.Where(vot => verFinalizadas ? vot.EstadoVotacion == EstadoVotacion.Finalizada : vot.EstadoVotacion != EstadoVotacion.Finalizada))
                {
                    <tr>
                        <td>@eventos.FirstOrDefault(e => e.Id == vot.Id_evento)?.Nombre</td>
                        <td>@ObtenerTipoVotacion(vot)</td>
                        <td>@vot.PermiteAutoVoto</td>
                        <td>@vot.FechaInicio.ToLocalTime()</td>
                        <td>@vot.FechaFin.ToLocalTime()</td>
                        <td><button class="boton-editar" hidden="@(verFinalizadas)" @onclick='() => EditarVotacion(vot)'>Editar</button></td>
                        <td><div class="tooltip-wrapper"><button class="boton-editar" hidden="@(!verFinalizadas)" @onclick='() => VerResultados(vot)' disabled="@(!puedeVerResultados(vot))">Resultados</button>@if(!puedeVerResultados(vot)){
                                <span class="tooltip-text">@ObtenerMotivoBloqueo(vot)</span>
                                } 
                        </div></td>
                    </tr>
                }
            }

        </tbody>
    </table>

    <label class="noHayResult">@noHayResultados</label>
</div>

<a href="/CrearVotacion" class="botonLink">Crear Votacion nueva</a>

@code {
    List<Votify.Core.Entities.Evento> eventos = new();
    List<Votify.Core.Entities.Votacion> votaciones = new();
    List<Votify.Core.Entities.Votacion> votacionesActuales = new();
    private bool verFinalizadas = false;
    private string boton = "Mostrar votaciones finalizadas";
    private Guid Id_evento = Guid.Empty;
    private int tipoVotacion = -1;
    private int permiteAutoVoto = -1;
    private string noHayResultados = "";

    protected override async Task OnInitializedAsync()
    {
        eventos = await contexto.Evento.AsNoTracking().Include(e => e.Categoria).Include(e => e.Proyectos).ToListAsync();
        votaciones = await contexto.Votacion.ToListAsync();
        HayVotaciones();
    }

    private async Task EsEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarVotaciones();
        }
    }

    private async Task BuscarVotaciones()
    {
        noHayResultados = "";
        if (tipoVotacion == -1 && Id_evento == Guid.Empty && permiteAutoVoto==-1)
        {
            votaciones = await contexto.Votacion.ToListAsync();
            HayVotaciones();
        }
        else
        {
            var url = $"api/v1/votaciones/buscar?id_evento={Id_evento}&tipoVotacion={tipoVotacion}&permiteAutoVoto={permiteAutoVoto}&verFinalizadas={verFinalizadas}";
            try
            {

                var resultado = await Http.GetFromJsonAsync<List<Votify.Core.Entities.Votacion>>(url);
                votaciones = resultado ?? new List<Votify.Core.Entities.Votacion>();
            }
            catch (HttpRequestException ex)
            {
                var response = await Http.GetAsync(url);
                var contenido = await response.Content.ReadAsStringAsync();
                Console.WriteLine("ERROR API: " + contenido);
                Console.WriteLine("STATUS: " + response.StatusCode);
            }

            if (votaciones.Count == 0)
                noHayResultados = "No hay votaciones que cumplan los filtros de búsqueda";
            else
                noHayResultados = "";
        }

        StateHasChanged();
    }

    private void EditarVotacion(Votify.Core.Entities.Votacion vot)
    {
        nav.NavigateTo($"/EditarVotacion/{vot.Id}");
    }
    private bool puedeVerResultados(Votify.Core.Entities.Votacion votacion)
    {
        return ObtenerMotivoBloqueo(votacion) == null;
    }

    private string? ObtenerMotivoBloqueo(Votify.Core.Entities.Votacion votacion)
    {
        var votacionesAux = votaciones.Where(vot => (vot.Id_evento == votacion.Id_evento));
        var evento = eventos.FirstOrDefault(e => e.Id == votacion.Id_evento);
        if (evento == null)
            return "El evento no existe";
        if (evento.Proyectos == null || evento.Proyectos.Count == 0)
            return "No se han presentado proyectos para este evento";
        if (!votacionesAux.All(v => v.FechaFin <= DateTime.UtcNow))
            return "Todavía hay votaciones activas para este evento";
        return null;
    }
    private void VerResultados(Votify.Core.Entities.Votacion vot)
    {
        nav.NavigateTo($"/Dashboard/{vot.Id_evento}");
    }

    private async Task VerFinalizadas()
    {
        verFinalizadas = !verFinalizadas;
        if (verFinalizadas) boton = "Mostrar votaciones no finalizadas";
        else boton = "Mostrar votaciones finalizadas";
        await BuscarVotaciones();
    }
    private void HayVotaciones()
    {
        votacionesActuales = votaciones.Where(vot => verFinalizadas? vot.EstadoVotacion == EstadoVotacion.Finalizada: vot.EstadoVotacion != EstadoVotacion.Finalizada).ToList();
        if (votacionesActuales.Count() == 0)
            if (!verFinalizadas) noHayResultados = "No hay votaciones que no hayan finalizado";
            else noHayResultados = "No hay votaciones finalizadas";
        else if (string.IsNullOrEmpty(noHayResultados) || noHayResultados == "No hay votaciones que no hayan finalizado")
            noHayResultados = "";
    }
    private string ObtenerTipoVotacion(Votify.Core.Entities.Votacion vot)
    {
        if (vot is VotacionPublico) return "Público";
        if (vot is VotacionJurado) return "Jurado";
        if (vot is VotacionMixta) return "Mixta";
        return "Desconocido";
    }
}