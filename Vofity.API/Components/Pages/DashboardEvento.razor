@page "/DashboardEvento/{id:guid}"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using Votify.Core.DTOs

@inject HttpClient Http
@inject NavigationManager nav

@if (cargando)
{
    <div class="loading-container">
        <p>Cargando evento...</p>
    </div>
}
else if (error != null)
{
    <div class="loading-container">
        <p class="error-text">@error</p>
    </div>
}
else if (evento == null)
{
    <div class="loading-container">
        <p class="error-text">Evento no encontrado.</p>
    </div>
}
else
{
    <div class="evento-page">

        <header class="evento-header">

            <div>

                <button class="boton-secundario" @onclick="Volver">
                    ← Volver
                </button>

                <h1>@evento.Nombre</h1>

                <div class="evento-meta">
                    <span>
                        📅
                        @evento.FechaInicio.ToString("dd/MM/yyyy")
                        -
                        @evento.FechaFin.ToString("dd/MM/yyyy")
                    </span>

                    <span>•</span>

                    <span>
                        🏷️ @evento.TipoEvento
                    </span>
                </div>

            </div>

        </header>

        <section class="descripcion-card">
            @evento.Descripcion
        </section>

        <section class="categorias-filtros-card">

            <h2>Categorías</h2>

            <div class="categorias-chips">

                <button class="categoria-chip @(categoriaSeleccionadaId == null ? "activa" : "")"
                        @onclick="() => SeleccionarCategoria(null)">
                    ✓ Todas
                </button>

                @foreach (var categoria in evento.Categorias)
                {
                    <button class="categoria-chip @(categoriaSeleccionadaId == categoria.Id ? "activa" : "")"
                            @onclick="() => SeleccionarCategoria(categoria.Id)">
                        @categoria.Nombre
                    </button>
                }

            </div>

        </section>

        <section class="grid-principal dashboard-grid">

            <article class="card info-card">

                <h2>Información del evento</h2>

                <img class="evento-img"
                     src="@(string.IsNullOrWhiteSpace(evento.ImagenUrl)
                        ? "img/evento-default.jpg"
                        : evento.ImagenUrl)"
                     alt=""
                     onerror="this.style.display='none'" />

                <div class="info-row">
                    <span class="icono">📅</span>

                    <strong>Fecha</strong>

                    <p>
                        @evento.FechaInicio.ToString("dd/MM/yyyy")
                        -
                        @evento.FechaFin.ToString("dd/MM/yyyy")
                    </p>
                </div>

                <div class="info-row">
                    <span class="icono">🏷️</span>

                    <strong>Tipo</strong>

                    <p>@evento.TipoEvento</p>
                </div>

                <div class="info-row">
                    <span class="icono">👤</span>

                    <strong>Organizador</strong>

                    <p>@evento.Organizador</p>
                </div>

            </article>

            <article class="card lista-card">

                <h2>Proyectos</h2>

                <div class="lista">

                    @foreach (var proyecto in ProyectosMostrados)
                    {
                        <div class="proyecto-desplegable">

                            <div class="lista-item proyecto-clickable"
                                 @onclick="() => ToggleProyecto(proyecto.ProyectoId)">

                                @proyecto.TituloProyecto

                                <span class="flecha-proyecto @(proyectoDesplegadoId == proyecto.ProyectoId ? "abierta" : "")">
                                    ›
                                </span>
                            </div>

                            @if (proyectoDesplegadoId == proyecto.ProyectoId)
                            {
                                <div class="proyecto-detalle">

                                    <div class="proyecto-creador">
                                        <span class="detalle-label">Creado por</span>
                                        <strong>@proyecto.CreadorNombre</strong>
                                    </div>

                                    @if (proyecto.Materiales?.Any() == true)
                                    {
                                        <div class="materiales-proyecto">
                                            @foreach (var material in proyecto.Materiales)
                                            {
                                                var materialUrl = GetMaterialUrl(material);

                                                if (!string.IsNullOrWhiteSpace(materialUrl))
                                                {
                                                    <a class="material-link @GetMaterialClass(material.Tipo)"
                                                       href="@materialUrl"
                                                       target="_blank"
                                                       rel="noopener noreferrer"
                                                       title="@material.Nombre">
                                                        <span class="material-texto">@GetMaterialLabel(material)</span>
                                                    </a>
                                                }
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="sin-material">Sin material disponible</span>
                                    }

                                </div>
                            }

                        </div>
                    }

                </div>

            </article>

            <article class="card votaciones-card">

                <h2>Votaciones</h2>

                @foreach (var votacion in VotacionesMostradas)
                {
                    <div class="votacion-box">

                        <span class="estado @(votacion.Estado == "En curso"
                            ? "estado-verde"
                            : votacion.Estado == "Finalizada"
                                ? "estado-gris"
                                : "estado-morado")">

                            ● @votacion.Estado
                        </span>

                        <h3>@votacion.Nombre</h3>

                        <p>
                            📅
                            @votacion.FechaInicio.ToString("dd/MM/yyyy HH:mm")
                            -
                            @votacion.FechaFin.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        @if (votacion.Estado == "En curso")
                        {
                            <button class="btn-primary"
                                    @onclick="() => irAEvento(evento.Id)">
                                Ir a votar
                            </button>
                        }
                        else if (votacion.Estado == "Finalizada")
                        {
                            <button class="btn-secondary"
                                    @onclick='() => VerDashboard(evento.Id)'>
                                Ver resultados
                            </button>
                        }

                    </div>
                }

            </article>

            <article class="card premiados-card-dashboard">

                <h2>🏆 Premiados</h2>

                @if (evento.Premios == null || !evento.Premios.Any())
                {
                    <div class="premiados-dashboard-content">
                        <div class="trofeo-dashboard">🏆</div>

                        <h3>Aún no hay premios</h3>

                        <p>
                            Los premios se publicarán cuando el organizador los registre.
                        </p>
                    </div>
                }
                else
                {
                    <div class="premios-lista">

                        @foreach (var premio in PremiosMostrados)
                        {
                            <div class="premio-item @(premio.TieneGanador ? "premio-con-ganador" : premio.VotacionFinalizada ? "premio-finalizado-sin-ganador" : "premio-pendiente")">

                                <img class="premio-img"
                                     src="@(string.IsNullOrWhiteSpace(premio.ImagenUrl)
                            ? "img/premio-default.jpg"
                            : premio.ImagenUrl)"
                                     alt=""
                                     onerror="this.style.display='none'" />

                                <div class="premio-info">

                                    <div class="premio-badges">
                                        <span class="premio-puesto">@premio.Puesto Puesto</span>

                                        @if (premio.TieneGanador)
                                        {
                                            <span class="premio-ganador-badge">GANADOR</span>
                                        }
                                        else
                                        {
                                            <span class="premio-pendiente-badge">PENDIENTE</span>
                                        }
                                    </div>

                                    <h3>
                                        @(premio.TieneGanador
                                            ? premio.NombreProyectoGanador
                                            : premio.Nombre)
                                    </h3>

                                    <p>@premio.Descripcion</p>

                                    <span class="premio-votacion">
                                        📅 @premio.NombreVotacion
                                    </span>

                                    @if (PremiosMostrados == null || !PremiosMostrados.Any())
                                    {
                                        <span class="premio-puntuacion">
                                            ⭐ @premio.PuntuacionGanador puntos
                                        </span>
                                    }

                                </div>

                            </div>
                        }

                    </div>
                }

            </article>
        </section>

    </div>
}

@code {
    [Parameter]
    public Guid id { get; set; }

    private EventoDetalleDTO? evento;
    private bool cargando = true;
    private string? error;
    private Guid? categoriaSeleccionadaId = null;
    private Guid? proyectoDesplegadoId = null;

    private IEnumerable<ProyectoDashboardDTO> ProyectosMostrados =>
    evento == null
        ? Enumerable.Empty<ProyectoDashboardDTO>()
        : categoriaSeleccionadaId == null
            ? evento.Proyectos
            : evento.Proyectos.Where(p => p.IdCategoriaEvento == categoriaSeleccionadaId);

    private IEnumerable<VotacionDetalleDTO> VotacionesMostradas =>
    evento == null
        ? Enumerable.Empty<VotacionDetalleDTO>()
        : categoriaSeleccionadaId == null
            ? evento.Votaciones
            : evento.Votaciones.Where(v =>
                v.IdCategoriaEvento == categoriaSeleccionadaId
                || v.IdCategoriaEvento == null
                || v.IdCategoriaEvento == Guid.Empty);

    private IEnumerable<PremioDetalleDTO> PremiosMostrados =>
    evento == null
        ? Enumerable.Empty<PremioDetalleDTO>()
        : categoriaSeleccionadaId == null
            ? evento.Premios
            : evento.Premios.Where(p => p.IdCategoriaEvento == categoriaSeleccionadaId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            evento = await Http.GetFromJsonAsync<EventoDetalleDTO>(
                $"api/Eventos/{id}/detalle"
            );
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void Volver()
    {
        nav.NavigateTo("/Home");
    }

    private void irAEvento(Guid eventoId)
    {
        nav.NavigateTo($"/Votacion_evento/{eventoId}");
    }

    private void VerDashboard(Guid eventoId)
    {
        nav.NavigateTo($"/Dashboard/{eventoId}");
    }

    private void SeleccionarCategoria(Guid? idCategoria)
    {
        categoriaSeleccionadaId = idCategoria;
    }

    private void ToggleProyecto(Guid idProyecto)
    {
        proyectoDesplegadoId = proyectoDesplegadoId == idProyecto
            ? null
            : idProyecto;
    }

    private string GetProxyUrl(string url) =>
        $"/api/miniaturas/from-url?url={Uri.EscapeDataString(url)}";

    private string GetMaterialUrl(MaterialDto material)
    {
        if (string.IsNullOrWhiteSpace(material.Url))
            return string.Empty;

        return material.Tipo == "Imagen"
            ? GetProxyUrl(material.Url)
            : material.Url;
    }

    private static string GetMaterialLabel(MaterialDto material)
    {
        var prefijo = material.Tipo switch
        {
            "Imagen" => "Imagen",
            "Video" => "Video",
            "Enlace" => "Enlace",
            "Archivo" => "Archivo",
            _ => "Material"
        };

        return string.IsNullOrWhiteSpace(material.Nombre)
            ? prefijo
            : $"{prefijo}: {material.Nombre}";
    }

    private static string GetMaterialClass(string tipo) => tipo switch
    {
        "Imagen" => "material-imagen",
        "Video" => "material-video",
        "Enlace" => "material-enlace",
        _ => "material-archivo"
    };
}