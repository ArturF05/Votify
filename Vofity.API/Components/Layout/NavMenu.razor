@inject IJSRuntime JS
@inject NavigationManager nav
﻿
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Votify</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <button class="nav-link btn btn-link" @onclick="ConfirmarLogout">
                <img src="CerrarSesion.png" class="nav-icon" /> Cerrar Sesión
            </button>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="home">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="evento">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Gestionar Eventos
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="GestionarVotaciones">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Gestionar Votaciones
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="VerResultados">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Ver Resultados
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="MisProyectos">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Mis Proyectos
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="votacion">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Votar proyectos
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Ayuda">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Ayuda
            </NavLink>
        </div>
    </nav>
</div>
@code{
    private async Task ConfirmarLogout()
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Seguro que quieres cerrar sesión?");

        if (confirmado)
        {
            nav.NavigateTo("");
        }
    }
}
