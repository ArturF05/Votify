@page "/Evento"
<h2 class="titulo">Eventos</h2>

<PageTitle>Evento</PageTitle>
<div class="barra-busqueda">
    <input type="text" placeholder="Buscar eventos..." />
    <select>
        <option>Hackaton</option>
        <option>Futbolín</option>
    </select>
    <button @onclick='() => BuscarEventos()'>Buscar</button>
</div>

<!-- ESTO CAMBIA. QUE SEA VARIABLE PARA LOS EVENTOS QUE HAYA -->
<div>
    <table class="tabla-eventos">
        <thead>
            <tr>
                <th>Evento</th>
                <th>Categoría</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Editar</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Pequeños Informáticos</td>
                <td>Hackaton</td>
                <td>13/12/2006</td>
                <td>14/12/2006</td>
                <td><button class="boton-editar" @onclick='() => EditarEvento()'>Editar</button></td>
            </tr>
            <tr>
                <td>Torneo de futbolín</td>
                <td>Futbolín</td>
                <td>13/02/2006</td>
                <td>14/02/2006</td>
                <td><button class="boton-editar" @onclick='() => EditarEvento()'>Editar</button></td>
            </tr>
        </tbody>
    </table>
</div>

<!-- AL EDITAR SE AUTOCOMPLETA -->
<div class="form-evento">
    <h3>Crear o editar evento</h3>
    <hr class="linea">
    <div class="campo">
        <label>Título:</label>
        <input type="text" placeholder="Título del evento..." />
    </div>

    <div class="form-grid">
        <div class="campo">
            <label>Categoría:</label>
            <select>
                <option>Hackaton</option>
                <option>Futbolín</option>
            </select>
        </div>
        <div class="campo campo-derecha">
            <label>Fecha de inicio:</label>
            <input type="date" @bind="fechaAct" />
        </div>
        <div class="campo">
            <label>Descripción:</label>
            <textarea placeholder="Descripción..."></textarea>
        </div>
        <div class="campo campo-derecha">
            <label>Fecha de cierre:</label>
            <input type="date" @bind="fechaMañana" />
        </div>
    </div>

    <div class="botones">
        <div>
            <button class="boton-secundario" @onclick='() => EliminarEvento()'>Eliminar</button>
        </div>
        <div>
            <button class="boton-secundario" @onclick='() => ArchivarEvento()'>Archivar</button>
            <button class="boton-principal" @onclick='() => CrearEvento()'>Crear Evento</button>
        </div>
    </div>
</div>

