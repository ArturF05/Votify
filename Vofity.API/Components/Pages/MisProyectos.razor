@page "/MisProyectos"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Votify.Core.Interfaces
@using Votify.Core.DTOs
@inject NavigationManager nav
@inject ProtectedSessionStorage sessionStorage
@inject IMaterialService MaterialService
@inject IJSRuntime JS

<div class="materiales-page">
    <NavigationLock ConfirmExternalNavigation="true"
                    OnBeforeInternalNavigation="ConfirmarSalida" />
    <h1 class="page-titulo">Materiales del Proyecto</h1>

    @if (cargando)
    {
        <div class="estado-carga">
            <p>Cargando proyectos...</p>
        </div>
    }
    else if (!proyectos.Any())
    {
        <div class="estado-vacio">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" />
            </svg>
            <p>No tienes proyectos registrados.</p>
        </div>
    }
    else
    {
        <div class="proyectos-tabs-wrapper">
            @foreach (var proyecto in proyectos)
            {
                int count = proyecto.Materiales.Count;
                bool esActivo = proyectoSeleccionado?.ProyectoId == proyecto.ProyectoId;
                <button class="tab-btn @(esActivo ? "tab-activo" : "")"
                        @onclick="() => SeleccionarProyecto(proyecto)">
                    @proyecto.Titulo
                    <span class="tab-badge @(esActivo ? "tab-badge-activo" : "")">@count</span>
                </button>
            }
        </div>

        @if (proyectoSeleccionado != null)
        {
            <div class="proyecto-panel">
                <div class="proyecto-header">
                    <div class="proyecto-info">
                        <h2 class="proyecto-nombre">@proyectoSeleccionado.Titulo</h2>
                    </div>
                    <button class="btn-anadir" @onclick="MostrarFormulario">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                        Añadir Material
                    </button>
                </div>

                @if (mostrarFormulario)
                {
                    <div class="form-anadir">
                        <div class="form-row">
                            <div class="form-campo">
                                <label class="form-label">Nombre del material</label>
                                <input type="text" class="form-input" @bind="nuevoNombre"
                                       placeholder="Ej: Logo principal" />
                            </div>
                            <div class="form-campo">
                                <label class="form-label">Tipo</label>
                                <select class="form-input" @onchange="OnTipoCambiado">
                                    <option value="Imagen">Imagen</option>
                                    <option value="Archivo">Archivo</option>
                                    <option value="Enlace">Enlace</option>
                                    <option value="Video">Video</option>
                                </select>
                            </div>
                        </div>

                        @if (nuevoTipo == "Imagen" || nuevoTipo == "Archivo")
                        {
                            <div class="form-campo">
                                <label class="form-label">Archivo</label>
                                <InputFile OnChange="OnArchivoSeleccionado"
                                           accept="@acceptFile"
                                           class="form-input-file"
                                           @key="fileInputKey" />

                                @if (archivoBytes != null)
                                {
                                    <p class="form-info">Archivo listo (@nombreArchivo)</p>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="form-campo">
                                <label class="form-label">URL</label>
                                <input type="text" class="form-input" @bind="nuevoValor" placeholder="https://" />
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <p class="form-error">@mensajeError</p>
                        }

                        <div class="form-acciones">
                            <button class="btn-form-cancelar" @onclick="CancelarFormulario">Cancelar</button>
                            <button class="btn-form-agregar" @onclick="AgregarMaterial">Agregar a la lista</button>
                        </div>
                    </div>
                }

                <div class="materiales-lista">
                    @if (!proyectoSeleccionado.Materiales.Any())
                    {
                        <div class="materiales-vacios">
                            <p>Sin materiales aún. Haz clic en "Añadir Material" para comenzar.</p>
                        </div>
                    }
                    @foreach (var material in proyectoSeleccionado.Materiales)
                    {
                        <div class="material-item">
                            <div class="material-icono icono-@material.Tipo.ToLower()">
                                @((MarkupString)GetIconoSvg(material.Tipo))
                            </div>
                            <div class="material-info">
                                <span class="material-nombre">@material.Nombre</span>
                                <div class="material-meta">
                                    <span class="material-tipo tipo-@material.Tipo.ToLower()">@material.Tipo</span>

                                    @if (material.Tipo == "Enlace" || material.Tipo == "Video")
                                    {
                                        <a href="@material.Url" target="_blank" class="material-url">
                                            @material.Url
                                        </a>
                                    }
                                    else if (material.Tipo == "Imagen")
                                    {
                                        <img src="@GetProxyUrl(material.Url)" class="material-thumbnail" />
                                    }
                                    else if (material.Tipo == "Archivo")
                                    {

                                        @if (!string.IsNullOrWhiteSpace(material.Url))
                                        {
                                            <a href="@material.Url" target="_blank">
                                                Descargar archivo
                                            </a>
                                        }
                                    }
                                    <span class="material-fecha">Subido: @material.FechaSubida.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                            <button class="btn-eliminar" @onclick="async () => await EliminarMaterial(material.Id)">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    }

    <div class="footer-acciones">
        <button class="btn-cancelar" @onclick='() => nav.NavigateTo("/AltaProyecto")'>Crear proyecto</button>
        <button class="btn-guardar" @onclick="GuardarCambios" disabled="@(guardando || !hayCambios)">
            @if (guardando)
            {
                <span>Guardando...</span>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span>Guardar Cambios</span>
            }
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <p class="form-exito">@mensajeExito</p>
    }
</div>

@code {
    private bool cargando = true;
    private bool guardando = false;
    private bool mostrarFormulario = false;
    private bool hayCambios = false;

    private string mensajeError = "";
    private string mensajeExito = "";
    private Guid idUsuario;

    private List<ProyectoConMaterialesDto> proyectos = new();
    private ProyectoConMaterialesDto? proyectoSeleccionado;

    // Variables del formulario
    private string nuevoNombre = "";
    private string nuevoTipo = "Imagen";
    private string nuevoValor = "";
    private string acceptFile = ".jpg,.jpeg,.png";
    private byte[]? archivoBytes;
    private string? nombreArchivo;
    private int fileInputKey = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarProyectosAsync();
            StateHasChanged();
        }
    }

    private async Task CargarProyectosAsync()
    {
        var result = await sessionStorage.GetAsync<Guid>("IdUsuario");
        if (!result.Success || result.Value == Guid.Empty)
        {
            nav.NavigateTo("/Login");
            return;
        }

        idUsuario = result.Value;
        proyectos = await MaterialService.ObtenerProyectosUsuario(idUsuario);

        if (proyectos.Any())
        {
            proyectoSeleccionado = proyectos.First();
        }

        cargando = false;
    }

    private void SeleccionarProyecto(ProyectoConMaterialesDto proyecto)
    {
        proyectoSeleccionado = proyecto;
        mostrarFormulario = false;
        mensajeError = "";
        mensajeExito = "";
    }

    private void MostrarFormulario()
    {
        mensajeError = "";
        mostrarFormulario = true;
    }
    private void OnTipoCambiado(ChangeEventArgs e)
    {
        nuevoTipo = e.Value?.ToString() ?? "Imagen";

        acceptFile = nuevoTipo switch
        {
            "Imagen" => ".jpg,.jpeg,.png",
            "Archivo" => ".pdf,.doc,.docx,.txt,.ppt,.pptx,.zip,.tgz",
            _ => "*/*"
        };

        archivoBytes = null;
        nombreArchivo = null;
        fileInputKey++;
    }
    private async Task OnArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        var file = e.File;
        const long max = 5 * 1024 * 1024; // 5MB

        if (file.Size > max)
        {
            mensajeError = "Archivo demasiado grande (máx 5MB)";
            return;
        }
        var extensionesPermitidas = new[]
        {
            ".jpg", ".jpeg", ".png", ".txt", ".pdf", ".doc", ".docx"
        }; 
        var extension = Path.GetExtension(file.Name).ToLower();

        if (!extensionesPermitidas.Contains(extension))
        {
            mensajeError = "Tipo de archivo no permitido";
            return;
        }
        nombreArchivo = file.Name;

        using var stream = file.OpenReadStream(maxAllowedSize: max);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        archivoBytes = ms.ToArray();
    }

    private void AgregarMaterial()
    {
        mensajeError = "";
        hayCambios = true;
        if (string.IsNullOrWhiteSpace(nuevoNombre)) { mensajeError = "El nombre es obligatorio"; return; }

        if ((nuevoTipo == "Imagen" || nuevoTipo == "Archivo") && archivoBytes == null)
        {
            mensajeError = "Debes seleccionar un archivo";
            return;
        }
        else // Enlace
        {
            if (string.IsNullOrWhiteSpace(nuevoValor) || !nuevoValor.StartsWith("http"))
            {
                mensajeError = "Debes introducir una URL válida";
                return;
            }
        }

        hayCambios = true;

        proyectoSeleccionado!.Materiales.Add(new MaterialDto
        {
            Id = null,
            Nombre = nuevoNombre,
            Tipo = nuevoTipo,
            Url = nuevoTipo == "Imagen" ? "" : nuevoValor,
            Valor = nuevoTipo == "Imagen" ? "" : nuevoValor, // El service usa Valor para la lógica
            ArchivoBytes = archivoBytes,
            NombreArchivo = nombreArchivo,
            FechaSubida = DateTime.Now
        });

        CancelarFormulario();
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        nuevoNombre = ""; nuevoTipo = "Imagen"; nuevoValor = ""; mensajeError = "";
        archivoBytes = null; nombreArchivo = null;
    }

    private async Task EliminarMaterial(Guid? id)
    {
        if (proyectoSeleccionado == null || !id.HasValue) return;

        var material = proyectoSeleccionado.Materiales.FirstOrDefault(x => x.Id == id);
        if (material == null) return;

        
        var confirmado = await JS.InvokeAsync<bool>("confirm",
            "¿Seguro que quieres eliminar este material?");

        if (!confirmado)
            return;

        if (!material.EsNuevo)
        {
            await MaterialService.EliminarMaterial(id.Value);
        }
        else
        {
            hayCambios = true;
        }

        proyectoSeleccionado.Materiales.Remove(material);
    }

    private async Task GuardarCambios()
    {
        if (proyectoSeleccionado == null) return;

        guardando = true;
        mensajeError = ""; mensajeExito = "";

        try
        {
            await MaterialService.GuardarMateriales(proyectoSeleccionado.ProyectoId, proyectoSeleccionado.Materiales);
            mensajeExito = "Materiales guardados correctamente";

            // Recargamos para ver los cambios y obtener IDs de Azure/BD
            proyectos = await MaterialService.ObtenerProyectosUsuario(idUsuario);
            proyectoSeleccionado = proyectos.FirstOrDefault(p => p.ProyectoId == proyectoSeleccionado.ProyectoId);

            mostrarFormulario = false;
        }
        catch (Exception ex)
        {
            mensajeError = "Error al guardar: " + ex.Message;
        }
        finally
        {
            guardando = false;
            hayCambios = false;
        }
    }
    private async Task ConfirmarSalida(LocationChangingContext context)
    {
        if (!hayCambios)
            return;

        var confirmado = await JS.InvokeAsync<bool>("confirm",
            "Tienes cambios sin guardar. ¿Seguro que quieres salir?");

        if (!confirmado)
        {
            context.PreventNavigation();
        }
    }

    private string GetProxyUrl(string url)
        => $"/api/miniaturas/from-url?url={Uri.EscapeDataString(url)}";

    private static string GetIconoSvg(string tipo) => tipo switch
    {
        "Imagen" => "<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2'><path stroke-linecap='round' stroke-linejoin='round' d='M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z' /></svg>",
        "Video" => "<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2'><path stroke-linecap='round' stroke-linejoin='round' d='M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z' /></svg>",
        _ => "<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2'><path stroke-linecap='round' stroke-linejoin='round' d='M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244' /></svg>"
    };
}