@page "/Votacion_evento/{id:guid}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Votify.Core.DTOs
@using Votify.Core.Entities
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@using Votify.Infrastructure.Repositorios
@using Votify.Core.Interfaces
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@inject NavigationManager nav;
@inject AppDbContext contexto
@inject HttpClient Http
@inject ProtectedSessionStorage sessionStorage
@inject IVotacion VotacionService
@inject UsuarioSesion usuarioSesion

    

<div class="votacion-evento-page">
    @if (evento == null)
    {
        <div class="estado-card">
            <label>Cargando proyectos...</label>
        </div>
    }
    else if (evento.Proyectos == null || evento.Proyectos.Count == 0)
    {
        <div class="page-header">
            <h2 class="titulo">Proyectos del evento @evento.Nombre</h2>
            <p class="subtitulo">Selecciona tus proyectos favoritos</p>
        </div>

        <div class="estado-card">
            <label>No se han presentado proyectos para este evento todavía</label>
        </div>
    }
    else
    {
        <div class="page-header">
            <h2 class="titulo">Proyectos del evento @evento.Nombre</h2>
            <p class="subtitulo">Selecciona tus @NumProy proyectos favoritos</p>
        </div>

        <div class="proyecto-container">
            @foreach (var proyecto in evento.Proyectos)
            {
                <div class="proyecto-card @(yaVoto ? "deshabilitado" : "")">
                    <div class="proyecto-top">
                        <button class="boton-favorito" @onclick="() => Favorito(proyecto.Id)" disabled="@yaVoto">
                            <img src="@(proyectosSeleccionados.Contains(proyecto.Id)
                                ? "/EsFavorito.jpg"
                                : "/Estrella.png")"
                                 alt="Símbolo Favorito"
                                 class="estrella-img" />
                        </button>
                    </div>

                    <div class="proyecto-header">
                        <div class="proyecto-nombre">@proyecto.Titulo</div>
                    </div>

                    @if (proyectosSeleccionados.Contains(proyecto.Id))
                    {
                        <div class="criterios-proyecto">
                            <hr class="linea-criterios" />

                            @foreach (var criterio in criterios)
                            {
                                <div class="criterio-fila">
                                    <span class="criterio-nombre-voto">@criterio.Nombre</span>

                                    <input type="number"
                                           min="0"
                                           max="10"
                                           class="input-puntuacion"
                                           value="@puntuacionesPorProyecto[proyecto.Id][criterio.Id]"
                                           @oninput="(e) => notaValida(e, proyecto.Id, criterio.Id)" />
                                </div>
                            }
                            @if (proyectosSeleccionados.Contains(proyecto.Id)){
                            <div class="comentario-container">
                                <textarea @bind="comentariosPorProyecto[proyecto.Id]"
                                          placeholder="@(yaVoto ? "" : "Escribe tu comentario aquí...")"
                                          class="textarea-comentario">
                        </textarea>
                            </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div class="acciones">
        <div class="acciones-izquierda">
            <button type="button" class="boton-secundario" @onclick='() => Volver()'>Volver</button>
        </div>

        <div class="acciones-derecha">
            @if (PuedeVerResultados())
            {
                <button type="button" class="boton-secundario" @onclick='() => VerResultados()'>
                    Ver Resultados
                </button>
            }
            <button type="button" class="boton-principal" disabled="@yaVoto" @onclick='() => EnviarVoto()'>Enviar Voto</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="mensaje-estado">@mensaje</div>
    }
</div>

@code{
    private Votify.Core.Entities.Evento? evento;
    [Parameter]
    public Guid id { get; set; }
    private List<Guid> proyectosSeleccionados = new();
    private Guid idVotacion;
    private Votify.Core.Entities.Votacion? votacion;
    private Guid idVotante;
    private int? NumProy = 0;
    private string mensaje = "";
    private Dictionary<Guid, string> comentariosPorProyecto = new();
    private Votify.Core.Entities.Usuario usuario;
    private bool yaVoto = false;
    private List<DimensionesDeValor> criterios = new();
    private Dictionary<Guid, Dictionary<Guid, int>> puntuacionesPorProyecto = new();


    protected override async Task OnInitializedAsync()
    {
        evento = await contexto.Evento.Include(e => e.Proyectos).FirstOrDefaultAsync(e => e.Id == id);
        votacion = await contexto.Votacion.Where(vot => vot.Id_evento == evento.Id && vot.FechaFin.CompareTo(DateTime.UtcNow) > 0 && vot.FechaInicio.CompareTo(DateTime.UtcNow) <= 0).FirstOrDefaultAsync();
        NumProy = votacion.NumProy;


        if (votacion != null)
        {
            NumProy = votacion.NumProy;
            idVotacion = votacion.Id;
            mensaje = $"DEBUG -> NumProy = {NumProy}";
        }
        if (evento == null)
        {
            mensaje = "No se ha encontrado el evento.";
            return;
        }

        criterios = await contexto.DimensionesDeValor.Where(d => d.Id_votacion == votacion.Id).ToListAsync();

        foreach (var proyecto in evento.Proyectos)
        {
            if (!comentariosPorProyecto.ContainsKey(proyecto.Id))
                comentariosPorProyecto[proyecto.Id] = "";

            if (!puntuacionesPorProyecto.ContainsKey(proyecto.Id))
                puntuacionesPorProyecto[proyecto.Id] = new Dictionary<Guid, int>();

            foreach (var criterio in criterios)
            {
                if (!puntuacionesPorProyecto[proyecto.Id].ContainsKey(criterio.Id))
                    puntuacionesPorProyecto[proyecto.Id][criterio.Id] = 0;
            }
        }

        ProtectedBrowserStorageResult<Guid> resultado;
        try
        {
            resultado = await sessionStorage.GetAsync<Guid>("IdUsuario");
            if (resultado.Success)
            {
                idVotante = resultado.Value;
                usuarioSesion.IdUsuario = resultado.Value;
                usuario = await contexto.Usuario.Include(u => u.Rol).Include(u => u.ProyectoParticipantes).FirstOrDefaultAsync(u => u.Id == idVotante);
                yaVoto = await VotacionService.YaVotoAsync(idVotacion, idVotante);

                if (yaVoto)
                {
                    mensaje = "Ya has votado en este evento.";
                    List<Voto> votos = await VotacionService.ObtenerVotosUsuarioAsync(idVotacion, idVotante);
                    foreach (var voto in votos)
                    {
                        proyectosSeleccionados.Add(voto.Id_proyecto);
                        comentariosPorProyecto[voto.Id_proyecto] = voto.Comentario ?? "";
                    }
                }
                StateHasChanged();
            }
            if (!resultado.Success || resultado.Value == Guid.Empty)
            {
                return;
            }
        }
        catch (Exception e)
        {
            return;
        }

    }
    private void Favorito(Guid idProyecto)
    {
        if (yaVoto) return;
        if (proyectosSeleccionados.Contains(idProyecto))
        {
            proyectosSeleccionados.Remove(idProyecto);
        }
        else
        {
            if (proyectosSeleccionados.Count < NumProy)
            {
                proyectosSeleccionados.Add(idProyecto);
                comentariosPorProyecto[idProyecto] = "";
            }
        }
    }

    private async Task EnviarVoto()
    {
        if (idVotante == Guid.Empty)
        {
            mensaje = "Error: No se detecta una sesión activa. Por favor, reingresa.";
            return;
        }

        if (usuario == null)
        {
            mensaje = "No se ha encontrado el usuario autenticado.";
            await Task.Delay(900);
            nav.NavigateTo("/Login");
            return;
        }
        if (evento == null)
        {
            mensaje = "No se ha podido cargar el evento.";
            return;
        }

        if (idVotacion == Guid.Empty)
        {
            mensaje = "No hay una votación activa para este evento, espera a que haya una para poder votar.";
            return;
        }
        if (proyectosSeleccionados.Count != NumProy)
        {
            mensaje = "Debes seleccionar exactamente "+ NumProy + "  proyectos para votar.";
            return;
        }

        foreach (var idProyecto in proyectosSeleccionados)
        {
            if (!puntuacionesPorProyecto.ContainsKey(idProyecto))
            {
                mensaje = "Faltan puntuaciones en uno de los proyectos seleccionados.";
                return;
            }

            foreach (var criterio in criterios)
            {
                if (!puntuacionesPorProyecto[idProyecto].ContainsKey(criterio.Id))
                {
                    mensaje = $"Falta la puntuación del criterio {criterio.Nombre} en uno de los proyectos.";
                    return;
                }

                int nota = puntuacionesPorProyecto[idProyecto][criterio.Id];

                if (nota < 0 || nota > 10)
                {
                    mensaje = $"La puntuación del criterio {criterio.Nombre} debe estar entre 0 y 10.";
                    return;
                }
            }
        }

        // evitar votos duplicados  
        var yaVoto = await contexto.Voto
            .AnyAsync(v => v.Id_votante == usuario.Id && v.Id_votacion == idVotacion);

        var votoDto = new EmitirVotoDTO
        {
            IdVotante = usuario.Id,
            Votos = proyectosSeleccionados.Select(idProyecto => new VotoDetalleDTO
            {
                IdProyecto = idProyecto,
                Comentario = comentariosPorProyecto.ContainsKey(idProyecto)
                    ? comentariosPorProyecto[idProyecto]
                    : string.Empty,
                Puntuaciones = criterios.Select(c => new PuntuacionCriterioDTO
                {
                    CriterioId = c.Id,
                    Valor = puntuacionesPorProyecto[idProyecto][c.Id]
                }).ToList()
            }).ToList(),
            IdEvento = evento.Id
        };

        try
        {
            await VotacionService.RegistrarVotoAsync(idVotacion, votoDto);
            mensaje = "Voto enviado correctamente.";
            yaVoto = true;
        }
        catch (Exception ex)
        {
            mensaje = ex.Message; 
        }
    }

    void Volver()
    {
        nav.NavigateTo("/Votacion");
    }

    void VerResultados()
    {
        nav.NavigateTo($"/Dashboard/{evento.Id}");
    }

    private bool PuedeVerResultados()
    {
        if (votacion == null)
            return false;

        DateTime hoy = DateTime.UtcNow;

        return votacion.FechaFin <= hoy;
    }

    private void notaValida(ChangeEventArgs e, Guid idProyecto, Guid idCriterio)
    {
        if (!int.TryParse(e.Value?.ToString(), out int valor))
            valor = 0;

        if (valor < 0)
            valor = 0;
        else if (valor > 10)
            valor = 10;

        puntuacionesPorProyecto[idProyecto][idCriterio] = valor;
    }
}