@page "/DashboardOrganizador"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using Votify.API.DTOs
@using Votify.Core.Entities
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Votify.Infrastructure.Data
@using Votify.Core.Services;
@inject ProtectedSessionStorage sessionStorage
@inject NavigationManager nav
@inject HttpClient Http
@inject AppDbContext contexto

<PageTitle>Dashboard Organizador - Votify </PageTitle>
  <div class="layout">
      <header class="main-header">
        <div>
            <h1>Dashboard Organizador</h1>
            <p>Control de eventos, votaciones y resultados.</p>
        </div>
        <div class="dashboard-switcher" aria-label="Cambiar tipo de dashboard">
            <button type="button" class="active">Organizador</button>
            <button type="button" @onclick='() => nav.NavigateTo("/DashboardCompetidor")'>Competidor</button>
        </div>
      </header>
      <div class="estadisticas-grid">
          <!--Eventos activos-->
        <div class="card estadistica-card">
          <div class="estadistica-content">
            <div>
                <p class="estadistica-label">Eventos Activos</p>
                @if(numEventos!= null)
                {
                    <p class="estadistica-value">@numEventos</p>
                } else 
                {
                    <p class="estadistica-value">—</p> 
                }
            </div>
            <div class="estadistica-icono amber">
              <img src="/calendario.png" />
            </div>
          </div>
        </div>
        <!--Proyectos totales-->
        <div class="card estadistica-card">
          <div class="estadistica-content">
            <div>
              <p class="estadistica-label">Proyectos Totales</p>
                @if(numProyectos!= null)
                {
                    <p class="estadistica-value">@numProyectos</p>
                } else
                {
                    <p class="estadistica-value">—</p>
                }
                    </div>
            <div class="estadistica-icono blue">
              <img src="/proyecto.png" />
            </div>
          </div>
        </div>
        <!--Número participantes-->
        <div class="card estadistica-card">
          <div class="estadistica-content">
            <div>
              <p class="estadistica-label">Participantes</p>
                @if(numParticipantes!= null)
                {
                    <p class="estadistica-value">@numParticipantes</p>
                } else 
                {
                    <p class="estadistica-value">—</p> 
                }
            </div>
            <div class="estadistica-icono green">
              <img src="/Usuarios.png" />
            </div>
          </div>
        </div>
        <!--Votos emitidos-->
        <div class="card estadistica-card">
          <div class="estadistica-content">
            <div>
              <p class="estadistica-label">Votos Emitidos</p>
                    @if (numVotos != null)
                    {
                        <p class="estadistica-value">@numVotos</p>
                    }
                    else
                    {
                        <p class="estadistica-value">—</p>
                    }
            </div>
            <div class="estadistica-icono violet">
              <img src="/Votos.png" />
            </div>
          </div>
        </div>
      </div>

      <section class="card premios-dashboard-card">
          <div class="card-header premios-dashboard-header">
              <h2 class="card-title">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 003-3v-3.75a3 3 0 00-3-3h-9a3 3 0 00-3 3v3.75a3 3 0 003 3m9 0v1.5A2.25 2.25 0 0114.25 22.5h-4.5A2.25 2.25 0 017.5 20.25v-1.5m9-9V6.75A3.75 3.75 0 0012.75 3h-1.5A3.75 3.75 0 007.5 6.75V9" />
                  </svg>
                  Premios configurados
              </h2>
              <button class="btn-create" @onclick='() => nav.NavigateTo("GestionPremios")'>
                  Gestionar premios
              </button>
          </div>

          <div class="card-content premios-dashboard-content">
              @if (!cargado)
              {
                  <div class="loading-box">
                      <div class="spinner"></div>
                      <p>Cargando premios...</p>
                  </div>
              }
              else if (!string.IsNullOrWhiteSpace(mensajePremiosDashboard))
              {
                  <p class="voting-empty">@mensajePremiosDashboard</p>
              }
              else if (!premiosDashboard.Any())
              {
                  <p class="voting-empty">Todavia no hay premios definidos para tus eventos.</p>
              }
              else
              {
                  <div class="premios-dashboard-list">
                      @foreach (var premio in premiosDashboard.Take(8))
                      {
                          var imagen = string.IsNullOrWhiteSpace(premio.ImagenUrl)
                              ? null
                              : GetProxyUrl(premio.ImagenUrl);

                          <article class="premio-dashboard-item">
                              @if (string.IsNullOrWhiteSpace(imagen))
                              {
                                  <div class="premio-dashboard-placeholder">@premio.Orden</div>
                              }
                              else
                              {
                                  <img src="@imagen" alt="Imagen de @premio.Nombre" />
                              }

                              <div class="premio-dashboard-info">
                                  <strong>@premio.Nombre</strong>
                                  <span>@premio.EventoNombre · @premio.CategoriaNombre · Puesto @premio.Puesto</span>
                                  @if (!string.IsNullOrWhiteSpace(premio.Descripcion))
                                  {
                                      <p>@premio.Descripcion</p>
                                  }
                              </div>

                              <span class="premio-dashboard-meta">@premio.NumVotaciones vot.</span>
                          </article>
                      }
                  </div>
              }
          </div>
      </section>

      <div class="dos-col-grid">
        <!-- Votaciones en Curso -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z"></path>
              </svg>
                        Votaciones en Curso
            </h2>
            <button class="btn-create" @onclick='() => { nav.NavigateTo("CrearVotacion");}'>
                + Crear votación
            </button>
          </div>
 
                <div class="card-content">
                    <div class="voting-list">
                        @if (!cargado)
                        {
                            <div class="loading-box">
                                <div class="spinner"></div>
                                <p>Cargando votaciones...</p>
                            </div>
                        }
                        else if (votaciones == null || !votaciones.Any(v =>
                            v.EstadoVotacion == EstadoVotacion.Abierta ||
                            v.EstadoVotacion == EstadoVotacion.Pausada ))
                        {
                            <p class="voting-empty">No hay votaciones disponibles.</p>
                        }
                        else
                        {
                            @foreach (var vot in votaciones.Where(v =>
                                v.EstadoVotacion == EstadoVotacion.Abierta ||
                                v.EstadoVotacion == EstadoVotacion.Pausada).OrderBy(v => v.FechaFin))
                            {
                                var nombreEvento = eventos.FirstOrDefault(e => e.Id == vot.Id_evento)?.Nombre ?? "—";
                                var pctFecha = CalcularPorcentajeFecha(vot.FechaInicio, vot.FechaFin);
                                var pctStr = pctFecha.ToString("0") + "%";
                                var puedeVer = PuedeVerResultados(vot);
                                var motivo = ObtenerMotivoBloqueo(vot);
                                var estadoBadge = ObtenerClaseBadgeEstado(vot.EstadoVotacion);
                                var estadoLabel = ObtenerEtiquetaEstado(vot.EstadoVotacion);
                                var finalizaPronto = FinalizaPronto(vot.FechaFin);
                                <div class="voting-item">
                                    <div class="voting-header">
                                        <span class="voting-title">@nombreEvento</span>
                                        <div class="voting-actions">
                                            <span class="badge @estadoBadge">@estadoLabel</span>
                                            @if (finalizaPronto)
                                            {
                                                <span class="badge badge-danger">
                                                    Finaliza pronto
                                                </span>
                                            }
                                             <div class="tooltip-wrapper">
                                                <button class="btn-results @(puedeVer ? "" : "btn-results--disabled")"
                                                        @onclick="() => { if (puedeVer) VerDashboard(vot.Id_evento); }"
                                                        disabled="@(!puedeVer)">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                              d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51
                                                        7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178
                                                        .07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12
                                                        19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    </svg>
                                                    Ver resultados
                                                </button>
                                                @if (!puedeVer && motivo != null)
                                                {
                                                    <span class="tooltip-text">@motivo</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
 
                                    <!-- Barra de progreso temporal: desde FechaInicio hasta FechaFin -->
                                    <div class="voting-stats">
                                        <span>@vot.FechaInicio.ToLocalTime().ToString("dd/MM/yyyy HH:mm") → @vot.FechaFin.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                        <span>@pctStr transcurrido</span>
                                    </div>
                                    <div class="voting-extra-info">

                                        <span>
                                            @(numVotosVotaciones.ContainsKey(vot.Id)? numVotosVotaciones[vot.Id]: 0)
                                            votos emitidos
                                        </span>

                                        <span>·</span>
                                        <span>
                                            Tipo de votacion:
                                            @(vot.Tipo.ToString())
                                        </span>
                                        @if (vot.Tipo != TipoVotacion.Jurado)
                                        {
                                            <span>·</span>
                                            <span>
                                                Autovoto @(vot.PermiteAutoVoto ? "Sí" : "No")
                                            </span>
                                        }
                                    </div>
                                    <div class="progress-bar">
                                        <div class="progress-fill" style="width: @pctStr"></div>
                                    </div>
 
                                    <!-- Fecha fin -->
                                    <div class="voting-date">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                             stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        Finaliza: @vot.FechaFin.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                            }
                        }
 
                    </div>
                </div>
            </div>
            <!-- Eventos Recientes -->
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5
                                 A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25
                                 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25
                                 0 0121 11.25v7.5" />
                    </svg>
                    Eventos Recientes
                </h2>
                <button class="btn-create" @onclick='() => { nav.NavigateTo("CrearEvento"); }'>
                    + Crear evento
                </button>
            </div>

            <div class="card-content">
                <div class="events-list">
                    @if (!cargado)
                    {
                        <div class="loading-box">
                            <div class="spinner"></div>
                            <p>Cargando eventos...</p>
                        </div>
                    }
                    else if (eventos == null || !eventos.Any())
                    {
                        <p class="voting-empty">No hay eventos disponibles.</p>
                    }
                    else
                    {
                        <!-- Muestra los 6 más recientes (por FechaInicio) -->
                        @foreach (var evt in eventos
                            .OrderByDescending(e => e.FechaInicio)
                            .Take(6))
                        {
                            var evtLocal     = evt;
                            var esActivo     = !evtLocal.Archivado;
                            var badgeClass   = esActivo ? "badge-green" : "badge-gray";
                            var badgeLabel   = esActivo ? "Activo" : "Archivado";
                            var numProy = numProyectosEvento.ContainsKey(evtLocal.Id) ? numProyectosEvento[evtLocal.Id] : 0;

                            var fechaMostrar = evtLocal.FechaFin.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
                            var puedeVer = PuedeVerResultadosEvento(evtLocal.Id);
                            var motivo = ObtenerMotivoBloqueoEvento(evtLocal);
                            var finalizaPronto = FinalizaPronto(evtLocal.FechaFin);
                            <div class="event-item">
                                <div class="event-info">
                                    <div>
                                        <p class="event-name">@evtLocal.Nombre</p>
                                        <p class="event-projects">@numProy proyectos · @(numVotosEvento.ContainsKey(evtLocal.Id) ? numVotosEvento[evtLocal.Id] : 0) votos</p>
                                        @if (TieneVotacionActiva(evtLocal.Id))
                                        {
                                            <span class="mini-status green">
                                                Votación activa
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="event-meta">
                                    <div class="event-status-group">
                                        <span class="badge @badgeClass">@badgeLabel</span>
                                        @if (finalizaPronto)
                                        {
                                            <span class="badge badge-danger">
                                                Finaliza pronto
                                            </span>
                                        }
                                        <p class="event-date">Finaliza: @fechaMostrar</p>
                                    </div>
                                    <button class="btn-info"
                                                @onclick='() => nav.NavigateTo($"/DashboardEvento/{evtLocal.Id}")'> 
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0
                                                     005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5
                                                     6L21 3m0 0h-5.25M21 3v5.25" />
                                        </svg>
                                        Ver info
                                    </button>
                                    <div class="tooltip-wrapper">
                                        <button class="btn-results @(puedeVer ? "" : "btn-results--disabled")"
                                                @onclick="() => { if (puedeVer) VerDashboard(evtLocal.Id); }"
                                                disabled="@(!puedeVer)">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                                    viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                        d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51
                                                7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178
                                                .07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12
                                                19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            </svg>
                                            Ver resultados
                                        </button>
                                        @if (!puedeVer && motivo != null)
                                        {
                                            <span class="tooltip-text">@motivo</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }

                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private int? numEventos;
    private int? numProyectos;
    private int? numParticipantes;
    private int? numVotos;
    private List<Votify.Core.Entities.Evento> eventos = new();
    private List<Votify.Core.Entities.Votacion> votaciones = new()!;
    private Dictionary<Guid, int> numVotosEvento = new(); 
    private Dictionary<Guid, int> numVotosVotaciones = new();
    private Dictionary<Guid, int> numProyectosEvento = new();
    private List<PremioDashboardItem> premiosDashboard = new();
    private string mensajePremiosDashboard = "";
    private Guid idUsuario;
    private bool cargado = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var resultado = await sessionStorage.GetAsync<Guid>("IdUsuario");
        if (!resultado.Success || resultado.Value == Guid.Empty)
        {
            nav.NavigateTo("/Login");
            return;
        }

        idUsuario = resultado.Value;

        // Cargar eventos del organizador
        var url = $"api/eventos/organizador?idUsuario={idUsuario}";
        eventos = await Http.GetFromJsonAsync<List<Votify.Core.Entities.Evento>>(url);

        foreach(Votify.Core.Entities.Evento e in eventos)
        {
            url = $"api/eventos/numVotos?idEvento={e.Id}";
            var nVE = await Http.GetFromJsonAsync<int>(url);
            numVotosEvento[e.Id] = nVE;
            url = $"api/eventos/numProyectos?idEvento={e.Id}";
            var nProy = await Http.GetFromJsonAsync<int>(url);
            numProyectosEvento[e.Id] = nProy;
        }

        // Cargar votaciones de los eventos donde el usuario es Organizador
        var eventosIds = eventos.Select(e => e.Id).ToList();
        await CargarPremiosDashboard(eventosIds);

        var query = string.Join("&", eventosIds.Select(id => $"idsEventos={id}"));
        url = $"api/v1/votaciones/votEventos?{query}";

        votaciones = await Http.GetFromJsonAsync<List<Votify.Core.Entities.Votacion>>(url);
        foreach(Votify.Core.Entities.Votacion v in votaciones)
        {
            url = $"api/v1/votaciones/votosVotacion?idVotacion={v.Id}";
            var votos = await Http.GetFromJsonAsync<List<Voto>>(url);
            numVotosVotaciones[v.Id] = votos.Count;
        }
        var statsUrl = $"api/eventos/estadisticas-organizador?idUsuario={idUsuario}";
        var stats = await Http.GetFromJsonAsync<DashboardOrganizadorStatsDTO>(statsUrl);
        if (stats != null)
        {
            numEventos = stats.EventosActivos;
            numProyectos = stats.ProyectosTotales;
            numParticipantes = stats.Participantes;
            numVotos = stats.VotosEmitidos;
        }
        cargado = true;
        StateHasChanged();
    }

    private async Task CargarPremiosDashboard(List<Guid> eventosIds)
    {
        premiosDashboard = new();
        mensajePremiosDashboard = "";

        if (!eventosIds.Any())
            return;

        try
        {
            var premios = await contexto.Premio
                .AsNoTracking()
                .Include(p => p.CategoriaEvento)
                .Include(p => p.PremioVotaciones)
                .Where(p => p.CategoriaEvento != null && eventosIds.Contains(p.CategoriaEvento.Id_evento))
                .OrderBy(p => p.CategoriaEvento!.Nombre)
                .ThenBy(p => p.Orden)
                .ThenBy(p => p.Nombre)
                .ToListAsync();

            premiosDashboard = premios.Select(p =>
            {
                var evento = eventos.FirstOrDefault(e => e.Id == p.CategoriaEvento?.Id_evento);

                return new PremioDashboardItem
                {
                    Nombre = p.Nombre,
                    Descripcion = p.Descripcion,
                    ImagenUrl = p.ImagenUrl,
                    Orden = p.Orden,
                    Puesto = p.Puesto,
                    CategoriaNombre = p.CategoriaEvento?.Nombre ?? "Categoria",
                    EventoNombre = evento?.Nombre ?? "Evento",
                    NumVotaciones = p.PremioVotaciones.Count
                };
            }).ToList();
        }
        catch (Exception ex)
        {
            var detalle = ex.InnerException?.Message ?? ex.Message;
            mensajePremiosDashboard = $"No se pudieron cargar los premios: {detalle}";
        }
    }
    private bool FinalizaPronto(DateTime fechaFin)
    {
        return fechaFin.ToUniversalTime() <= DateTime.UtcNow.AddHours(24)
            && fechaFin.ToUniversalTime() > DateTime.UtcNow;
    }
    private bool TieneVotacionActiva(Guid idEvento)
    {
        return votaciones.Any(v =>
            v.Id_evento == idEvento &&
            v.EstadoVotacion == EstadoVotacion.Abierta);
    }
    private bool PuedeVerResultadosEvento(Guid idEvento)
    {
        return votaciones
           .Where(v => v.Id_evento == idEvento)
           .Any(PuedeVerResultados);
    }
    private bool PuedeVerResultados(Votify.Core.Entities.Votacion votacion)
      => ObtenerMotivoBloqueo(votacion) == null;

    private string? ObtenerMotivoBloqueo(Votify.Core.Entities.Votacion votacion)
    {
        var evento = eventos.FirstOrDefault(e => e.Id == votacion.Id_evento);

        if (evento == null)
            return "El evento no existe";

        var numProyectos = numProyectosEvento.ContainsKey(evento.Id)
            ? numProyectosEvento[evento.Id]
            : 0;

        if (numProyectos == 0)
            return "No se han presentado proyectos para este evento";

        switch (votacion.EstadoVotacion)
        {
            case EstadoVotacion.Finalizada:
                return null;

            case EstadoVotacion.Abierta:
            case EstadoVotacion.Pausada:

                if (votacion.VerRes)
                    return null;

                return "Los resultados no están disponibles mientras la votación no haya finalizado";

            default:
                return "La votación todavía no ha comenzado";
        }
    }
    private string? ObtenerMotivoBloqueoEvento(Votify.Core.Entities.Evento evento)
    {
        var votsEvento = votaciones
            .Where(v => v.Id_evento == evento.Id)
            .OrderByDescending(v => v.FechaInicio)
            .ToList();

        if (!votsEvento.Any())
            return "Este evento no tiene votaciones";

        if (votsEvento.Any(PuedeVerResultados))
            return null;

        var votacionRelevante = votsEvento
            .OrderBy(v => Math.Abs((v.FechaFin - DateTime.UtcNow).TotalSeconds))
            .First();

        return ObtenerMotivoBloqueo(votacionRelevante);
    }

    private void VerDashboard(Guid Id_evento)
      => nav.NavigateTo($"/Dashboard/{Id_evento}");
 
    private double CalcularPorcentajeFecha(DateTime inicio, DateTime fin)
    {
        var ahora = DateTime.UtcNow;
        if (ahora <= inicio) return 0;
        if (ahora >= fin) return 100;
        var total = (fin - inicio).TotalSeconds;
        var transcurrido = (ahora - inicio).TotalSeconds;
        return Math.Round(transcurrido / total * 100, 1);
    }
 
    private string ObtenerClaseBadgeEstado(EstadoVotacion estado) => estado switch
    {
        EstadoVotacion.Abierta => "badge-green",
        EstadoVotacion.Pausada => "badge-amber",   
        EstadoVotacion.Finalizada => "badge-gray",
        _ => "badge-gray"
    };
 
    private string ObtenerEtiquetaEstado(EstadoVotacion estado) => estado switch
    {
        EstadoVotacion.Abierta => "En curso",
        EstadoVotacion.Pausada => "Pausada",
        EstadoVotacion.Finalizada => "Finalizada",
        _ => estado.ToString()
    };

    private string GetProxyUrl(string url)
        => $"/api/miniaturas/from-url?url={Uri.EscapeDataString(url)}";

    private class PremioDashboardItem
    {
        public string Nombre { get; set; } = "";
        public string? Descripcion { get; set; }
        public string? ImagenUrl { get; set; }
        public int Orden { get; set; }
        public int Puesto { get; set; }
        public string CategoriaNombre { get; set; } = "";
        public string EventoNombre { get; set; } = "";
        public int NumVotaciones { get; set; }
    }
}
 

