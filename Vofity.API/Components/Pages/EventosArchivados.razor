@page "/EventosArchivados"
@using Microsoft.EntityFrameworkCore
@using System.Net.Http.Json
@using Votify.Core.Entities
@using Votify.Infrastructure.Data
@inject NavigationManager nav
@inject AppDbContext contexto
@inject HttpClient Http
@rendermode InteractiveServer

<div class="titulo-y-archivados">
    <h2 class="titulo">Eventos Archivados</h2>
</div>

<PageTitle>Evento</PageTitle>

<div>
    <table class="tabla-eventos">
        <thead>
            <tr>
                <th>Evento</th>
                <th>Categoría</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Desarchivar</th>
                <th>Eliminar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var evento in eventos.Where(e => e.Archivado == true))
            {
                <tr>
                    <td>@evento.Nombre</td>
                    <td>@evento.Categoria.Nombre</td>
                    <td>@evento.FechaInicio</td>
                    <td>@evento.FechaFin</td>
                    <td><button class="boton-desarchivar" @onclick='() => Desarchivar(evento.Id)'>Desarchivar</button></td>
                    <td><button class="boton-desarchivar" @onclick='() => Eliminar(evento.Id)'>Eliminar</button></td>
                </tr>
            }
        </tbody>
    </table>

    <label>@noHayArchivados</label>
</div>

<button type="button" class="boton-cancelar" @onclick="Volver">Volver</button>

@code {
    List<Votify.Core.Entities.Evento> eventos = new();
    private string noHayArchivados = "";

    protected override async Task OnInitializedAsync()
    {
        eventos = await contexto.Evento.AsNoTracking().Include(e => e.Categoria).ToListAsync();
        HayEventos();
    }

    private async Task Desarchivar(Guid eventoId)
    {
        try
        {
            var response = await Http.PatchAsync(
                $"api/eventos/{eventoId}/archivo?archivar=false",
                new StringContent("")
            );

            if (response.IsSuccessStatusCode)
            {
                eventos = await contexto.Evento.AsNoTracking().Include(e => e.Categoria).ToListAsync();
                HayEventos();
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                noHayArchivados = $"No se pudo desarchivar el evento: {error}";
            }
        }
        catch (Exception ex)
        {
            noHayArchivados = $"Error al desarchivar: {ex.Message}";
        }
    }

    private void Volver()
    {
        nav.NavigateTo("/Evento");
    }

    private void HayEventos()
    {
        if (eventos.Where(e => e.Archivado == true).Count() == 0)
            noHayArchivados = "No hay eventos archivados";
        else
            noHayArchivados = "";
    }

    private async Task Eliminar(Guid eventoId)
    {
        var response = await Http.DeleteAsync($"api/eventos/{eventoId}");

        if (response.IsSuccessStatusCode)
        {
            eventos = await contexto.Evento.AsNoTracking().Include(e => e.Categoria).ToListAsync();
            HayEventos();
            StateHasChanged();
        }
        else
        {
            noHayArchivados = "No se pudo eliminar el evento";
        }
    }
}