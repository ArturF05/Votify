@page "/Evento"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using System.Net.Http.Json
@using Votify.Core.Entities
@using Votify.Infrastructure.Data
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject NavigationManager nav
@inject AppDbContext contexto
@inject HttpClient Http
@inject ProtectedSessionStorage sessionStorage
@rendermode InteractiveServer

<PageTitle>Gestión de eventos - Votify</PageTitle>
<div class="eventos-page">

<div class="titulo-y-archivados">
    <div>
        <h2 class="titulo">Eventos</h2>
        <p class="subtitulo">Gestiona tus propios eventos</p>
    </div>

    <button class="boton-archivados" @onclick="VerArchivados">
        Archivados <img src="/Archivados.png" alt="Símbolo Archivados" class="archivados-img" />
    </button>
</div>

<div class="busqueda-card">
    <div class="barra-busqueda">
    <input @bind="busqueda" @bind:event="oninput" type="text" placeholder="Buscar eventos..." @onkeypress="EsEnter" />
    <label class="categoria-label">Categoria: </label>
        <select @bind="Id_Categoria" @bind:event="oninput" @onchange="BuscarEventos">
            <option value="@Guid.Empty">Todas</option>
            @foreach (var cat in categorias)
            {
                <option value="@cat.Id">@cat.Nombre</option>
            }
        </select>
    <button @onclick="BuscarEventos">Buscar</button>
    </div>
</div>
</div>
<div class="tabla-card">
    <div class="tabla-wrapper">
    <table class="tabla-eventos">
        <thead>
            <tr>
                <th>Evento</th>
                <th>Categoría</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Editar</th>
                <th>Archivar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var evento in eventos.Where(e => e.Archivado == false))
            {
                <tr>
                    <td>@evento.Nombre</td>
                    <td>@evento.Categoria.Nombre</td>
                    <td>@evento.FechaInicio</td>
                    <td>@evento.FechaFin</td>
                    <td><button class="boton-secundario" @onclick='() => EditarEvento(evento)'>Editar</button></td>
                    <td><button class="boton-secundario" @onclick='() => Archivar(evento.Id)'>Archivar</button></td>
                </tr>
            }
        </tbody>
    </table>

    <label class="noHayResult">@noHayResultados</label>
</div>

<div class="acciones-inferiores">
    <a href="/CrearEvento" class="boton-principal">Crear Evento</a>
</div>

</div>
@code {
    List<Votify.Core.Entities.Evento> eventos = new();
    List<Categoria> categorias = new();

    private string busqueda = "";
    private Guid Id_Categoria = Guid.Empty;
    private string noHayResultados = "";
    private Guid idUsuario;

    protected override async Task OnInitializedAsync()
    {
        ProtectedBrowserStorageResult<Guid> resultado;
        try
        {
            resultado = await sessionStorage.GetAsync<Guid>("IdUsuario");
            bool resSuccess = !resultado.Success;
            bool resIsEmpty = resultado.Value == Guid.Empty;
            if (resSuccess || resIsEmpty)
            {
                nav.NavigateTo("/Login");
                return;
            }
        }
        catch (Exception e)
        {
            nav.NavigateTo("/Login");
            return;
        }

        idUsuario = resultado.Value;

        eventos = await contexto.Evento
            .AsNoTracking()
            .Include(e => e.Categoria)
            .Where(e => contexto.EventoUsuarioRol
                .Include(eur => eur.Rol)
                .Any(eur => eur.EventoId == e.Id
                         && eur.UsuarioId == idUsuario
                         && eur.Rol.Nombre == "Organizador"))
            .ToListAsync();
        categorias = await contexto.Categoria.ToListAsync();
        HayEventos();
    }

    private async Task EsEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarEventos();
        }
    }

    private async Task BuscarEventos()
    {
        if (string.IsNullOrWhiteSpace(busqueda) && Id_Categoria == Guid.Empty)
        {
            eventos = await contexto.Evento
            .AsNoTracking()
            .Include(e => e.Categoria)
            .Where(e => contexto.EventoUsuarioRol
                .Include(eur => eur.Rol)
                .Any(eur => eur.EventoId == e.Id
                         && eur.UsuarioId == idUsuario
                         && eur.Rol.Nombre == "Organizador"))
            .ToListAsync();
            noHayResultados = "";
            HayEventos();
        }
        else
        {
            string nombreBusqueda = busqueda ?? "";
            var url = $"api/eventos/buscar?nombre={nombreBusqueda}&idCategoria={Id_Categoria}&idUsuario={idUsuario}";

            var resultado = await Http.GetFromJsonAsync<List<Votify.Core.Entities.Evento>>(url);
            eventos = resultado ?? new List<Votify.Core.Entities.Evento>();

            if (eventos.Count == 0)
                noHayResultados = "No se han encontrado resultados para la búsqueda realizada";
            else
                noHayResultados = "";
        }

        StateHasChanged();
    }

    private void EditarEvento(Votify.Core.Entities.Evento evento)
    {
        nav.NavigateTo($"/EditarEvento/{evento.Id}");
    }

    private void VerArchivados()
    {
        nav.NavigateTo("/EventosArchivados");
    }

    private async Task Archivar(Guid eventoId)
    {
        try
        {
            var response = await Http.PatchAsync($"api/eventos/{eventoId}/archivo?archivar=true",new StringContent(""));

            if (response.IsSuccessStatusCode)
            {
                eventos = await contexto.Evento
                .AsNoTracking()
                .Include(e => e.Categoria)
                .Where(e => contexto.EventoUsuarioRol
                    .Include(eur => eur.Rol)
                    .Any(eur => eur.EventoId == e.Id
                        && eur.UsuarioId == idUsuario
                        && eur.Rol.Nombre == "Organizador"))
                .ToListAsync();

                noHayResultados = "";
                HayEventos();
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                noHayResultados = $"No se pudo archivar el evento: {error}";
            }
        }
        catch (Exception ex)
        {
            noHayResultados = $"Error al archivar: {ex.Message}";
        }
    }
    private void HayEventos()
    {
        if (eventos.Where(e => e.Archivado == false).Count() == 0)
            noHayResultados = "No hay eventos";
        else if (string.IsNullOrEmpty(noHayResultados) || noHayResultados == "No hay eventos")
            noHayResultados = "";
    }
}