@page "/Perfil"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Votify.Core.Interfaces
@inject IUsuarioRepository UsuarioRepo
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Nav
<PageTitle>Mi Perfil - Votify</PageTitle>

<div class="page">
    <div class="header">
        <h1>Mi <span>Perfil</span></h1>
        <p>Gestiona tu información personal</p>
    </div>

    @if (cargando)
    {
        <div class="section">
            <p class="cargando">Cargando...</p>
        </div>
    }
    else
    {
        <div class="perfil-card">
            <div class="avatar">@inicial</div>
            <div class="perfil-info">
                <div class="perfil-nombre">@nombreUsuario</div>
                <div class="perfil-badge">Participante</div>
            </div>
        </div>

        <div class="section">
            <h2>Correo electrónico</h2>
            <p class="seccion-desc">Recibe notificaciones cuando se abra una votación en tus eventos.</p>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert @(exito ? "alert-success" : "alert-error")">
                    <span>@mensaje</span>
                </div>
            }

            <div class="form-group">
                <label class="field-label">Correo electrónico</label>
                <input type="email" @bind="email" placeholder="tu@correo.com" class="form-input" />
            </div>

            <div class="acciones">
                <button class="btn-guardar" @onclick="GuardarEmail" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar cambios")
                </button>
            </div>
        </div>
    }
</div>

@code {
    private string? email;
    private string nombreUsuario = "";
    private string inicial = "?";
    private string mensaje = "";
    private bool exito = false;
    private bool cargando = true;
    private bool guardando = false;
    private Guid idUsuario;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var resultado = await SessionStorage.GetAsync<Guid>("IdUsuario");
            if (!resultado.Success || resultado.Value == Guid.Empty)
            {
                Nav.NavigateTo("/Login");
                return;
            }

            idUsuario = resultado.Value;
            var usuario = await UsuarioRepo.ObtenerPorIdAsync(idUsuario);
            if (usuario == null)
            {
                Nav.NavigateTo("/Login");
                return;
            }

            nombreUsuario = usuario.Nombre;
            inicial = string.IsNullOrEmpty(usuario.Nombre) ? "?" : usuario.Nombre[0].ToString().ToUpper();
            email = usuario.Email;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task GuardarEmail()
    {
        guardando = true;
        mensaje = "";

        await UsuarioRepo.ActualizarEmailAsync(idUsuario, email);

        mensaje = "Correo actualizado correctamente";
        exito = true;
        guardando = false;
    }
}
