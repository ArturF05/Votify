@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IJSRuntime JS
@inject NavigationManager nav
@inject ProtectedSessionStorage sessionStorage
﻿
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand">Votify</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <div class="user-menu-wrapper">
            <!-- Botón que muestra el nombre y abre el desplegable -->
            <button class="user-menu-trigger" @onclick="ToggleMenu">
                <div class="user-avatar">
                    @(string.IsNullOrEmpty(nombreUsuario) ? "?" : nombreUsuario[0].ToString().ToUpper())
                </div>
                <span class="user-name">@(nombreUsuario ?? "Usuario")</span>
                <!-- Chevron que rota al abrir -->
                <svg class="chevron @(menuAbierto ? "chevron-open" : "")"
                     xmlns="http://www.w3.org/2000/svg" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
            </button>

            <!-- Desplegable -->
            @if (menuAbierto)
            {
                <div class="user-dropdown">
                    <button class="user-dropdown-item user-dropdown-logout"
                            @onclick="ConfirmarLogout">
                        <!-- Icono de salida -->
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0
                            01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3
                            3 0 013 3v1" />
                        </svg>
                        Cerrar sesión
                    </button>
                </div>
            }
        </div>
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="home">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="DashboardOrganizador">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="evento">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Gestionar Eventos
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="GestionarVotaciones">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Gestionar Votaciones
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="GestionPremios">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Gestionar Premios
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="VerResultados">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Ver Resultados
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="MisProyectos">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Mis Proyectos
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="votacion">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Votar proyectos
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Ayuda">
                <svg class="nav-help-icon" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14Zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16Z" />
                    <path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286Zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94Z" />
                </svg>
                Ayuda
            </NavLink>
        </div>
    </nav>
</div>
@code{
    private string? nombreUsuario;
    private bool menuAbierto = false;
    private bool cargado = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || cargado) return;

        var resultado = await sessionStorage.GetAsync<string>("NombreUsuario");
        if (resultado.Success)
            nombreUsuario = resultado.Value;

        cargado = true;
        StateHasChanged();
    }

    private void ToggleMenu() => menuAbierto = !menuAbierto;

    private async Task ConfirmarLogout()
    {
        menuAbierto = false;
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Seguro que quieres cerrar sesión?");
        if (confirmado)
            nav.NavigateTo("");
    }
}
