@page "/Login"
@rendermode InteractiveServer
@using Votify.Core.Interfaces
@inject ILogin LoginWindow
@inject ILogger<Login> Logger

<h3>Iniciar Sesión</h3>

<EditForm Model="@modelo" OnValidSubmit="LoginUsuario" FormName="loginForm">
    <div>
        <label>Usuario</label>
        <InputText @bind-Value="modelo.Usuario" /> 
    </div>

    <div>
        <label>Contraseña</label>
        <InputText type="password" @bind-Value="modelo.Password" /> 
    </div>

    <button type="submit">Entrar</button>
</EditForm>

@if (!string.IsNullOrEmpty(mensaje))
{
    <p style="color: @(loginExitoso ? "green" : "red")">@mensaje</p>
}

@code {
    private LoginModel modelo = new();
    private string mensaje = "";
    private bool loginExitoso = false;

    private async Task LoginUsuario()
    {

        var resultado = await LoginWindow.ValidarUsuarioAsync(modelo.Usuario, modelo.Password);
         
        if (resultado)
        {
            mensaje = "¡Login correcto!";
            loginExitoso = true;
            }
        else
        {
            mensaje = "Usuario o contraseña incorrectos";
            loginExitoso = false;
            }
        
    }
    public class LoginModel
    {
        public string Usuario { get; set; } = "";
        public string Password { get; set; } = "";
    }
}