    private void AnadirCategoriaEvento()
    {
        mensajeCategoria = "";

        if (string.IsNullOrWhiteSpace(nombreNuevaCategoria))
        {
            mensajeCategoria = "El nombre es obligatorio";
            return;
        }

        if (categoriasEvento.Any(c =>
            c.Nombre.Equals(nombreNuevaCategoria.Trim(),
            StringComparison.OrdinalIgnoreCase)))
        {
            mensajeCategoria = "Ya existe una categoría con ese nombre";
            return;
        }

        categoriasEvento.Add(new CategoriaEvento
        {
            Id = Guid.NewGuid(),
            Id_evento = Id_evento,
            Nombre = nombreNuevaCategoria.Trim()
        });

        nombreNuevaCategoria = "";
        mensajeErrorCriterio = "";
        hayCambios = true;
    }
    private async Task GuardarVotacion()
    {
        if (guardandoVotacion)
            return;

        guardandoVotacion = true;
        textoGuardando = "Guardando cambios...";
        mensaje = "";
        mensaje2 = "";
        mensajeErrorCriterio = "";

        errorGuardado = false;
        try
        {
            votaciones = await contexto.Votacion.ToListAsync();

            bool franjaUsada = false;

            foreach (var vot in votaciones.Where(v => v.Id != votacion.Id && v.Id_evento == Id_evento))
            {
                if (inicioVotacion.CompareTo(vot.FechaInicio) >= 0 && inicioVotacion.CompareTo(vot.FechaFin) <= 0)
                {
                    franjaUsada = true;
                    break;
                }

                if (
                    (tipoVotacion == TipoVotacion.Publico && vot is VotacionPublico) ||
                    (tipoVotacion == TipoVotacion.Jurado && vot is VotacionJurado) ||
                    (tipoVotacion == TipoVotacion.Mixto && vot is VotacionMixta)
                )
                {
                    tipoUsado = true;
                    break;
                }
            }

            if (finVotacion.CompareTo(inicioVotacion) <= 0)
            {
                mensaje2 = "El final de la votación debe ser posterior al inicio";
                errorGuardado = true;
                return;
            }

            if (franjaUsada)
            {
                mensaje = "Hay una votación en esta franja de tiempo, no se permiten votaciones concurrentes";
                return;
            }

            if (tipoUsado)
            {
                mensaje = "Ya hay una votación de este tipo registrada para este evento";
                errorGuardado = true;
                return;
            }

            if (NumProy <= 0)
            {
                mensaje = "Se tiene que poder votar mínimo 1 proyecto";
                errorGuardado = true;
                return;
            }

            var categoriasDeLaVotacion = categoriasEvento
                .Where(categoria => idCategoriaVotacion == Guid.Empty || categoria.Id == idCategoriaVotacion)
                .ToList();

            foreach (var categoria in categoriasDeLaVotacion)
            {
                var criteriosCategoria = criterios
                    .Where(c => c.Id_categoria_evento == categoria.Id)
                    .ToList();

                if (!criteriosCategoria.Any())
                {
                    mensajeErrorCriterio = $"La categoría {categoria.Nombre} debe tener al menos un criterio";
                    errorGuardado = true;
                    return;
                }

                if (criteriosCategoria.Sum(c => c.Peso) != 100)
                {
                    mensajeErrorCriterio = $"La suma de pesos de la categoría {categoria.Nombre} debe ser 100";
                    errorGuardado = true;
                    return;
                }
            }
            foreach (var categoria in categoriasEvento)
            {
                bool existe = await contexto.CategoriaEvento
                    .AnyAsync(c => c.Id == categoria.Id);
                if (!existe)
                {
                    await contexto.CategoriaEvento.AddAsync(categoria);
                }
            }

            await contexto.SaveChangesAsync();
            var dto = new CrearVotacionDTOs
            {
                Id_evento = Id_evento,
                Id_categoria_evento = idCategoriaVotacion == Guid.Empty ? null : idCategoriaVotacion,
                FechaInicio = LocalInputToUtc(inicioVotacion),
                FechaFin = LocalInputToUtc(finVotacion),
                PermiteAutoVoto = permiteAutoVoto == 1,
                TipoVotacion = tipoVotacion,
                VerRes = verRes == 1,
                Num_Proy = NumProy,
                Jurados = juradoSeleccionado.Select(u => u.Id).ToList(),
                EstadoVotacion = estadoVotacion,
                Criterios = criterios
                    .Where(c => idCategoriaVotacion == Guid.Empty || c.Id_categoria_evento == idCategoriaVotacion)
                    .Select(c => new Votify.Core.DTOs.CrearCriterioDTO
                    {
                        Id = c.Id,
                        IdCategoriaEvento = c.Id_categoria_evento,
                        Nombre = c.Nombre,
                        Descripcion = c.Descripcion,
                        Peso = c.Peso
                    }).ToList(),
                PermiteComentarios = permiteComentarios == 1,
                ComentariosObligatorios = comentariosObligatorios == 1
            };

            var response = await Http.PutAsJsonAsync($"api/v1/votaciones/{id}", dto);

            if (response.IsSuccessStatusCode)
            {
                hayCambios = false;
                await JS.InvokeVoidAsync("history.back");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensaje = $"No se pudo editar la votación: {error}";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
        finally
        {
            guardandoVotacion = false;
            textoGuardando = "Guardar Cambios";
        }
    }
    async Task ConfirmarEliminar()
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Seguro que quieres eliminar esta votación? Esta acción no es reversible");

        if (confirmado)
        {
            await EliminarVotacion();
        }
    }
    async Task EliminarVotacion()
    {
        if (votacion == null)
            return;

        var response = await Http.DeleteAsync($"api/v1/votaciones/{id}");

        if (response.IsSuccessStatusCode)
        {
            hayCambios = false;
            await JS.InvokeVoidAsync("history.back");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            mensaje = $"No se pudo eliminar la votación: {error}";
        }
    }

    private void GuardarCriterio()
    {
        if (idCategoriaCriterio == Guid.Empty)
        {
            mensajeErrorCriterio = "Selecciona la categoría del criterio";
            return;
        }

        if(nombreCriterio == "")
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Debes asignar un nombre al criterio";
            return;
        }

        if (descripcionCriterio == "")
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Debes asignar una descripción al criterio";
            return;
        }

        if (criterios.Any(c => c.Id_categoria_evento == idCategoriaCriterio && c.Nombre == nombreCriterio))
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Ya existe un criterio con ese nombre en esta categoría";
            return;
        }

        criterios.Add(new DimensionesDeValor
        {
            Id = Guid.NewGuid(),
            Id_votacion = votacion.Id,
            Id_categoria_evento = idCategoriaCriterio,
            Nombre = nombreCriterio,
            Descripcion = descripcionCriterio,
            Peso = 0
        });
        
        nombreCriterio = "";
        descripcionCriterio = "";
        mensajeErrorCriterio = "";
        mensajeNoCriterio = "";
        pesoCriterio = 0;
        hayCambios = true;
    }
    
    private void QuitarCriterio(Guid idCriterio)
    {
        hayCambios = true;
        criterios.RemoveAll(c => c.Id == idCriterio);
    }

    private string NombreCategoria(Guid idCategoria)
