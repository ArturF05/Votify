@page "/Register"
@rendermode InteractiveServer
@using Votify.API.Components.Layout
@using Votify.Core.Interfaces
@inject IRegister RegisterWindow
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations;
@layout NoLayout
<PageTitle>Registrarse - Votify </PageTitle>
<div class="register-container">
    <div class="register-card">
        <div class="register-header">
            <div class="logo-container">
                <img src="/Images/Logo.png" alt="Votify Logo" class="logo-img" />
            </div>

            <p class="register-subtitle">Tu voz, tu voto, tu decisión</p>
        </div>

        <EditForm Model="@modelo" OnValidSubmit="RegisterUsuario" FormName="registerForm" class="register-form">
            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert @(registroExitoso ? "alert-success" : "alert-error")">
                    <img src="/Images/Alerta-Icono.png" alt="Alerta" class="Alerta-img" />
                    <span>@mensaje</span>
                </div>
            }

            <div class="form-group">
                <label for="usuario" class="usu-contra-titulo">Nombre de Usuario</label>
                <input id="usuario" maxlength="50"
                       value="@modelo.Usuario"
                       @oninput='e => modelo.Usuario = e.Value?.ToString()?.Length > 50 ? e.Value.ToString()[..50] : e.Value?.ToString() ?? ""'
                       placeholder="Elige un nombre de usuario"
                       class="form-input" />
                <span class="contador">@(modelo.Usuario?.Length ?? 0) / 50</span>
            </div>

            <div class="form-group">
                <label for="password" class="usu-contra-titulo">Contraseña</label>
                <input id="password" type="password"
                       maxlength="50"
                       value="@modelo.Password"
                       @oninput='e => modelo.Password = e.Value?.ToString()?.Length > 50 ? e.Value.ToString()[..50] : e.Value?.ToString() ?? ""'
                       placeholder="Crea una contraseña"
                       class="form-input" />
                <span class="contador">@(modelo.Password?.Length ?? 0) / 50</span>
            </div>

            <div class="form-group">
                <label for="confirmPassword" class="usu-contra-titulo">Confirmar Contraseña</label>
                <input id="confirmPassword" type="password" placeholder="Repite tu contraseña" class="form-input" maxlength="50" 
                        value="@modelo.ConfirmPassword"
                       @oninput='e => modelo.ConfirmPassword = e.Value?.ToString()?.Length > 50 ? e.Value.ToString()[..50] : e.Value?.ToString() ?? ""' />
                <span class="contador">@(modelo.ConfirmPassword?.Length ?? 0) / 50</span>
            </div>

            <button type="submit" class="btn-primary" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner"></span>
                    <span>Registrando...</span>
                }
                else
                {
                    <span>Crear Cuenta</span>
                }
            </button>

            <p class="login-link">
                ¿Ya tienes cuenta? <a href="/Login">Inicia sesión</a>
            </p>
        </EditForm>
    </div>
</div>

@code {
    private RegisterModel modelo = new();
    private string mensaje = "";
    private bool registroExitoso = false;
    private bool isLoading = false;

    private async Task RegisterUsuario()
    {
        isLoading = true;
        mensaje = "";

        if (modelo.Password != modelo.ConfirmPassword)
        {
            mensaje = "Las contraseñas no coinciden";
            registroExitoso = false;
            isLoading = false;
            return;
        }

        var resultado = await RegisterWindow.RegistrarUsuarioAsync(modelo.Usuario, modelo.Password);

        if (resultado)
        {
            mensaje = "¡Registro exitoso! Ya puedes iniciar sesión";
            registroExitoso = true;
            await Task.Delay(1500);
            Navigation.NavigateTo("/Login");
        }
        else
        {
            mensaje = "Error al registrar el usuario";
            registroExitoso = false;
        }

        isLoading = false;

    }

    public class RegisterModel
    {
        [Required(ErrorMessage = "El usuario es obligatorio")]
        public string Usuario { get; set; } = "";
        [Required(ErrorMessage = "La contraseña es obligatoria")]
        public string Password { get; set; } = "";
        [Required(ErrorMessage = "La confirmacion es obligatoria")]
        public string ConfirmPassword { get; set; } = "";
    }
}