@page "/Login"
@using Votify.Core.Interfaces
@inject ILoginWindow LoginWindow

<h3>Iniciar Sesión</h3>

<EditForm Model="@modelo" OnValidSubmit="LoginUsuario">
    <div>
        <label>Usuario</label>
        <InputText @bind-Value="modelo.Usuario" /> 
    </div>

    <div>
        <label>Contraseña</label>
        <InputText type="password" @bind-Value="modelo.Password" /> 
    </div>

    <button type="submit">Entrar</button>
</EditForm>

@if (!string.IsNullOrEmpty(mensaje))
{
    <p style="color: @(loginExitoso ? "green" : "red")">@mensaje</p>
}

