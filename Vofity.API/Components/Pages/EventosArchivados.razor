@page "/EventosArchivados"
@using Microsoft.EntityFrameworkCore
@using System.Net.Http.Json
@using Votify.Core.Entities
@using Votify.Infrastructure.Data
@inject NavigationManager nav
@inject AppDbContext contexto
@inject HttpClient Http
@rendermode InteractiveServer
<PageTitle>Eventos archivados - Votify </PageTitle>
<div class="eventos-page">

    <div class="titulo-y-archivados">
        <div>
            <h2 class="titulo">Eventos Archivados</h2>
        </div>
    </div>
    <div class="tabla-card">
        <div class="tabla-wrapper">
            <table class="tabla-eventos">
                <thead>
                    <tr>
                        <th>Evento</th>
                        <th>Categoría</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Desarchivar</th>
                        <th>Eliminar</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cargando)
                    {
                        <tr>
                            <td colspan="6">
                                <div class="loading-box">
                                    <div class="spinner"></div>
                                    <p>Cargando eventos archivados...</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var evento in eventos.Where(e => e.Archivado == true))
                        {
                            <tr>
                                <td>@evento.Nombre</td>
                                <td>@evento.Categoria.Nombre</td>
                                <td>@evento.FechaInicio</td>
                                <td>@evento.FechaFin</td>
                                <td>
                                    <button class="boton-secundario" @onclick='() => Desarchivar(evento.Id)'>
                                        Desarchivar
                                    </button>
                                </td>
                                <td>
                                    <button class="boton-secundario boton-peligro" @onclick='() => Eliminar(evento.Id)'>
                                        Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (!string.IsNullOrEmpty(noHayArchivados))
        {
            <div class="mensaje-estado">
                @noHayArchivados
            </div>
        }
    </div>

    <div class="acciones-inferiores">
        <button type="button" class="boton-principal" @onclick="Volver">Volver</button>
    </div>

</div>

@code {
    List<Votify.Core.Entities.Evento> eventos = new();
    private string noHayArchivados = "";
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;

        eventos = await contexto.Evento
            .AsNoTracking()
            .Include(e => e.Categoria)
            .ToListAsync();

        HayEventos();

        cargando = false;
    }

    private async Task Desarchivar(Guid eventoId)
    {
        try
        {
            var response = await Http.PatchAsync(
                $"api/eventos/{eventoId}/archivo?archivar=false",
                new StringContent("")
            );

            if (response.IsSuccessStatusCode)
            {
                eventos = await contexto.Evento.AsNoTracking().Include(e => e.Categoria).ToListAsync();
                HayEventos();
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                noHayArchivados = $"No se pudo desarchivar el evento: {error}";
            }
        }
        catch (Exception ex)
        {
            noHayArchivados = $"Error al desarchivar: {ex.Message}";
        }
    }

    private void Volver()
    {
        nav.NavigateTo("/Evento");
    }

    private void HayEventos()
    {
        if (eventos.Where(e => e.Archivado == true).Count() == 0)
            noHayArchivados = "No hay eventos archivados";
        else
            noHayArchivados = "";
    }

    private async Task Eliminar(Guid eventoId)
    {
        var response = await Http.DeleteAsync($"api/eventos/{eventoId}");

        if (response.IsSuccessStatusCode)
        {
            eventos = await contexto.Evento.AsNoTracking().Include(e => e.Categoria).ToListAsync();
            HayEventos();
            StateHasChanged();
        }
        else
        {
            noHayArchivados = "No se pudo eliminar el evento";
        }
    }
}