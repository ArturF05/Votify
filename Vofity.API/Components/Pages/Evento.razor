@page "/Evento"
@inject NavigationManager nav;

<h2 class="titulo">Eventos</h2>

<PageTitle>Evento</PageTitle>
<div class="barra-busqueda">
    <input type="text" placeholder="Buscar eventos..." />
    <select>
        <option>Hackaton</option>
        <option>Futbolín</option>
    </select>
    <button @onclick='() => BuscarEventos()'>Buscar</button>
</div>

<!-- ESTO CAMBIA. QUE SEA VARIABLE PARA LOS EVENTOS QUE HAYA -->
<div>
    <table class="tabla-eventos">
        <thead>
            <tr>
                <th>Evento</th>
                <th>Categoría</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Editar</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Pequeños Informáticos</td>
                <td>Hackaton</td>
                <td>13/12/2006</td>
                <td>14/12/2006</td>
                <td><button class="boton-editar" @onclick='() => EditarEvento()'>Editar</button></td>
            </tr>
            <tr>
                <td>Torneo de futbolín</td>
                <td>Futbolín</td>
                <td>13/02/2006</td>
                <td>14/02/2006</td>
                <td><button class="boton-editar" @onclick='() => EditarEvento()'>Editar</button></td>
            </tr>
        </tbody>
    </table>
</div>
<button @onclick="NuevoEvento">Crear Evento</button>

@code {
    void BuscarEventos()
    {
        //Completar
    }

    void EditarEvento()
    {
        //Completar
    }

    void NuevoEvento()
    {
        nav.NavigateTo("/CrearEvento");
    }
}