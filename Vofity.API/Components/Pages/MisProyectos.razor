@page "/MisProyectos"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.EntityFrameworkCore
@using Votify.Infrastructure.Data
@inject AppDbContext contexto
@inject NavigationManager nav
@inject ProtectedSessionStorage sessionStorage

<div class="materiales-page">
    <h1 class="page-titulo">Materiales del Proyecto</h1>

    @if (cargando)
    {
        <div class="estado-carga">
            <p>Cargando proyectos...</p>
        </div>
    }
    else if (!proyectos.Any())
    {
        <div class="estado-vacio">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" />
            </svg>
            <p>No tienes proyectos registrados.</p>
        </div>
    }
    else
    {
        <div class="proyectos-tabs-wrapper">
            @foreach (var proyecto in proyectos)
            {
                int count = materialesPorProyecto.TryGetValue(proyecto.Id, out var lst) ? lst.Count : 0;
                bool esActivo = proyectoSeleccionado?.Id == proyecto.Id;
                <button class="tab-btn @(esActivo ? "tab-activo" : "")"
                        @onclick="() => SeleccionarProyecto(proyecto)">
                    @proyecto.Titulo
                    <span class="tab-badge @(esActivo ? "tab-badge-activo" : "")">@count</span>
                </button>
            }
        </div>

        @if (proyectoSeleccionado != null)
        {
            <div class="proyecto-panel">
                <div class="proyecto-header">
                    <div class="proyecto-info">
                        <h2 class="proyecto-nombre">@proyectoSeleccionado.Titulo</h2>
                        <p class="proyecto-evento">Evento: @proyectoSeleccionado.Evento?.Nombre</p>
                    </div>
                    <button class="btn-anadir" @onclick="() => mostrarFormulario = !mostrarFormulario">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                        Añadir Material
                    </button>
                </div>

                @if (mostrarFormulario)
                {
                    <div class="form-anadir">
                        <div class="form-row">
                            <div class="form-campo">
                                <label class="form-label">Nombre del material</label>
                                <input type="text" class="form-input" @bind="nuevoNombre"
                                       placeholder="Ej: Logo principal" />
                            </div>
                            <div class="form-campo">
                                <label class="form-label">Tipo</label>
                                <select class="form-input" @bind="nuevoTipo">
                                    <option value="Imagen">Imagen</option>
                                    <option value="Enlace">Enlace</option>
                                    <option value="Video">Video</option>
                                </select>
                            </div>
                        </div>
                        @if (nuevoTipo == "Imagen")
                        {
                            <div class="form-campo">
                                <label class="form-label">Archivo de imagen</label>
                                <InputFile OnChange="OnArchivoSeleccionado" accept="image/*" class="form-input-file" />
                                @if (previewUrl != null)
                                {
                                    <img src="@previewUrl" class="imagen-preview" alt="Vista previa" />
                                }
                            </div>
                        }
                        else
                        {
                            <div class="form-campo">
                                <label class="form-label">URL</label>
                                <input type="text" class="form-input" @bind="nuevoValor"
                                       placeholder="https://" />
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <p class="form-error">@mensajeError</p>
                        }
                        <div class="form-acciones">
                            <button class="btn-form-cancelar" @onclick="CancelarFormulario">Cancelar</button>
                            <button class="btn-form-agregar" @onclick="AgregarMaterial">Agregar</button>
                        </div>
                    </div>
                }

                <div class="materiales-lista">
                    @if (!MaterialesActuales.Any())
                    {
                        <div class="materiales-vacios">
                            <p>Sin materiales aún. Haz clic en "Añadir Material" para comenzar.</p>
                        </div>
                    }
                    @foreach (var material in MaterialesActuales)
                    {
                        <div class="material-item">
                            <div class="material-icono icono-@material.Tipo.ToLower()">
                                @((MarkupString)GetIconoSvg(material.Tipo))
                            </div>
                            <div class="material-info">
                                <span class="material-nombre">@material.Nombre</span>
                                <div class="material-meta">
                                    <span class="material-tipo tipo-@material.Tipo.ToLower()">@material.Tipo</span>
                                    @if (material.Tipo != "Imagen")
                                    {
                                        <a href="@material.Valor" target="_blank" class="material-url">
                                            @material.Valor
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                                            </svg>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="material-archivo">@material.Valor</span>
                                        @if (material.PreviewUrl != null)
                                        {
                                            <img src="@material.PreviewUrl" class="material-thumbnail" alt="@material.Nombre" />
                                        }
                                    }
                                    <span class="material-fecha">Subido: @material.FechaSubida.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                            <button class="btn-eliminar" @onclick="() => EliminarMaterial(material.Id)" title="Eliminar">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    }

    <div class="footer-acciones">
        <button class="btn-cancelar" @onclick='() => nav.NavigateTo("/Home")'>Cancelar</button>
        <button class="btn-guardar" @onclick="GuardarCambios" disabled="@guardando">
            @if (guardando)
            {
                <span>Guardando...</span>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span>Guardar Cambios</span>
            }
        </button>
    </div>
</div>

@code {
    public class MaterialViewModel
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string Nombre { get; set; } = "";
        public string Tipo { get; set; } = "Imagen";
        public string Valor { get; set; } = "";
        public string? PreviewUrl { get; set; }
        public DateTime FechaSubida { get; set; } = DateTime.Now;
    }

    private bool cargando = true;
    private bool guardando = false;
    private bool mostrarFormulario = false;
    private string mensajeError = "";
    private Guid idUsuario;

    private List<Votify.Core.Entities.Proyecto> proyectos = new();
    private Votify.Core.Entities.Proyecto? proyectoSeleccionado;
    private Dictionary<Guid, List<MaterialViewModel>> materialesPorProyecto = new();

    private string nuevoNombre = "";
    private string nuevoTipo = "Imagen";
    private string nuevoValor = "";
    private IBrowserFile? archivoSeleccionado;
    private string? previewUrl;

    private List<MaterialViewModel> MaterialesActuales =>
        proyectoSeleccionado != null && materialesPorProyecto.TryGetValue(proyectoSeleccionado.Id, out var list)
            ? list
            : new();

    protected override async Task OnInitializedAsync()
    {
        await CargarProyectosAsync();
    }

    private async Task CargarProyectosAsync()
    {
        try
        {
            var resultado = await sessionStorage.GetAsync<Guid>("IdUsuario");
            if (!resultado.Success || resultado.Value == Guid.Empty)
            {
                nav.NavigateTo("/Login");
                return;
            }
            idUsuario = resultado.Value;

            proyectos = await contexto.Proyecto
                .AsNoTracking()
                .Include(p => p.Evento)
                .Where(p => contexto.EventoUsuarioRol
                    .Any(eur => eur.EventoId == p.Id_evento && eur.UsuarioId == idUsuario))
                .ToListAsync();

            foreach (var p in proyectos)
                materialesPorProyecto[p.Id] = new();

            if (proyectos.Any())
                proyectoSeleccionado = proyectos.First();
        }
        catch
        {
            nav.NavigateTo("/Login");
        }
        finally
        {
            cargando = false;
        }
    }

    private void SeleccionarProyecto(Votify.Core.Entities.Proyecto proyecto)
    {
        proyectoSeleccionado = proyecto;
        mostrarFormulario = false;
        mensajeError = "";
    }

    private async Task OnArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        archivoSeleccionado = e.File;
        nuevoValor = e.File.Name;
        mensajeError = "";

        try
        {
            const long maxBytes = 5 * 1024 * 1024;
            using var stream = e.File.OpenReadStream(maxAllowedSize: maxBytes);
            var buffer = new byte[e.File.Size];
            await stream.ReadAsync(buffer);
            previewUrl = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(buffer)}";
        }
        catch
        {
            mensajeError = "El archivo es demasiado grande (máx. 5 MB).";
            archivoSeleccionado = null;
            nuevoValor = "";
            previewUrl = null;
        }
    }

    private void AgregarMaterial()
    {
        mensajeError = "";
        if (string.IsNullOrWhiteSpace(nuevoNombre))
        {
            mensajeError = "El nombre es obligatorio.";
            return;
        }
        if (nuevoTipo == "Imagen" && archivoSeleccionado == null)
        {
            mensajeError = "Selecciona un archivo de imagen.";
            return;
        }
        if (nuevoTipo != "Imagen" && string.IsNullOrWhiteSpace(nuevoValor))
        {
            mensajeError = "La URL es obligatoria.";
            return;
        }

        if (proyectoSeleccionado != null)
        {
            if (!materialesPorProyecto.ContainsKey(proyectoSeleccionado.Id))
                materialesPorProyecto[proyectoSeleccionado.Id] = new();

            materialesPorProyecto[proyectoSeleccionado.Id].Add(new MaterialViewModel
            {
                Nombre = nuevoNombre,
                Tipo = nuevoTipo,
                Valor = nuevoValor,
                PreviewUrl = nuevoTipo == "Imagen" ? previewUrl : null
            });
        }

        CancelarFormulario();
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        nuevoNombre = "";
        nuevoTipo = "Imagen";
        nuevoValor = "";
        mensajeError = "";
        archivoSeleccionado = null;
        previewUrl = null;
    }

    private void EliminarMaterial(Guid id)
    {
        if (proyectoSeleccionado != null && materialesPorProyecto.TryGetValue(proyectoSeleccionado.Id, out var list))
            list.RemoveAll(m => m.Id == id);
    }

    private async Task GuardarCambios()
    {
        guardando = true;
        // TODO: implementar llamada al API cuando el backend esté listo
        await Task.Delay(500);
        guardando = false;
    }

    private static string GetIconoSvg(string tipo) => tipo switch
    {
        "Imagen" => "<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2'><path stroke-linecap='round' stroke-linejoin='round' d='M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z' /></svg>",
        "Video"  => "<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2'><path stroke-linecap='round' stroke-linejoin='round' d='M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z' /></svg>",
        _        => "<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2'><path stroke-linecap='round' stroke-linejoin='round' d='M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244' /></svg>"
    };
}
