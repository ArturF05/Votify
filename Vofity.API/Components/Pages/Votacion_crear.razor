        sb.AppendLine($"Ver resultados en vivo: {(p.VerRes == 1 ? "Sí" : "No")}");
        sb.AppendLine($"Comentarios: {(p.PermiteComentarios == 1 ? "Sí" : "No")} | Obligatorios: {(p.ComentariosObligatorios == 1 ? "Sí" : "No")}");
        sb.AppendLine($"Proyectos votables: {p.NumProy}");
        return sb.ToString();
    }

