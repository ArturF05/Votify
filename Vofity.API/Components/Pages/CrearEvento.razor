@page "/CrearEvento"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Votify.Core.Entities
@using Votify.Core.Services
@using Votify.Infrastructure.Data
@using Votify.Infrastructure.Repositorios
@using Votify.API.DTOs
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject NavigationManager nav
@inject AppDbContext contexto
@inject HttpClient Http
@inject ProtectedSessionStorage sessionStorage
@inject IJSRuntime JS

<PageTitle>Crear Evento - Votify </PageTitle>
<div class="crear-evento-page">
    <div class="page-header">
        <h2 class="page-title">Crear Evento</h2>
    </div>

    <div class="form-evento">
        <div class="evento-header">
            <h3>Nuevo evento</h3>
        </div>

        <hr class="linea">

        <div class="campo campo-columna">
            <label>Nombre*:</label>
            <input type="text" class="input-ancho" @bind="nombre" placeholder="Nombre del evento..." />
        </div>
        <div class="campo campo-columna">
            <label>Imagen del evento:</label>
            <InputFile OnChange="OnImagenSeleccionada" accept=".jpg,.jpeg,.png" />

            @if (imagenBytes != null)
            {
                <p>Imagen lista: @imagenNombre</p>
            }
        </div>
        <div class="form-grid">
            <div class="campo campo-columna">
                <label>Categoría*:</label>
                <select @bind="Id_categoria">
                    @foreach (var cat in categorias)
                    {
                        <option value="@cat.Id">@cat.Nombre</option>
                    }
                </select>
            </div>

            <div class="campo campo-columna">
                <label>Tipo de evento*:</label>
                <select @bind="tipo">
                    <option value="Hackathon">Hackathon</option>
                    <option value="Concurso">Concurso</option>
                </select>
            </div>

            <div class="campo campo-columna">
                <label>Fecha de inicio*:</label>
                <input type="datetime-local" @bind="inicio" />
            </div>

            <div class="campo campo-columna">
                <label>Fecha de cierre*:</label>
                <input type="datetime-local" @bind="fin" />
            </div>
            <div class="campo">
                <label>Descripción:</label>
                <textarea @bind="descripcion" placeholder="Descripción..."></textarea>
            </div>
            @for(int index = 0; index<votaciones.Count; index++)
            {
                int i = index;
                <div class="campo campo-columna campo-completo">
                    <h4>Votación @(i+1)</h4>
                    <label>Tipo de votación*:</label>
                    <div class="grupo-botones-votacion">
                        <button type="button"
                                class="boton-votacion @(votaciones[i].Tipo == TipoVotacion.Publico ? "activo" : "")"
                                @onclick='() => SeleccionarTipo(TipoVotacion.Publico, i)'>
                            Público
                        </button>

                        <button type="button"
                                class="boton-votacion @(votaciones[i].Tipo == TipoVotacion.Jurado ? "activo" : "")"
                                @onclick='() => SeleccionarTipo(TipoVotacion.Jurado, i)'>
                            Jurado
                        </button>

                        <button type="button"
                                class="boton-votacion @(votaciones[i].Tipo == TipoVotacion.Mixto ? "activo" : "")"
                                @onclick='() => SeleccionarTipo(TipoVotacion.Mixto, i)'>
                            Mixto
                        </button>
                    </div>
                </div>
                <div class="campo campo-columna">
                    <label>Permitir Autovoto*:</label>
                    <select @bind="votaciones[i].PermiteAutoVoto">
                        <option value="1">Sí</option>
                        <option value="0">No</option>
                    </select>
                </div>
                <div class="campo campo-columna">
                    <label>Permitir ver resultados en vivo*:</label>
                    <select @bind="votaciones[i].VerRes">
                        <option value="1">Sí</option>
                        <option value="0">No</option>
                    </select>
                </div>
                <div class="campo campo-columna">
                    <label>Inicio automático*:</label>
                    <input type="datetime-local" @bind-value="votaciones[i].Inicio" @bind-value:event="onchange" />
                </div>
                <div class="campo campo-columna">
                    <label>Fin automático*:</label>
                    <input type="datetime-local" @bind-value="votaciones[i].Fin" @bind-value:event="onchange" />
                </div>
                <div class="campo campo-columna">
                    <label>Número de proyectos votables*:</label>
                    <input type="number" @bind-value="votaciones[i].NumProy" min="1" />
                </div>
                <div class="campo campo-columna">
                    <label>Permitir comentarios*</label>
                    <select @onchange="(e)=> cambioPermiteComentarios(e,i)">
                        <option value="1">Sí</option>
                        <option value="0">No</option>
                    </select>
                </div>
                <div class="campo campo-columna">
                    <label>Comentarios obligatorios*</label>
                    <select @bind="votaciones[i].ComentariosObligatorios" disabled="@(votaciones[i].PermiteComentarios ==0)" 
                        title="@(votaciones[i].PermiteComentarios == 0 ? "No se puede modificar porque no se permiten comentarios": null)">>
                        <option value="0">No</option>
                        <option value="1">Sí</option>
                    </select>
                </div>
                <div class="grupo-botones-votacion">
                    <button type="button" class="boton-votacion" @onclick='() => quitarVotacion(i)' disabled="@(votaciones.Count<=1)">Quitar votación</button>
                </div>

                <div class="separador-criterios"></div>

                <section class="bloque-criterios">
                    <h3 class="titulo-criterios">Criterios</h3>

                    <div class="lista-criterios">
                        @foreach (var c in votaciones[i].Criterios)
                        {
                            <div class="criterio-item">
                                <div class="criterio-texto">
                                    <span class="criterio-nombre">@c.Nombre</span>
                                    <span class="criterio-descripcion">@c.Descripcion</span>
                                </div>

                                <div class="criterio-acciones">
                                    <span class="criterio-descripcion">Peso (%):</span>
                                    <input type="text" class="criterio-peso" @bind="c.Peso" />
                                    <button type="button" class="boton-secundario" @onclick='() => QuitarCriterio(i, c.Id)'>Quitar</button>
                                </div>
                            </div>
                        }
                    </div>

                    <div><label style="color:black">@mensajeNoCriterio</label></div>

                    <div class="criterio-formulario">
                        <input type="text" placeholder="Nombre" @bind="nombreCriterio" class="input-criterio" />
                        <input type="text" placeholder="Descripción" @bind="descripcionCriterio" class="input-criterio" />
                        <button type="button" class="boton-principal" @onclick="() => GuardarCriterio(i)">Añadir</button>
                    </div>

                    <div>
                        <div><label style="color:red">@mensajeErrorCriterio</label></div>
                    </div>

                </section>
            }
            <div class="grupo-botones-votacion boton-add-votacion-wrapper">
                <button type="button" class="boton-votacion" @onclick="otraVotacion" disabled="@(votaciones.Count >= 3)">Añadir votación</button>
            </div>

            

    </div>

        <div>
            <div><label style="color:red">@mensaje</label></div>
            <div><label style="color:red">@mensaje2</label></div>
        </div>

        <div class="botones">
            <div class="grupo-botones">
                <button type="button" class="boton-secundario" @onclick="Cancelar">Cancelar</button>
            </div>

            <div class="grupo-botones">
                <button type="button" class="boton-principal" @onclick="GuardarEvento">Crear Evento</button>
            </div>
        </div>
    </div>
</div>

           

@code {
    DateTime inicio = DateTime.Now;
    DateTime fin = DateTime.Now.AddDays(1);
    List<VotacionForm> votaciones = new();
    private string nombre = "";
    private Guid Id_categoria = new Guid("0d4e9ac5-56ee-4a5c-817e-ee78bf8a8ed9");
    private string descripcion = "";
    private string mensaje = "";
    private string mensaje2 = "";
    private string mensajeErrorCriterio = "";
    private string mensajeNoCriterio = "";
    private string nombreCriterio = "";
    private string descripcionCriterio = "";
    private int pesoCriterio = 0;
    private string tipo = "Hackathon";
    List<Categoria> categorias = new();
    List<Votify.Core.Entities.Evento> eventos = new();
    List<Votify.Core.Entities.DimensionesDeValor> criterios = new();
    private Guid idUsuario;
    private Votify.Core.Entities.Usuario? usuarioActual;
    private byte[]? imagenBytes;
    private string? imagenNombre;

    protected override async Task OnInitializedAsync()
    {
        categorias = await contexto.Categoria.ToListAsync();
        ProtectedBrowserStorageResult<Guid> resultado;
        try
        {
            resultado = await sessionStorage.GetAsync<Guid>("IdUsuario");
            if (!resultado.Success || resultado.Value == Guid.Empty)
            {
                nav.NavigateTo("/Login");
                return;
            }
        }
        catch (Exception e)
        {
            nav.NavigateTo("/Login");
            return;
        }

        if (!resultado.Success || resultado.Value == Guid.Empty)
        {
            nav.NavigateTo("/Login");
            return;
        }
        idUsuario = resultado.Value;

        usuarioActual = await contexto.Usuario
            .Include(u => u.Rol)
            .FirstOrDefaultAsync(u => u.Id == idUsuario);
        otraVotacion();
    }

    private async Task Cancelar() => await JS.InvokeVoidAsync("history.back");

    void SeleccionarTipo(TipoVotacion tipo, int numeroVotacion)
    {
        votaciones[numeroVotacion].Tipo = tipo;
    }
    private void otraVotacion()
    {
        votaciones.Add(new VotacionForm
        {
            Tipo = TipoVotacion.Publico,
            Inicio = DateTime.Now,
            Fin = DateTime.Now.AddDays(1),
            PermiteAutoVoto = 1,
            NumProy = 1,
            PermiteComentarios = 1,
            ComentariosObligatorios = 0,
            VerRes=1,
        });
    }
    private void quitarVotacion(int numeroVotacion)
    {
        votaciones.RemoveAt(numeroVotacion);
    }
    private void cambioPermiteComentarios(ChangeEventArgs e, int i)
    {
        int nuevoValor = int.Parse(e.Value.ToString());
        votaciones[i].PermiteComentarios = nuevoValor;
        if (nuevoValor == 0) votaciones[i].ComentariosObligatorios = 0;
    }
    private async Task OnImagenSeleccionada(InputFileChangeEventArgs e)
    {
        var file = e.File;
        const long max = 5 * 1024 * 1024;

        if (file.Size > max)
        {
            mensaje = "Imagen demasiado grande";
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLower();
        var permitidas = new[] { ".jpg", ".jpeg", ".png" };

        if (!permitidas.Contains(ext))
        {
            mensaje = "Formato no permitido";
            return;
        }

        imagenNombre = file.Name;

        using var stream = file.OpenReadStream(max);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        imagenBytes = ms.ToArray();
    }
    private async Task GuardarEvento()
    {
        try
        {
            mensaje = "";
            mensaje2 = "";

            eventos = await contexto.Evento
                .Include(e => e.Categoria)
                .Where(e => e.Archivado == false)
                .ToListAsync();

            bool nombreUsado = false;
            bool nombreVacio = string.IsNullOrWhiteSpace(nombre);

            if (nombreVacio)
            {
                mensaje = "El nombre del evento es obligatorio";
                return;
            }

            foreach (var eve in eventos)
            {
                if (eve.Nombre.ToLower().Equals(nombre.ToLower()))
                {
                    nombreUsado = true;
                    break;
                }
            }

            if (nombreUsado)
            {
                mensaje = "El nombre del evento ya está en uso";
                return;
            }

            if (fin.CompareTo(inicio) <= 0)
            {
                mensaje2 = "La fecha del fin del evento debe ser posterior a la fecha de inicio";
                return;
            }
            bool franjaUsada = false;
            bool tipoUsado = false;
            for (int i = 0; i < votaciones.Count; i++)
            {
                for (int j = 0; j<votaciones.Count; j++)
                {
                    if (j != i)
                    {
                        franjaUsada = (votaciones[i].Inicio < votaciones[j].Fin && votaciones[i].Fin > votaciones[j].Inicio) || franjaUsada;
                        tipoUsado = (votaciones[i].Tipo == votaciones[j].Tipo) || tipoUsado;
                    }
                }
                if (votaciones[i].Inicio.CompareTo(inicio) < 0 || votaciones[i].Fin.CompareTo(fin) > 0)
                {
                    mensaje = "La votación " +(i+1)+ " debe de realizarse durante el evento";
                    return;
                }
                if (votaciones[i].Fin.CompareTo(votaciones[i].Inicio) <= 0)
                {
                    mensaje2 = "El final de la votación "+ (i+1) + " debe ser posterior a su inicio";
                    return;
                }
                if (franjaUsada)
                {
                    mensaje = "No se permiten votaciones concurrentes en un mismo evento";
                    return;
                }
                if (tipoUsado)
                {
                    mensaje = "Sólo se permite una votación por tipo en cada evento";
                    return;
                }
                if (votaciones[i].NumProy <= 0)
                {
                    mensaje = $"La votación {i + 1} debe permitir votar al menos 1 proyecto";
                    return;
                }
                if (votaciones[i].PermiteComentarios == 0) votaciones[i].ComentariosObligatorios = 0;
                if (!votaciones[i].Criterios.Any())
                {
                    mensajeErrorCriterio = $"La votación {i + 1} debe tener al menos un criterio";
                    return;
                }

                if (votaciones[i].Criterios.Sum(c => c.Peso) != 100)
                {
                    mensajeErrorCriterio = $"La suma de los pesos de la votación {i + 1} debe ser 100";
                    return;
                }
            }
            
            List<CrearVotacionDTOs> crearVotacionDTOs = new();
            for (int i = 0; i < votaciones.Count; i++)
            {
                var dtoVotacion = new CrearVotacionDTOs
                {
                    FechaInicio = votaciones[i].Inicio.ToUniversalTime(),
                    FechaFin = votaciones[i].Fin.ToUniversalTime(),
                    PermiteAutoVoto = votaciones[i].PermiteAutoVoto == 1,
                    TipoVotacion = votaciones[i].Tipo,
                    Num_Proy = votaciones[i].NumProy,
                    EstadoVotacion = EstadoVotacion.Cerrada,
                    PermiteComentarios = votaciones[i].PermiteComentarios == 1,
                    ComentariosObligatorios = votaciones[i].ComentariosObligatorios == 1,
                    Criterios = votaciones[i].Criterios.Select(c => new Votify.Core.DTOs.CrearCriterioDTO
                    {
                        Id = c.Id,
                        Nombre = c.Nombre,
                        Descripcion = c.Descripcion,
                        Peso = c.Peso
                    }).ToList(),

                    VerRes = votaciones[i].VerRes==1

                };
                crearVotacionDTOs.Add(dtoVotacion);
            }
            var dto = new CrearEventoDTOs
            {
                Nombre = nombre,
                Id_categoria = Id_categoria,
                FechaInicio = inicio.ToUniversalTime(),
                Descripcion = descripcion,
                FechaFin = fin.ToUniversalTime(),
                Tipo = tipo,
                dTOsVotacion = crearVotacionDTOs,
                UsuarioCreadorId = usuarioActual.Id,
                ImagenBytes = imagenBytes,
                ImagenNombre = imagenNombre
            };

            var responseEvento = await Http.PostAsJsonAsync("api/eventos", dto);
            var responseVotaciones = responseEvento;

            if (responseEvento.IsSuccessStatusCode)
            {
                nav.NavigateTo("/Evento");

            }
            else
            {
                var error = await responseEvento.Content.ReadAsStringAsync();
                mensaje = $"No se pudo crear el evento: {error}";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
    }

    private void GuardarCriterio(int indexVotacion)
    {
        if (nombreCriterio == "")
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Debes asignar un nombre al criterio";
            return;
        }

        if (descripcionCriterio == "")
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Debes asignar una descripción al criterio";
            return;
        }

        if (votaciones[indexVotacion].Criterios.Any(c => c.Nombre == nombreCriterio))
        {
            mensajeErrorCriterio = "No se puede añadir el criterio: Ya existe un criterio con ese nombre en esta votación";
            return;
        }

        votaciones[indexVotacion].Criterios.Add(new DimensionesDeValor
            {
                Id = Guid.NewGuid(),
                Id_votacion = Guid.Empty,
                Nombre = nombreCriterio,
                Descripcion = descripcionCriterio,
                Peso = 0
            });

        nombreCriterio = "";
        descripcionCriterio = "";
        mensajeErrorCriterio = "";
        mensajeNoCriterio = "";
        pesoCriterio = 0;
    }

    private void QuitarCriterio(int indexVotacion, Guid idCriterio)
    {
        votaciones[indexVotacion].Criterios.RemoveAll(c => c.Id == idCriterio);
    }

    class VotacionForm
    {
        public TipoVotacion Tipo { get; set; }
        public DateTime Inicio { get; set; }
        public DateTime Fin { get; set; }
        public int PermiteAutoVoto { get; set; }
        public int VerRes { get; set; } = 1;
        public int PermiteComentarios { get; set; }
        public int ComentariosObligatorios { get; set; }
        public int NumProy { get; set; } = 1;
        public List<DimensionesDeValor> Criterios { get; set; } = new();
    }
}
